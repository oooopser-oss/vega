# ============================================
# MARY KAY INSTAGRAM BOT CONFIGURATION
# ============================================

# Instagram Account
INSTAGRAM_USERNAME=marykay_elos
INSTAGRAM_PASSWORD=ваш_пароль_здесь

# Automation Settings
# ВНИМАНИЕ: авто-лайки и авто-подписки на чужих людей по хештегам нарушают
# условия использования Instagram и могут привести к блокировке аккаунта.
# Выключено по умолчанию — включайте, только если осознанно принимаете риск.
AUTO_LIKE=False
AUTO_FOLLOW=False
AUTO_DM=False

# Daily Limits (снижают риск блокировки, если авто-вовлечение включено)
DAILY_LIKES_LIMIT=100
DAILY_FOLLOWS_LIMIT=50
DAILY_COMMENTS_LIMIT=30

# Mary Kay Target Hashtags
TARGET_HASHTAGS=#marykay,#beautybusiness,#косметика,#skincare,#makeup,#красота,#уходкожа,#beautytips,#magkay,#marykayrussia

# Target Accounts (Beauty influencers and brands)
TARGET_ACCOUNTS=marykay_official,beautytips,makeuptutorials,skincare_experts,beauty_influencers,cosmetics_lovers,makeup_artists_ru

# Posting Schedule (4 раза в день - оптимально для продаж)
POST_SCHEDULE=08:00,13:00,17:00,20:00

# Workflow Settings
MIN_RELEVANCE_SCORE=0.6
AUTO_SCHEDULE_POSTS=True

# Bot Behavior
USE_PROXY=False
RANDOM_DELAY_MIN=30
RANDOM_DELAY_MAX=120

# Logging
LOG_LEVEL=INFO
SAVE_STATS=True
