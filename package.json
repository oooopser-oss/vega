{
  "name": "website-screenshots-monitor",
  "version": "1.0.0",
  "description": "Automatic website monitoring with screenshots",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "monitor": "node src/monitor.js",
    "monitor:dev": "node --watch src/monitor.js",
    "scheduler": "node src/scheduler.js",
    "scheduler:hourly": "node src/scheduler.js --interval=3600000",
    "scheduler:daily": "node src/scheduler.js --interval=86400000",
    "api": "node src/api-server.js",
    "cli": "node src/cli.js",
    "view": "node src/view-screenshots.js"
  },
  "dependencies": {
    "playwright": "^1.40.0",
    "dotenv": "^16.3.1",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {}
}
