# Instagram Credentials
INSTAGRAM_USERNAME=your_username
INSTAGRAM_PASSWORD=your_password

# Proxy (optional)
PROXY=

# Browser Settings
HEADLESS_BROWSER=True

# Scheduler
SCHEDULER_TIMEZONE=UTC

# Database
DATABASE_URL=sqlite:///instagram_bot.db

# Engagement Settings
AUTO_LIKE=True
AUTO_FOLLOW=True
AUTO_COMMENT=False
AUTO_DM=False

# Daily Limits (prevent detection)
DAILY_LIKES_LIMIT=100
DAILY_FOLLOWS_LIMIT=50
DAILY_COMMENTS_LIMIT=30

# Target Hashtags (comma-separated)
TARGET_HASHTAGS=#photography,#instagram,#instagood

# Target Accounts to follow from (comma-separated)
TARGET_ACCOUNTS=username1,username2,username3

# Post Schedule (HH:MM format, comma-separated)
POST_SCHEDULE=08:00,14:00,20:00
