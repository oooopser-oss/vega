}
Config.DayLengthMinutes = 16 -- длина игровых суток в реальных минутах

return Config
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000002"><Properties><string name="Name">Rig</string><ProtectedString name="Source"><![CDATA[-- Простая «блочная» фигура человека (как классический персонаж Roblox) для
-- жителей-NPC: сотрудники в зданиях (сервер) и прохожие на улицах (клиент).
-- Части анкерные; ходьба — покачивание рук и ног через Rig.Pose.

local Rig = {}

local SKIN = {
	Color3.fromRGB(255, 220, 190), Color3.fromRGB(240, 200, 165), Color3.fromRGB(225, 180, 140),
	Color3.fromRGB(200, 150, 110), Color3.fromRGB(150, 105, 75),
}
local SHIRTS = {
	Color3.fromRGB(200, 60, 60), Color3.fromRGB(60, 110, 190), Color3.fromRGB(240, 240, 235),
	Color3.fromRGB(70, 150, 90), Color3.fromRGB(230, 180, 50), Color3.fromRGB(120, 80, 160),
	Color3.fromRGB(40, 40, 45), Color3.fromRGB(230, 120, 160), Color3.fromRGB(110, 120, 130),
}
local PANTS = {
	Color3.fromRGB(40, 50, 80), Color3.fromRGB(30, 30, 35), Color3.fromRGB(90, 70, 50),
	Color3.fromRGB(120, 120, 125), Color3.fromRGB(60, 80, 60),
}
local HAIR = {
	Color3.fromRGB(40, 30, 25), Color3.fromRGB(90, 60, 35), Color3.fromRGB(200, 170, 110),
	Color3.fromRGB(20, 20, 20), Color3.fromRGB(150, 70, 40), Color3.fromRGB(190, 190, 190),
}

-- Униформа сотрудников (ключ — Role в Rig.Build).
Rig.Uniforms = {
	cashier = { Shirt = Color3.fromRGB(230, 120, 30), Pants = Color3.fromRGB(40, 40, 45) },
	doctor = { Shirt = Color3.fromRGB(245, 245, 250), Pants = Color3.fromRGB(245, 245, 250) },
	police = { Shirt = Color3.fromRGB(40, 60, 120), Pants = Color3.fromRGB(30, 35, 60), Hat = Color3.fromRGB(30, 40, 90) },
	guard = { Shirt = Color3.fromRGB(30, 30, 35), Pants = Color3.fromRGB(30, 30, 35) },
	clerk = { Shirt = Color3.fromRGB(70, 90, 140), Pants = Color3.fromRGB(40, 40, 50) },
	cook = { Shirt = Color3.fromRGB(250, 250, 250), Pants = Color3.fromRGB(60, 60, 65), Hat = Color3.fromRGB(250, 250, 250) },
	worker = { Shirt = Color3.fromRGB(240, 140, 30), Pants = Color3.fromRGB(50, 60, 90), Hat = Color3.fromRGB(240, 200, 40) },
}

local function pick(list, rng)
	return list[rng:NextInteger(1, #list)]
end

local function newPart(model, name, size, color, material)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = true
	p.CanTouch = false
	p.CastShadow = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = model
	return p
end

-- opts: { Seed = number, Role = "doctor" | ..., Name = string }
function Rig.Build(opts)
	opts = opts or {}
	local rng = Random.new(opts.Seed or math.random(1, 1e6))
	local uniform = opts.Role and Rig.Uniforms[opts.Role]
	local skin = pick(SKIN, rng)
	local shirt = uniform and uniform.Shirt or pick(SHIRTS, rng)
	local pants = uniform and uniform.Pants or pick(PANTS, rng)
	local model = Instance.new("Model")
	model.Name = opts.Name or "Житель"

	local parts = {}
	parts.Torso = newPart(model, "Torso", Vector3.new(2, 2, 1), shirt)
	parts.Head = newPart(model, "Head", Vector3.new(2, 1, 1), skin)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Head
	mesh.Scale = Vector3.new(1.25, 1.25, 1.25)
	mesh.Parent = parts.Head
	local face = Instance.new("Decal")
	face.Texture = "rbxasset://textures/face.png"
	face.Face = Enum.NormalId.Front
	face.Parent = parts.Head
	parts.LArm = newPart(model, "Left Arm", Vector3.new(1, 2, 1), rng:NextNumber() < 0.5 and shirt or skin)
	parts.RArm = newPart(model, "Right Arm", Vector3.new(1, 2, 1), parts.LArm.Color)
	parts.LLeg = newPart(model, "Left Leg", Vector3.new(1, 2, 1), pants)
	parts.RLeg = newPart(model, "Right Leg", Vector3.new(1, 2, 1), pants)
	if uniform and uniform.Hat then
		parts.Hair = newPart(model, "Hat", Vector3.new(2.1, 0.6, 1.3), uniform.Hat)
	else
		parts.Hair = newPart(model, "Hair", Vector3.new(2.05, 0.45, 1.15), pick(HAIR, rng))
	end
	model.PrimaryPart = parts.Torso

	local rig = { Model = model, Parts = parts, Phase = rng:NextNumber() * 6.28 }
	rig.List = { parts.Torso, parts.Head, parts.Hair, parts.LArm, parts.RArm, parts.LLeg, parts.RLeg }
	return rig
end

-- Возвращает CFrame для частей (порядок как в rig.List).
-- root — CFrame на уровне земли, смотрит в направлении движения.
function Rig.Pose(rig, root, swing)
	local t = root * CFrame.new(0, 3, 0)
	local a = swing or 0
	local hipL = t * CFrame.new(-0.5, -1, 0) * CFrame.Angles(a, 0, 0) * CFrame.new(0, -1, 0)
	local hipR = t * CFrame.new(0.5, -1, 0) * CFrame.Angles(-a, 0, 0) * CFrame.new(0, -1, 0)
	local armL = t * CFrame.new(-1.5, 0.5, 0) * CFrame.Angles(-a * 0.8, 0, 0) * CFrame.new(0, -0.5, 0)
	local armR = t * CFrame.new(1.5, 0.5, 0) * CFrame.Angles(a * 0.8, 0, 0) * CFrame.new(0, -0.5, 0)
	local head = t * CFrame.new(0, 1.5, 0)
	local hair = head * CFrame.new(0, 0.55, 0.05)
	return { t, head, hair, armL, armR, hipL, hipR }
end

-- Сразу ставит фигуру в позу (для статичных NPC).
function Rig.Place(rig, root, swing)
	local cfs = Rig.Pose(rig, root, swing)
	for i, p in rig.List do
		p.CFrame = cfs[i]
	end
end

return Rig
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000003"><Properties><string name="Name">Roads</string><ProtectedString name="Source"><![CDATA[-- Граф улиц (из TrafficGraph) + общая логика светофоров.
-- Сервер по нему ставит светофоры, «зебры», остановки и скамейки,
-- клиент — пускает машины и прохожих.

local TrafficGraph = require(script.Parent:WaitForChild("TrafficGraph"))

local Roads = {}

Roads.Nodes = {} -- [i] = Vector3 (y = 0)
Roads.Edges = {} -- [i] = { A, B, Width, Class }
Roads.Adj = {} -- [node] = { { To, Edge } }
Roads.Lights = {} -- [node] = true
Roads.LightList = {}
Roads.NodeWidth = {} -- [node] = ширина самой широкой улицы в узле

for rec in string.gmatch(TrafficGraph.Nodes, "[^;]+") do
	local f = string.split(rec, ",")
	table.insert(Roads.Nodes, Vector3.new(tonumber(f[1]), 0, tonumber(f[2])))
end
for rec in string.gmatch(TrafficGraph.Edges, "[^;]+") do
	local f = string.split(rec, ",")
	local a, b, w = tonumber(f[1]), tonumber(f[2]), tonumber(f[3])
	local edge = { A = a, B = b, Width = w, Class = TrafficGraph.RoadClasses[tonumber(f[4])] }
	table.insert(Roads.Edges, edge)
	local id = #Roads.Edges
	Roads.Adj[a] = Roads.Adj[a] or {}
	Roads.Adj[b] = Roads.Adj[b] or {}
	table.insert(Roads.Adj[a], { To = b, Edge = id })
	table.insert(Roads.Adj[b], { To = a, Edge = id })
	Roads.NodeWidth[a] = math.max(Roads.NodeWidth[a] or 0, w)
	Roads.NodeWidth[b] = math.max(Roads.NodeWidth[b] or 0, w)
end
for rec in string.gmatch(TrafficGraph.Lights, "[^;]+") do
	local n = tonumber(rec)
	Roads.Lights[n] = true
	table.insert(Roads.LightList, n)
end

-- Скорость машин по классу улицы (studs/сек).
Roads.Speed = { primary = 55, secondary = 50, tertiary = 42, unclassified = 34, residential = 30, living_street = 20 }

-- Группа направления: 0 — «север-юг», 1 — «запад-восток».
function Roads.Group(dir)
	local ang = math.deg(math.atan2(dir.Z, dir.X)) % 180
	return (ang >= 45 and ang < 135) and 0 or 1
end

-- Цикл светофора 24 с: группа 0 — зелёный 0–9, жёлтый 9–12; группа 1 — зелёный 12–21, жёлтый 21–24.
local CYCLE = 24
function Roads.LightState(node, group, now)
	local t = (now + node * 3.7) % CYCLE
	local start = group == 0 and 0 or CYCLE / 2
	local local_t = (t - start) % CYCLE
	if local_t < 9 then
		return "green"
	elseif local_t < 12 then
		return "yellow"
	end
	return "red"
end

-- Правый перпендикуляр к направлению движения (движение по правой полосе).
function Roads.Right(dir)
	return Vector3.new(-dir.Z, 0, dir.X)
end

return Roads
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000004"><Properties><string name="Name">TrafficCar</string><ProtectedString name="Source"><![CDATA[-- Модели машин городского потока (клиентские, без физики):
-- седаны, хэтчбеки, такси и автобусы. Двигаются через CFrame.

local TrafficCar = {}

local COLORS = {
	Color3.fromRGB(220, 220, 225), Color3.fromRGB(30, 30, 35), Color3.fromRGB(170, 30, 35),
	Color3.fromRGB(40, 70, 140), Color3.fromRGB(120, 125, 130), Color3.fromRGB(60, 100, 70),
	Color3.fromRGB(200, 170, 120), Color3.fromRGB(150, 150, 155), Color3.fromRGB(240, 240, 240),
}

local function add(car, name, size, offset, color, material, shape)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	if shape then
		p.Shape = shape
	end
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = car.Model
	table.insert(car.List, p)
	table.insert(car.Offsets, offset)
	return p
end

-- Передняя часть машины — направление −Z (LookVector).
function TrafficCar.Build(seed)
	local rng = Random.new(seed or math.random(1, 1e6))
	local roll = rng:NextNumber()
	local kind = roll < 0.08 and "bus" or roll < 0.2 and "taxi" or roll < 0.55 and "hatch" or "sedan"
	local car = { Model = Instance.new("Model"), List = {}, Offsets = {}, Kind = kind }
	car.Model.Name = "TrafficCar"
	local glass = Color3.fromRGB(35, 45, 60)
	local dark = Color3.fromRGB(25, 25, 28)

	if kind == "bus" then
		local color = rng:NextNumber() < 0.5 and Color3.fromRGB(230, 200, 40) or Color3.fromRGB(240, 240, 240)
		add(car, "Body", Vector3.new(7, 7.5, 26), CFrame.new(0, 4.6, 0), color)
		add(car, "Windows", Vector3.new(7.1, 2.6, 22), CFrame.new(0, 5.8, 1), glass, Enum.Material.Glass)
		add(car, "Windshield", Vector3.new(6.4, 3.5, 0.2), CFrame.new(0, 5.2, -13.05), glass, Enum.Material.Glass)
		add(car, "Stripe", Vector3.new(7.1, 0.6, 26.1), CFrame.new(0, 3.2, 0), Color3.fromRGB(30, 90, 170))
		add(car, "Route", Vector3.new(4, 1, 0.2), CFrame.new(0, 7.6, -13.1), Color3.fromRGB(255, 160, 40), Enum.Material.Neon)
		for _, z in { -8.5, 8.5 } do
			for _, x in { -3.3, 3.3 } do
				add(car, "Wheel", Vector3.new(1.2, 3, 3), CFrame.new(x, 1.5, z), dark, nil, Enum.PartType.Cylinder)
			end
		end
		for _, x in { -2.6, 2.6 } do
			add(car, "Headlight", Vector3.new(1.2, 0.6, 0.2), CFrame.new(x, 2.2, -13.05), Color3.fromRGB(255, 250, 220), Enum.Material.Neon)
			add(car, "Taillight", Vector3.new(1.2, 0.8, 0.2), CFrame.new(x, 2.4, 13.05), Color3.fromRGB(200, 20, 20), Enum.Material.Neon)
		end
		car.Length, car.Speed = 26, 0.8
		return car
	end

	local color = kind == "taxi" and Color3.fromRGB(245, 200, 30) or COLORS[rng:NextInteger(1, #COLORS)]
	local len = kind == "hatch" and 10.5 or 12
	add(car, "Body", Vector3.new(6, 1.8, len), CFrame.new(0, 1.9, 0), color)
	add(car, "Bumper", Vector3.new(6.1, 0.6, 0.4), CFrame.new(0, 1.3, -len / 2 - 0.1), dark)
	add(car, "Bumper", Vector3.new(6.1, 0.6, 0.4), CFrame.new(0, 1.3, len / 2 + 0.1), dark)
	local cabinLen = kind == "hatch" and 6 or 5.5
	local cabinZ = kind == "hatch" and 1.4 or 0.6
	add(car, "Cabin", Vector3.new(5.4, 1.7, cabinLen), CFrame.new(0, 3.65, cabinZ), glass, Enum.Material.Glass)
	add(car, "Roof", Vector3.new(5.5, 0.3, cabinLen - 0.6), CFrame.new(0, 4.6, cabinZ), color)
	for _, z in { -len / 2 + 2.2, len / 2 - 2.2 } do
		for _, x in { -2.9, 2.9 } do
			add(car, "Wheel", Vector3.new(0.9, 2.4, 2.4), CFrame.new(x, 1.2, z), dark, nil, Enum.PartType.Cylinder)
		end
	end
	for _, x in { -2.1, 2.1 } do
		add(car, "Headlight", Vector3.new(1.3, 0.5, 0.2), CFrame.new(x, 2.2, -len / 2 - 0.05), Color3.fromRGB(255, 250, 220), Enum.Material.Neon)
		add(car, "Taillight", Vector3.new(1.3, 0.5, 0.2), CFrame.new(x, 2.2, len / 2 + 0.05), Color3.fromRGB(200, 20, 20), Enum.Material.Neon)
	end
	if kind == "taxi" then
		add(car, "TaxiSign", Vector3.new(2, 0.8, 1), CFrame.new(0, 5.15, cabinZ), Color3.fromRGB(255, 230, 120), Enum.Material.Neon)
		add(car, "Checker", Vector3.new(6.05, 0.4, len * 0.6), CFrame.new(0, 2.4, 0), Color3.fromRGB(20, 20, 20))
	end
	car.Length, car.Speed = len, 1
	return car
end

function TrafficCar.CFrames(car, root)
	local out = table.create(#car.List)
	for i, off in car.Offsets do
		out[i] = root * off
	end
	return out
end

return TrafficCar
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000005"><Properties><string name="Name">TrafficGraph</string><ProtectedString name="Source"><![CDATA[-- Граф улиц Первоуральска для машин, прохожих и светофоров.
