	end
	part({ Parent = m, Name = "ArchTop", Size = Vector3.new(13, 1, 1), Position = at(0, 12.5, -27), Color = Color3.fromRGB(255, 180, 210), Material = Enum.Material.Fabric })
end

-- Игровая зона в реальном Парке культуры и отдыха.
local function buildPark(a)
	local cx, cz = a.X, a.Z
	part({ Name = "ParkPathA", Size = Vector3.new(10, 0.3, 160), Position = Vector3.new(cx, 0.2, cz), Color = Color3.fromRGB(200, 180, 140), Material = Enum.Material.Sand })
	part({ Name = "ParkPathB", Size = Vector3.new(160, 0.3, 10), Position = Vector3.new(cx, 0.2, cz), Color = Color3.fromRGB(200, 180, 140), Material = Enum.Material.Sand })
	local fountain = part({ Name = "Fountain", Shape = Enum.PartType.Cylinder, Size = Vector3.new(3, 22, 22), CFrame = CFrame.new(cx, 1.5, cz) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(200, 200, 210), Material = Enum.Material.Marble })
	part({ Name = "FountainWater", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.3, 20, 20), CFrame = CFrame.new(cx, 3, cz) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(80, 160, 230), Material = Enum.Material.Glass, Transparency = 0.3, CanCollide = false })
	floatLabel(fountain, "Фонтан желаний", 6)
	table.insert(World.FunSpots, { Part = fountain, Need = "Fun", Amount = 10, Text = "Бросить монетку (5$)", Cost = 5, Hold = 1, Cooldown = 10 })

	for _, p in { { -40, -20 }, { 40, -20 }, { -40, 20 }, { 40, 20 }, { -20, -50 }, { 20, 50 } } do
		local seat = bench(Vector3.new(cx + p[1], 0, cz + p[2]), p[2] > 0 and -1 or 1)
		floatLabel(seat, "Скамейка", 2.5)
		table.insert(World.FunSpots, { Part = seat, Need = "Fun", Amount = 6, Text = "Отдохнуть", Hold = 0.5, Cooldown = 8, Extra = { Energy = 3 } })
	end
	-- Качели.
	part({ Name = "SwingFrame", Size = Vector3.new(14, 1, 1), Position = Vector3.new(cx + 50, 10, cz - 50), Color = Color3.fromRGB(200, 60, 60), Material = Enum.Material.Metal })
	for _, dx in { -7, 7 } do
		part({ Name = "SwingLeg", Size = Vector3.new(1, 10, 1), Position = Vector3.new(cx + 50 + dx, 5, cz - 50), Color = Color3.fromRGB(200, 60, 60), Material = Enum.Material.Metal })
	end
	local swing = interactable(nil, "Swing", Vector3.new(cx + 50, 2.5, cz - 50), Vector3.new(4, 0.5, 2), Color3.fromRGB(240, 200, 60), "Качели", Enum.Material.Wood)
	table.insert(World.FunSpots, { Part = swing, Need = "Fun", Amount = 18, Text = "Покачаться", Hold = 2, Cooldown = 12 })
	-- Уличный душ.
	local shower = interactable(nil, "ParkShower", Vector3.new(cx - 60, 4, cz - 60), Vector3.new(6, 8, 6), Color3.fromRGB(160, 210, 240), "Общественный душ", Enum.Material.Glass)
	shower.Transparency = 0.4
	shower.CanCollide = false
	table.insert(World.Showers, { Part = shower, Rate = 6, Name = "Общественный душ" })

	for _ = 1, 22 do
		local x = cx + math.random(-75, 75)
		local z = cz + math.random(-75, 75)
		if math.abs(x - cx) > 15 and math.abs(z - cz) > 15 and (Vector2.new(x - cx, z - cz)).Magnitude > 20 then
			tree(Vector3.new(x, 0, z))
		end
	end
	addGPS("Парк культуры и отдыха", Vector3.new(cx, 3, cz - 75))
end

local function buildJail(a)
	local m, at = building({ Name = "Jail", GPSName = "Тюрьма", X = a.X, Z = a.Z, Yaw = a.Yaw, W = 80, D = 70, H = 18, Color = Color3.fromRGB(90, 90, 95), Material = Enum.Material.Concrete, Sign = "ТЮРЬМА", SignColor = Color3.fromRGB(40, 40, 40), Path = 40 })
	local cells = {}
	for i, lx in { -27, -9, 9, 27 } do
		-- Перегородки между камерами.
		part({ Parent = m, Name = "CellWall", Size = Vector3.new(1, 18, 22), Position = at(lx - 9, 9, -24), Color = Color3.fromRGB(90, 90, 95), Material = Enum.Material.Concrete })
		for bx = -7, 7, 2 do
			part({ Parent = m, Name = "Bar", Size = Vector3.new(0.4, 18, 0.4), Position = at(lx + bx, 9, -13), Color = Color3.fromRGB(50, 50, 55), Material = Enum.Material.Metal })
		end
		part({ Parent = m, Name = "BarTop", Size = Vector3.new(18, 1, 0.6), Position = at(lx, 17.5, -13), Color = Color3.fromRGB(50, 50, 55), Material = Enum.Material.Metal })
		local bunk = part({ Parent = m, Name = "Bunk", Size = Vector3.new(5, 1.5, 8), Position = at(lx + 4, 1.2, -29), Color = Color3.fromRGB(120, 110, 100), Material = Enum.Material.Fabric })
		table.insert(World.Beds, { Part = bunk, Rate = 2, Name = "Тюремная койка" })
		cells[i] = (at(lx, 4, -24))
	end
	part({ Parent = m, Name = "CellWall", Size = Vector3.new(1, 18, 22), Position = at(36, 9, -24), Color = Color3.fromRGB(90, 90, 95), Material = Enum.Material.Concrete })
	World.Jail = { Cells = cells, Exit = (at(0, 4, 48)), Center = at(0, 0, -24).Position, Radius = 30 }
	-- Забор с колючкой.
	for _, lx in { -46, 46 } do
		part({ Name = "Fence", Size = Vector3.new(1, 10, 90), Position = at(lx, 5, 0), Color = Color3.fromRGB(120, 120, 125), Material = Enum.Material.Metal, Transparency = 0.2 })
	end
end

local function buildPatrolPosts()
	World.JobPoints.Patrol = {}
	for _, p in Meta.PatrolPosts do
		local post = interactable(nil, "PatrolPost", Vector3.new(p.X, 3, p.Z), Vector3.new(3, 6, 3), Color3.fromRGB(40, 60, 160), nil, Enum.Material.Metal)
		table.insert(World.JobPoints.Patrol, post)
	end
end

local function buildNature()
	for _, r in records("Trees") do
		tree(Vector3.new(tonumber(r[1]), 0, tonumber(r[2])))
		maybeYield()
	end
	for _, r in records("Lamps") do
		streetLamp(Vector3.new(tonumber(r[1]), 0, tonumber(r[2])))
	end
	for _, r in records("CarSpawns") do
		table.insert(World.CarSpawns, CFrame.new(tonumber(r[1]), 3, tonumber(r[2])) * CFrame.Angles(0, math.rad(tonumber(r[3])), 0))
	end
	for _, l in Meta.Landmarks do
		addGPS(l.Name, Vector3.new(l.X, 3, l.Z))
	end
end

---------------------------------------------------------------------------
-- Улицы: светофоры, «зебры», стоп-линии, остановки, скамейки, урны
---------------------------------------------------------------------------
local Roads = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Roads"))

local function nearGameplay(pos, dist)
	for _, a in Meta.Anchors do
		if (Vector3.new(a.X, 0, a.Z) - pos).Magnitude < dist then
			return true
		end
	end
	for _, h in Meta.Houses do
		if (Vector3.new(h.X, 0, h.Z) - pos).Magnitude < dist * 0.7 then
			return true
		end
	end
	return false
end

local function nearLight(pos, dist)
	for _, n in Roads.LightList do
		if (Roads.Nodes[n] - pos).Magnitude < dist then
			return true
		end
	end
	return false
end

local WHITE = Color3.fromRGB(240, 240, 235)
local POLE = Color3.fromRGB(60, 62, 68)

local function trafficLight(folder, node, nodeW, e, dir)
	-- dir — направление от перекрёстка вдоль улицы; машины едут навстречу (−dir).
	local incoming = -dir
	local right = Roads.Right(incoming)
	local base = Roads.Nodes[node] + dir * (nodeW / 2 + 4) + right * (e.Width / 2 + 2.5)
	part({ Parent = folder, Name = "LightPole", Size = Vector3.new(0.7, 15, 0.7), Position = base + Vector3.new(0, 7.5, 0), Color = POLE, Material = Enum.Material.Metal })
	local reach = e.Width / 4 + 2.5
	part({ Parent = folder, Name = "LightArm", Size = Vector3.new(0.4, 0.4, reach), CFrame = CFrame.lookAt(base - right * (reach / 2) + Vector3.new(0, 14.6, 0), base - right * reach + Vector3.new(0, 14.6, 0)), Color = POLE, Material = Enum.Material.Metal })
	local headPos = base - right * reach + Vector3.new(0, 12.4, 0)
	local head = part({ Parent = folder, Name = "TrafficLightHead", Size = Vector3.new(1.6, 4.6, 1.2), CFrame = CFrame.lookAt(headPos, headPos + dir), Color = Color3.fromRGB(30, 30, 32), Material = Enum.Material.Metal })
	head:SetAttribute("Node", node)
	head:SetAttribute("Group", Roads.Group(incoming))
	for i, name in { "Red", "Yellow", "Green" } do
		local bulb = part({ Parent = head, Name = name, Shape = Enum.PartType.Ball, Size = Vector3.new(1.1, 1.1, 1.1), CFrame = head.CFrame * CFrame.new(0, 1.45 - (i - 1) * 1.45, -0.45), Color = Color3.fromRGB(40, 40, 40), CanCollide = false })
		bulb.CastShadow = false
	end
	head:AddTag("TrafficLight")
	-- Стоп-линия на встречной полосе.
	local stopPos = Roads.Nodes[node] + dir * (nodeW / 2 + 8) + right * (e.Width / 4) + Vector3.new(0, 0.33, 0)
	part({ Parent = folder, Name = "StopLine", Size = Vector3.new(e.Width / 2 - 1, 0.06, 0.8), CFrame = CFrame.lookAt(stopPos, stopPos + dir), Color = WHITE, CanCollide = false })
	-- «Зебра».
	local cross = Roads.Nodes[node] + dir * (nodeW / 2 + 4) + Vector3.new(0, 0.33, 0)
	local half = e.Width / 2 - 1.5
	local off = -half
	while off <= half do
		local p = cross + Roads.Right(dir) * off
		part({ Parent = folder, Name = "Crosswalk", Size = Vector3.new(1.2, 0.06, 5), CFrame = CFrame.lookAt(p, p + dir), Color = WHITE, CanCollide = false })
		off += 2.4
	end
end

local function busStop(folder, pos, dir, right)
	-- Остановка стоит на тротуаре, лицом к дороге.
	local cf = CFrame.lookAt(pos, pos - right)
	part({ Parent = folder, Name = "StopRoof", Size = Vector3.new(11, 0.4, 4.5), CFrame = cf * CFrame.new(0, 8.2, 0), Color = Color3.fromRGB(60, 120, 170), Material = Enum.Material.Metal })
	part({ Parent = folder, Name = "StopBack", Size = Vector3.new(11, 6, 0.3), CFrame = cf * CFrame.new(0, 4.8, 2), Color = Color3.fromRGB(170, 210, 235), Material = Enum.Material.Glass, Transparency = 0.4 })
	for _, x in { -5.3, 5.3 } do
		part({ Parent = folder, Name = "StopPost", Size = Vector3.new(0.4, 8, 0.4), CFrame = cf * CFrame.new(x, 4.1, 2), Color = POLE, Material = Enum.Material.Metal })
	end
	part({ Parent = folder, Name = "StopBench", Size = Vector3.new(8, 0.5, 1.6), CFrame = cf * CFrame.new(0, 2, 1.1), Color = Color3.fromRGB(150, 100, 60), Material = Enum.Material.Wood })
	part({ Parent = folder, Name = "StopSignPole", Size = Vector3.new(0.4, 9, 0.4), CFrame = cf * CFrame.new(7, 4.5, -0.8), Color = POLE, Material = Enum.Material.Metal })
	local sign = part({ Parent = folder, Name = "StopSign", Size = Vector3.new(3, 2.4, 0.2), CFrame = cf * CFrame.new(7, 8.5, -0.8), Color = Color3.fromRGB(255, 255, 255), CanCollide = false })
	surfaceText(sign, Enum.NormalId.Front, "🚌 ОСТАНОВКА", Color3.fromRGB(30, 90, 170))
	surfaceText(sign, Enum.NormalId.Back, "🚌 ОСТАНОВКА", Color3.fromRGB(30, 90, 170))
end

local function trashBin(folder, pos)
	part({ Parent = folder, Name = "TrashBin", Shape = Enum.PartType.Cylinder, Size = Vector3.new(2.6, 1.6, 1.6), CFrame = CFrame.new(pos + Vector3.new(0, 1.5, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(60, 100, 70), Material = Enum.Material.Metal })
end

local function buildStreets()
	local folder = Instance.new("Folder")
	folder.Name = "StreetDetails"
	folder.Parent = City
	for _, n in Roads.LightList do
		local nodeW = Roads.NodeWidth[n] or 20
		for _, adj in Roads.Adj[n] or {} do
			local e = Roads.Edges[adj.Edge]
			local delta = Roads.Nodes[adj.To] - Roads.Nodes[n]
			if delta.Magnitude > nodeW + 14 then
				trafficLight(folder, n, nodeW, e, delta.Unit)
			end
		end
		maybeYield()
	end
	local sinceStop = 0
	for id, e in Roads.Edges do
		if e.Class == "primary" or e.Class == "secondary" or e.Class == "tertiary" then
			local a, b = Roads.Nodes[e.A], Roads.Nodes[e.B]
			local len = (b - a).Magnitude
			if len > 50 then
				local dir = (b - a).Unit
				local right = Roads.Right(dir)
				local count = math.floor(len / 90)
				for i = 1, count do
					local side = (i % 2 == 0) and 1 or -1
					local pos = a + dir * (len * i / (count + 1)) + right * side * (e.Width / 2 + 3.8)
					if not nearGameplay(pos, 70) and not nearLight(pos, 30) then
						if (id + i) % 3 == 0 then
							trashBin(folder, pos)
						else
							bench(CFrame.lookAt(pos, pos - right * side), -1)
						end
					end
				end
				sinceStop += len
				if (e.Class == "primary" or e.Class == "secondary") and sinceStop > 450 and len > 70 then
					local pos = a + dir * (len / 2) + right * (e.Width / 2 + 3.5)
					if not nearGameplay(pos, 70) and not nearLight(pos, 40) then
						sinceStop = 0
						busStop(folder, pos, dir, right)
					end
				end
			end
		end
		maybeYield()
	end
end

local function ensure(parent, className)
	local obj = parent:FindFirstChildOfClass(className)
	if not obj then
		obj = Instance.new(className)
		obj.Parent = parent
	end
	return obj
end

-- Освещение «Future» задаётся в файле места (build.py); здесь — атмосфера,
-- облака и пост-обработка. Широта — как у Первоуральска (57° с. ш.).
local function setupLighting()
	Lighting.ClockTime = 9
	Lighting.Brightness = 3
	Lighting.Ambient = Color3.fromRGB(70, 72, 80)
	Lighting.OutdoorAmbient = Color3.fromRGB(125, 128, 138)
	Lighting.GlobalShadows = true
	Lighting.EnvironmentDiffuseScale = 1
	Lighting.EnvironmentSpecularScale = 1
	Lighting.ShadowSoftness = 0.15
	Lighting.GeographicLatitude = 57
	local atm = ensure(Lighting, "Atmosphere")
	atm.Density = 0.3
	atm.Offset = 0.25
	atm.Color = Color3.fromRGB(199, 205, 215)
	atm.Decay = Color3.fromRGB(106, 112, 125)
	atm.Glare = 0.2
	atm.Haze = 1.4
	local bloom = ensure(Lighting, "BloomEffect")
	bloom.Intensity = 0.35
	bloom.Size = 24
	bloom.Threshold = 1.6
	local cc = ensure(Lighting, "ColorCorrectionEffect")
	cc.Brightness = 0.02
	cc.Contrast = 0.08
	cc.Saturation = 0.12
	cc.TintColor = Color3.fromRGB(255, 250, 245)
	local rays = ensure(Lighting, "SunRaysEffect")
	rays.Intensity = 0.06
	rays.Spread = 0.8
	local clouds = ensure(workspace.Terrain, "Clouds")
	clouds.Cover = 0.55
	clouds.Density = 0.6
end

-- Ночью в части окон загорается тёплый свет.
local nightState
function WorldBuilder.SetNight(isNight)
	if nightState == isNight then
		return
	end
	nightState = isNight
	for _, band in CollectionService:GetTagged("NightGlow") do
		band.Material = isNight and Enum.Material.Neon or Enum.Material.Glass
		band.Color = isNight and Color3.fromRGB(255, 205, 130) or WINDOW
	end
end

function WorldBuilder.Build()
	local old = workspace:FindFirstChild("City")
	if old then
		old:Destroy()
	end
	for _, child in workspace:GetChildren() do
		if child.Name == "Baseplate" or child:IsA("SpawnLocation") then
			child:Destroy()
		end
	end
	City = Instance.new("Folder")
	City.Name = "City"
	City.Parent = workspace

	local anchors = Meta.Anchors
	buildTerrain()
	buildRoads()
	buildRealBuildings()
	buildStreetSigns()
	buildResidential()
	buildCityHall(anchors.CityHall)
	buildPolice(anchors.Police)
	buildHospital(anchors.Hospital)
	buildBank(anchors.Bank)
	buildOffice(anchors.Office)
	buildSupermarket(anchors.Supermarket)
	buildFlorist(anchors.Florist)
	buildCafe(anchors.Cafe)
	buildDealership(anchors.Dealership)
	buildFactory(anchors.Factory)
	buildWedding(anchors.Wedding)
	buildPark(anchors.Park)
	buildJail(anchors.Jail)
	buildPatrolPosts()
	buildNature()
	buildStreets()
	setupLighting()

	local cars = Instance.new("Folder")
	cars.Name = "Cars"
	cars.Parent = workspace
	World.CarFolder = cars

	return World
end

return WorldBuilder
]]></ProtectedString></Properties></Item></Item></Item></Item>
<Item class="StarterPlayer" referent="RBX0000002F"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX0000002E"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBX00000029"><Properties><string name="Name">Client</string></Properties><Item class="ModuleScript" referent="RBX00000025"><Properties><string name="Name">Ambient</string><ProtectedString name="Source"><![CDATA[-- Городская жизнь вокруг игрока (только на клиенте, сервер не нагружает):
-- поток машин по правой полосе со светофорами, прохожие на тротуарах,
-- переключение огней светофоров. С прохожими можно поговорить.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local TextChatService = game:GetService("TextChatService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Roads = require(Shared:WaitForChild("Roads"))
local Rig = require(Shared:WaitForChild("Rig"))
local TrafficCar = require(Shared:WaitForChild("TrafficCar"))

local Ambient = {}

local MAX_CARS = 24
local MAX_PEDS = 32
local CAR_SPAWN_MIN, CAR_SPAWN_MAX, CAR_DESPAWN = 120, 450, 560
local PED_SPAWN_MIN, PED_SPAWN_MAX, PED_DESPAWN = 35, 240, 320

local PHRASES = {
	"Добрый день! Хорошая погода в Первоуральске.",
	"Говорят, на трубном заводе снова набирают людей.",
	"В «Пельменной» сегодня отличные пельмени!",
	"Видели Нижнешайтанский пруд? Летом там красиво.",
	"Не забудьте вечером заглянуть в парк культуры.",
	"Банкомат есть у супермаркета и у Сбербанка.",
	"Мой сосед недавно расписался в ЗАГСе. Вот это свадьба была!",
	"Осторожно на дорогах — переходите на зелёный.",
	"Работа кассира — неплохое начало карьеры.",
	"Купите цветы любимому человеку, это помогает!",
	"Полиция сегодня патрулирует центр, слышали?",
	"Такси можно вызвать прямо с телефона.",
}

local folder
local cars, peds = {}, {}
local onTalk -- колбэк: игрок поговорил с жителем
local rng = Random.new()

local function now()
	local ok, t = pcall(function()
		return workspace:GetServerTimeNow()
	end)
	return ok and t or os.clock()
end

local function myPosition()
	local char = Players.LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if hrp then
		return hrp.Position, hrp
	end
	local cam = workspace.CurrentCamera
	return cam and cam.CFrame.Position or Vector3.zero, nil
end

-- Случайное ребро рядом с точкой на расстоянии [minD, maxD].
local function randomEdgeNear(pos, minD, maxD, filter)
	for _ = 1, 40 do
		local id = rng:NextInteger(1, #Roads.Edges)
		local e = Roads.Edges[id]
		if not filter or filter(e) then
			local a, b = Roads.Nodes[e.A], Roads.Nodes[e.B]
			local mid = (a + b) / 2
			local d = (Vector3.new(mid.X, pos.Y, mid.Z) - pos).Magnitude
			if d >= minD and d <= maxD then
				return id, e
			end
		end
	end
	return nil
end

local function nextNode(from, at)
	local options = Roads.Adj[at]
	if not options or #options == 0 then
		return from, nil
	end
	if #options == 1 then
		return options[1].To, options[1].Edge
	end
	for _ = 1, 6 do
		local o = options[rng:NextInteger(1, #options)]
		if o.To ~= from then
			return o.To, o.Edge
		end
	end
	return options[1].To, options[1].Edge
end

---------------------------------------------------------------------------
-- Машины
---------------------------------------------------------------------------
local function laneCFrame(c)
	local a, b = Roads.Nodes[c.From], Roads.Nodes[c.To]
	local dir = (b - a).Unit
	local pos = a + dir * c.T + Roads.Right(dir) * (c.Width / 4)
	return CFrame.lookAt(pos, pos + dir), dir
end

local function spawnCar(pos)
	local id, e = randomEdgeNear(pos, CAR_SPAWN_MIN, CAR_SPAWN_MAX)
	if not id then
		return
	end
	local forward = rng:NextNumber() < 0.5
	local car = TrafficCar.Build(rng:NextInteger(1, 1e6))
	local c = {
		Car = car,
		From = forward and e.A or e.B,
		To = forward and e.B or e.A,
		Width = e.Width,
		Class = e.Class,
		T = 0,
		Speed = 0,
	}
	c.Len = (Roads.Nodes[c.To] - Roads.Nodes[c.From]).Magnitude
	c.T = rng:NextNumber() * c.Len
	c.CF = laneCFrame(c)
	car.Model.Parent = folder
	table.insert(cars, c)
end

local function carTargetSpeed(c, myPos, myHrp)
	local maxSpeed = (Roads.Speed[c.Class] or 30) * c.Car.Speed
	local remaining = c.Len - c.T
	local target = maxSpeed
	-- Светофор.
	if Roads.Lights[c.To] and remaining < 40 then
		local dir = (Roads.Nodes[c.To] - Roads.Nodes[c.From]).Unit
		local state = Roads.LightState(c.To, Roads.Group(dir), now())
		local stopAt = (Roads.NodeWidth[c.To] or c.Width) / 2 + 8
		if state ~= "green" and remaining > stopAt - 2 then
			target = math.min(target, math.max(0, (remaining - stopAt) * 1.5))
		end
	end
	local fwd = c.CF.LookVector
	-- Машина впереди.
	for _, o in cars do
		if o ~= c then
			local off = o.CF.Position - c.CF.Position
			local ahead = off:Dot(fwd)
			if ahead > 0 and ahead < 22 and math.abs(off:Dot(c.CF.RightVector)) < 3.5 then
				target = math.min(target, math.max(0, (ahead - 13) * 2))
			end
		end
	end
	-- Игрок или его машина на дороге.
	if myHrp then
		local off = myPos - c.CF.Position
		local ahead = off:Dot(fwd)
		if ahead > 0 and ahead < 24 and math.abs(off:Dot(c.CF.RightVector)) < 5 then
			target = math.min(target, math.max(0, (ahead - 10) * 2))
		end
	end
	return target
end

local function updateCars(dt, myPos, myHrp)
	local parts, cfs = {}, {}
	for i = #cars, 1, -1 do
		local c = cars[i]
		local dist = (c.CF.Position - myPos).Magnitude
		if dist > CAR_DESPAWN then
			c.Car.Model:Destroy()
			table.remove(cars, i)
			continue
		end
		local target = carTargetSpeed(c, myPos, myHrp)
		local accel = target > c.Speed and 18 or 45
		c.Speed = c.Speed + math.clamp(target - c.Speed, -accel * dt, accel * dt)
		c.T += c.Speed * dt
		if c.T >= c.Len then
			local nextTo, edgeId = nextNode(c.From, c.To)
			if not edgeId then
				nextTo = c.From
			end
			local e = edgeId and Roads.Edges[edgeId]
			c.From, c.To = c.To, nextTo
			if e then
				c.Width, c.Class = e.Width, e.Class
			end
			c.T -= c.Len
			c.Len = (Roads.Nodes[c.To] - Roads.Nodes[c.From]).Magnitude
		end
		local targetCF = laneCFrame(c)
		-- Плавный поворот на перекрёстках.
		c.CF = c.CF:Lerp(targetCF, math.clamp(dt * 7, 0, 1))
		if dist < 400 then
			for j, cf in TrafficCar.CFrames(c.Car, c.CF) do
				table.insert(parts, c.Car.List[j])
				table.insert(cfs, cf)
			end
		end
	end
	if #parts > 0 then
		workspace:BulkMoveTo(parts, cfs, Enum.BulkMoveMode.FireCFrameChanged)
	end
end

---------------------------------------------------------------------------
-- Прохожие
---------------------------------------------------------------------------
local function walkPoint(p)
	local a, b = Roads.Nodes[p.From], Roads.Nodes[p.To]
	local dir = (b - a).Unit
	return a + dir * p.T + Roads.Right(dir) * p.Side * (p.Width / 2 + 2.5), dir
end

local function talk(p)
	if p.TalkUntil and os.clock() < p.TalkUntil then
		return
	end
	p.TalkUntil = os.clock() + 5
	local text = PHRASES[rng:NextInteger(1, #PHRASES)]
	pcall(function()
		TextChatService:DisplayBubble(p.Rig.Parts.Head, text)
	end)
	if onTalk then
		onTalk()
	end
end

local function spawnPed(pos)
	local id, e = randomEdgeNear(pos, PED_SPAWN_MIN, PED_SPAWN_MAX)
	if not id then
		return
	end
	local rig = Rig.Build({ Seed = rng:NextInteger(1, 1e6) })
	local forward = rng:NextNumber() < 0.5
	local p = {
		Rig = rig,
		From = forward and e.A or e.B,
		To = forward and e.B or e.A,
		Width = e.Width,
		Side = rng:NextNumber() < 0.5 and 1 or -1,
		Speed = rng:NextNumber(4.5, 7),
	}
	p.Len = (Roads.Nodes[p.To] - Roads.Nodes[p.From]).Magnitude
	p.T = rng:NextNumber() * p.Len
	local point, dir = walkPoint(p)
	p.CF = CFrame.lookAt(point, point + dir)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Поговорить"
	prompt.ObjectText = "Житель"
	prompt.MaxActivationDistance = 8
	prompt.RequiresLineOfSight = false
	prompt.Parent = rig.Parts.Torso
	prompt.Triggered:Connect(function()
		talk(p)
	end)
	rig.Model.Parent = folder
	table.insert(peds, p)
end

local function updatePeds(dt, myPos)
	local parts, cfs = {}, {}
	for i = #peds, 1, -1 do
		local p = peds[i]
		local dist = (p.CF.Position - myPos).Magnitude
		if dist > PED_DESPAWN then
			p.Rig.Model:Destroy()
			table.remove(peds, i)
			continue
		end
		local talking = p.TalkUntil and os.clock() < p.TalkUntil
		local swing = 0
		if talking then
			-- Остановился и повернулся к игроку.
			local look = Vector3.new(myPos.X, p.CF.Position.Y, myPos.Z)
			if (look - p.CF.Position).Magnitude > 0.5 then
				p.CF = p.CF:Lerp(CFrame.lookAt(p.CF.Position, look), math.clamp(dt * 6, 0, 1))
			end
		else
			p.T += p.Speed * dt
			if p.T >= p.Len then
				local nextTo, edgeId = nextNode(p.From, p.To)
				local e = edgeId and Roads.Edges[edgeId]
				p.From, p.To = p.To, nextTo
				if e then
					p.Width = e.Width
				end
				p.T -= p.Len
				p.Len = math.max(1, (Roads.Nodes[p.To] - Roads.Nodes[p.From]).Magnitude)
			end
			local point, dir = walkPoint(p)
			local target = CFrame.lookAt(point, point + dir)
			p.CF = p.CF:Lerp(target, math.clamp(dt * 5, 0, 1))
			p.Rig.Phase += dt * p.Speed * 1.4
			swing = math.sin(p.Rig.Phase) * 0.55
		end
		if dist < 260 then
			local pose = Rig.Pose(p.Rig, p.CF + Vector3.new(0, 0.2, 0), swing)
			for j, part in p.Rig.List do
				table.insert(parts, part)
				table.insert(cfs, pose[j])
			end
		end
	end
	if #parts > 0 then
		workspace:BulkMoveTo(parts, cfs, Enum.BulkMoveMode.FireCFrameChanged)
	end
end

---------------------------------------------------------------------------
-- Огни светофоров (головы светофоров ставит сервер с тегом TrafficLight)
---------------------------------------------------------------------------
local LIGHT_COLORS = {
	Red = Color3.fromRGB(255, 40, 30),
	Yellow = Color3.fromRGB(255, 200, 30),
	Green = Color3.fromRGB(40, 230, 80),
}
local OFF = Color3.fromRGB(40, 40, 40)

local function updateLights()
	local t = now()
	for _, head in CollectionService:GetTagged("TrafficLight") do
		local node, group = head:GetAttribute("Node"), head:GetAttribute("Group")
		if node and group then
			local state = Roads.LightState(node, group, t)
			local on = state == "green" and "Green" or state == "yellow" and "Yellow" or "Red"
			for name, color in LIGHT_COLORS do
				local bulb = head:FindFirstChild(name)
				if bulb then
					local lit = name == on
					bulb.Color = lit and color or OFF
					bulb.Material = lit and Enum.Material.Neon or Enum.Material.SmoothPlastic
				end
			end
		end
	end
end

---------------------------------------------------------------------------

-- Снимок для превью (тесты): ставит машины и прохожих вокруг точки без анимации.
function Ambient.Snapshot(parent, pos, nCars, nPeds)
	folder = parent
	for _ = 1, nCars do
		spawnCar(pos)
	end
	for _ = 1, nPeds do
		spawnPed(pos)
	end
	for _, c in cars do
		for j, cf in TrafficCar.CFrames(c.Car, c.CF) do
			c.Car.List[j].CFrame = cf
		end
	end
	for _, p in peds do
		Rig.Place(p.Rig, p.CF + Vector3.new(0, 0.2, 0), 0.3)
	end
	return #cars, #peds
end

function Ambient.Start(talkCallback)
	onTalk = talkCallback
	folder = Instance.new("Folder")
	folder.Name = "AmbientLife"
	folder.Parent = workspace
	if #Roads.Edges == 0 then
		return
	end
	local lightAcc, spawnAcc = 0, 0
	RunService.Heartbeat:Connect(function(dt)
		local myPos, myHrp = myPosition()
		spawnAcc += dt
		if spawnAcc > 0.25 then
			spawnAcc = 0
			if #cars < MAX_CARS then
				spawnCar(myPos)
			end
			if #peds < MAX_PEDS then
				spawnPed(myPos)
			end
		end
		updateCars(dt, myPos, myHrp)
		updatePeds(dt, myPos)
		lightAcc += dt
		if lightAcc > 0.3 then
			lightAcc = 0
			updateLights()
		end
	end)
end

return Ambient
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000026"><Properties><string name="Name">CarController</string><ProtectedString name="Source"><![CDATA[-- Управление машиной на стороне водителя: W/S — газ/тормоз/задний ход,
-- A/D — поворот. Работает с LinearVelocity/AngularVelocity из VehicleService.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local CarController = {}
CarController.Speed = 0
CarController.Driving = false

local function approach(current, target, step)
	if current < target then
		return math.min(current + step, target)
	end
	return math.max(current - step, target)
end

function CarController.Start()
	local player = Players.LocalPlayer
	local speed = 0

	RunService.Heartbeat:Connect(function(dt)
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local seat = hum and hum.SeatPart
		if not (seat and seat:IsA("VehicleSeat") and seat:GetAttribute("LifeCar")) then
			speed = 0
			CarController.Driving = false
			CarController.Speed = 0
			return
		end
		local model = seat.Parent
		local root = model and model.PrimaryPart
		local lv = root and root:FindFirstChild("Drive")
		local av = root and root:FindFirstChild("Steer")
		if not lv or not av then
			return
		end
		CarController.Driving = true
		local maxSpeed = model:GetAttribute("MaxSpeed") or 60
		local throttle = seat.ThrottleFloat
		local steer = seat.SteerFloat

		local target = throttle * maxSpeed
		if throttle < 0 then
			target = throttle * maxSpeed * 0.35
		end
		local accel = 30
		if throttle == 0 then
			accel = 20
		elseif (throttle > 0 and speed < 0) or (throttle < 0 and speed > 0) then
			accel = 90 -- торможение
		end
		speed = approach(speed, target, accel * dt)

		local look = root.CFrame.LookVector
		local flat = Vector3.new(look.X, 0, look.Z)
		if flat.Magnitude < 0.1 then
			return
		end
		flat = flat.Unit
		-- Если врезались — скорость падает до реальной.
		local actual = root.AssemblyLinearVelocity:Dot(flat)
		if math.abs(actual) < math.abs(speed) - 12 then
			speed = actual
		end

		lv.VectorVelocity = flat * speed
		local turnFactor = math.clamp(math.abs(speed) / 12, 0, 1)
		local dir = speed >= 0 and 1 or -1
		av.AngularVelocity = Vector3.new(0, -steer * 1.7 * turnFactor * dir, 0)
		CarController.Speed = math.abs(speed)
	end)
end

return CarController
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX00000027"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[-- Клиент «Жизнь Города»: HUD, потребности, телефон, меню ролей, магазины,
-- банк, автосалон, задания работы, GPS, отношения и уведомления.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Lighting = game:GetService("Lighting")
local TextChatService = game:GetService("TextChatService")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Ui = require(script.Parent:WaitForChild("Ui"))
local CarController = require(script.Parent:WaitForChild("CarController"))
local Ambient = require(script.Parent:WaitForChild("Ambient"))

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local ActionRemote = Remotes:WaitForChild("Action")
local EventRemote = Remotes:WaitForChild("Event")

local new, T = Ui.new, Ui.Theme

local function send(name, payload)
	ActionRemote:FireServer(name, payload or {})
end

local state = {
	Inventory = {},
	Relations = {},
	Partner = nil,
	Cars = {},
	GPS = {},
	Task = nil,
	PhoneTab = "Задания",
	Quests = {},
	SelectedPerson = nil,
}

local gui = new("ScreenGui", {
	Name = "LifeCityUI",
	ResetOnSpawn = false,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	Parent = player:WaitForChild("PlayerGui"),
})

-- Масштаб интерфейса под размер экрана (телефоны/планшеты).
local scaled = {}
local function currentScale()
	local cam = workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
	return math.clamp(math.min(vp.X / 1150, vp.Y / 680), 0.55, 1)
end
local function scaleIt(frame)
	local s = new("UIScale", { Scale = currentScale(), Parent = frame })
	table.insert(scaled, s)
	return frame
end
task.spawn(function()
	while true do
		task.wait(1)
		local sc = currentScale()
		for i = #scaled, 1, -1 do
			local s = scaled[i]
			if s.Parent then
				s.Scale = sc
			else
				table.remove(scaled, i)
			end
		end
	end
end)

---------------------------------------------------------------------------
-- Уведомления
---------------------------------------------------------------------------
local notifyHolder = new("Frame", {
	BackgroundTransparency = 1,
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 70),
	Size = UDim2.fromOffset(460, 400),
	Parent = gui,
}, { Ui.list(6) })
scaleIt(notifyHolder)

local KIND_COLORS = { good = T.Good, bad = T.Bad, warn = T.Warn, info = T.Accent }
local notifyCount = 0

local function notify(text, kind)
	notifyCount += 1
	local children = notifyHolder:GetChildren()
	local frames = {}
	for _, c in children do
		if c:IsA("Frame") then
			table.insert(frames, c)
		end
	end
	if #frames >= 5 then
		table.sort(frames, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		frames[1]:Destroy()
	end
	local f = Ui.panel({
		LayoutOrder = notifyCount,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = notifyHolder,
	})
	new("Frame", { BackgroundColor3 = KIND_COLORS[kind] or T.Accent, BorderSizePixel = 0, Size = UDim2.new(0, 5, 1, 0), Parent = f })
	Ui.label({
		Text = text,
		Size = UDim2.new(1, -20, 0, 0),
		Position = UDim2.fromOffset(14, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		TextSize = 15,
		Parent = f,
	}, nil)
	Ui.padding(6).Parent = f
	task.delay(6, function()
		if f.Parent then
			TweenService:Create(f, TweenInfo.new(0.4), { BackgroundTransparency = 1 }):Play()
			task.wait(0.4)
			f:Destroy()
		end
	end)
end

---------------------------------------------------------------------------
-- HUD: деньги, роль, время, потребности
---------------------------------------------------------------------------
local hud = Ui.panel({
	AnchorPoint = Vector2.new(0, 1),
	Position = UDim2.new(0, 12, 1, -12),
	Size = UDim2.fromOffset(280, 258),
	Parent = gui,
})
scaleIt(hud)
Ui.padding(10).Parent = hud
Ui.list(4).Parent = hud

local cashLabel = Ui.label({ LayoutOrder = 1, Font = Enum.Font.GothamBold, TextSize = 20, Text = "💵 0$", TextColor3 = Color3.fromRGB(130, 230, 140), Parent = hud })
local bankLabel = Ui.label({ LayoutOrder = 2, TextSize = 15, Text = "💳 Карта: 0$", TextColor3 = T.Sub, Parent = hud })
local roleLabel = Ui.label({ LayoutOrder = 3, TextSize = 15, Font = Enum.Font.GothamBold, Text = "", Parent = hud })
local clockLabel = Ui.label({ LayoutOrder = 4, TextSize = 14, Text = "", TextColor3 = T.Sub, Parent = hud })
local questLabel = Ui.label({ LayoutOrder = 5, TextSize = 14, Text = "", TextColor3 = Color3.fromRGB(255, 215, 110), Parent = hud })

local needBars = {}
for i, need in Config.NeedOrder do
	local info = Config.Needs[need]
	local row = new("Frame", { LayoutOrder = 10 + i, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 28), Parent = hud })
	Ui.label({ Text = info.Name, TextSize = 13, Size = UDim2.new(1, 0, 0, 14), TextColor3 = T.Sub, Parent = row })
	local value = Ui.label({ Text = "100", TextSize = 13, Size = UDim2.new(1, 0, 0, 14), TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = T.Sub, Parent = row })
	local bg, fill = Ui.bar(row, info.Color, 10)
	bg.Position = UDim2.fromOffset(0, 16)
	needBars[need] = { Fill = fill, Value = value, Color = info.Color }
end

local function refreshHud()
	cashLabel.Text = "💵 " .. Ui.money(player:GetAttribute("Cash"))
	bankLabel.Text = "💳 Карта: " .. Ui.money(player:GetAttribute("Bank"))
	local role = Config.Roles[player:GetAttribute("Role") or "Citizen"]
	local job = Config.Jobs[player:GetAttribute("Job") or ""]
	if role then
		roleLabel.Text = role.Name .. (job and (" • " .. job.Name) or " • без работы")
		roleLabel.TextColor3 = role.Color:Lerp(Color3.new(1, 1, 1), 0.4)
	end
	local qd, qt = player:GetAttribute("QuestsDone") or 0, player:GetAttribute("QuestsTotal") or 0
	questLabel.Text = qt > 0 and ("📅 Задания дня: " .. qd .. "/" .. qt .. (qd >= qt and " ✅" or " — телефон [M]")) or ""
	for need, bar in needBars do
		local v = player:GetAttribute(need) or 0
		bar.Fill.Size = UDim2.fromScale(math.clamp(v / 100, 0, 1), 1)
		bar.Value.Text = tostring(math.floor(v))
		bar.Fill.BackgroundColor3 = v < 20 and T.Bad or bar.Color
	end
end
