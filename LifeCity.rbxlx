8;904,2204,40,8;900,2216,48,16;892,2232,48,16;888,2244,56,8;884,2252,48,8;876,2260,48,8;872,2268,56,8;868,2276,64,8;864,2288,56,16;860,2300,48,8;864,2308,40,8]==]
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX00000023"><Properties><string name="Name">Services</string></Properties><Item class="ModuleScript" referent="RBX00000013"><Properties><string name="Name">CrimeService</string><ProtectedString name="Source"><![CDATA[-- Преступность: уровень розыска (звёзды), ограбления, арест, тюрьма.

local Players = game:GetService("Players")

local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Config"))
local Util = require(script.Parent.Util)

local CrimeService = {}
local ctx

local lastCrime = {} -- [Player] = os.clock()
local lastAttacker = {} -- [victim] = { Player, Time }
local robberyCooldown = {} -- [spotId] = os.clock()
local cellIndex = {} -- [Player] = номер камеры

local function isLaw(player)
	local role = Config.Roles[player:GetAttribute("Role") or ""]
	return role ~= nil and role.CanArrest == true
end
CrimeService.IsLaw = isLaw

local function alertPolice(text, position)
	for _, p in Players:GetPlayers() do
		if isLaw(p) then
			ctx.Net.Send(p, "Alert", { Text = text, Position = position })
		end
	end
end
CrimeService.AlertPolice = alertPolice

function CrimeService.AddWanted(player, stars, reason)
	local before = player:GetAttribute("Wanted") or 0
	local after = math.clamp(before + stars, 0, 5)
	player:SetAttribute("Wanted", after)
	lastCrime[player] = os.clock()
	if after > before then
		ctx.Net.Notify(player, "Розыск повышен: " .. Util.Stars(after) .. " (" .. reason .. ")", "bad")
		alertPolice("🚨 " .. player.DisplayName .. " — " .. reason .. " " .. Util.Stars(after), Util.Position(player))
	end
	if isLaw(player) and after >= 2 then
		-- Полицейский-преступник лишается значка.
		ctx.Net.Notify(player, "Вы уволены из органов за преступления!", "bad")
		task.defer(ctx.Players.SetRole, player, "Citizen", true)
	end
end

function CrimeService.TagAttack(victim, attacker)
	lastAttacker[victim] = { Player = attacker, Time = os.clock() }
end

function CrimeService.CellFor(player)
	local cells = ctx.World.Jail.Cells
	local idx = cellIndex[player]
	if not idx then
		idx = math.random(1, #cells)
		cellIndex[player] = idx
	end
	return cells[idx]
end

local function release(player)
	player:SetAttribute("Jailed", 0)
	cellIndex[player] = nil
	if Util.Alive(player) then
		Util.Teleport(player, ctx.World.Jail.Exit)
		ctx.Tools.GiveRoleTools(player)
	end
	ctx.Net.Notify(player, "Вы освобождены. Ведите себя хорошо!", "good")
end

function CrimeService.Jail(player, seconds)
	ctx.Jobs.Quit(player, true)
	ctx.Needs.StopActivity(player)
	ctx.Vehicles.DespawnFor(player, false)
	ctx.Tools.RemoveTools(player)
	local hum = Util.Humanoid(player)
	if hum then
		hum.Sit = false
	end
	player:SetAttribute("Wanted", 0)
	player:SetAttribute("Stunned", nil)
	player:SetAttribute("Jailed", seconds)
	task.wait()
	Util.Teleport(player, CrimeService.CellFor(player))
	ctx.Needs.UpdateSpeed(player)
end

function CrimeService.Arrest(officer, target)
	if not isLaw(officer) then
		return false
	end
	local stars = target:GetAttribute("Wanted") or 0
	if stars <= 0 then
		ctx.Net.Notify(officer, target.DisplayName .. " не находится в розыске.", "bad")
		return false
	end
	if (target:GetAttribute("Jailed") or 0) > 0 then
		return false
	end
	local seconds = stars * Config.Crime.JailSecondsPerStar
	CrimeService.Jail(target, seconds)
	local role = Config.Roles[officer:GetAttribute("Role")]
	local bonus = (role.ArrestBonus or 100) * stars
	ctx.Data.AddCash(officer, bonus)
	local data = ctx.Data.Get(officer)
	if data then
		data.Stats.Arrests += 1
	end
	ctx.Quests.Progress(officer, "arrest", 1)
	ctx.Net.Notify(target, "Вас арестовал(а) " .. officer.DisplayName .. ". Срок: " .. seconds .. " сек.", "bad")
	ctx.Net.Send(officer, "Earned", { Amount = bonus, Text = "Премия за задержание " .. target.DisplayName })
	ctx.Net.NotifyAll("👮 " .. officer.DisplayName .. " задержал(а) " .. target.DisplayName .. " (" .. Util.Stars(stars) .. ")", "info")
	return true
end

function CrimeService.OnDeath(victim)
	local info = lastAttacker[victim]
	lastAttacker[victim] = nil
	if not info or os.clock() - info.Time > 10 then
		return
	end
	local killer = info.Player
	if not killer.Parent or killer == victim then
		return
	end
	local victimWanted = (victim:GetAttribute("Wanted") or 0) > 0
	if not (isLaw(killer) and victimWanted) then
		CrimeService.AddWanted(killer, 2, "убийство")
	end
end

function CrimeService.OnPlayerRemoving(player)
	local jailed = player:GetAttribute("Jailed") or 0
	local data = ctx.Data.Get(player)
	if data then
		local wanted = player:GetAttribute("Wanted") or 0
		-- Выход из игры в розыске = автоматический срок при следующем входе.
		data.JailLeft = jailed > 0 and jailed or (wanted > 0 and wanted * Config.Crime.JailSecondsPerStar or nil)
	end
	lastCrime[player] = nil
	lastAttacker[player] = nil
	cellIndex[player] = nil
end

local function setupRobberies()
	local MakePrompt = ctx.WorldBuilder.MakePrompt
	for spotId, spotPart in ctx.World.Robbery do
		local info = Config.Crime.Robberies[spotId]
		local pp = MakePrompt(spotPart, "Ограбить", info.Name, info.Duration, 8)
		pp.Style = Enum.ProximityPromptStyle.Default
		pp.Triggered:Connect(function(player)
			if isLaw(player) or player:GetAttribute("Role") == "Medic" then
				ctx.Net.Notify(player, "Ваша роль не позволяет совершать преступления.", "bad")
				return
			end
			if (player:GetAttribute("Jailed") or 0) > 0 then
				return
			end
			local last = robberyCooldown[spotId]
			if last and os.clock() - last < info.Cooldown then
				ctx.Net.Notify(player, "Здесь уже пусто. Приходите через " .. math.ceil(info.Cooldown - (os.clock() - last)) .. " сек.", "bad")
				return
			end
			robberyCooldown[spotId] = os.clock()
			local amount = math.random(info.Min, info.Max)
			ctx.Data.AddCash(player, amount)
			local data = ctx.Data.Get(player)
			if data then
				data.Stats.Robberies += 1
			end
			ctx.Quests.Progress(player, "rob", 1)
			ctx.Net.Send(player, "Earned", { Amount = amount, Text = "Ограбление: " .. info.Name })
			CrimeService.AddWanted(player, info.Stars, "ограбил(а) " .. info.Name)
			ctx.Net.NotifyAll("🚨 Ограблен(а) " .. info.Name .. "! Полиция выехала на место.", "warn")
		end)
	end
end

function CrimeService.Init(c)
	ctx = c
	setupRobberies()

	-- Цикл: снижение розыска и тюремный срок.
	task.spawn(function()
		while true do
			task.wait(1)
			local now = os.clock()
			for _, player in Players:GetPlayers() do
				local wanted = player:GetAttribute("Wanted") or 0
				if wanted > 0 and now - (lastCrime[player] or now) >= Config.Crime.WantedDecaySeconds then
					player:SetAttribute("Wanted", wanted - 1)
					lastCrime[player] = now
					if wanted - 1 == 0 then
						ctx.Net.Notify(player, "Полиция прекратила поиски. Розыск снят.", "good")
					end
				end
				local jailed = player:GetAttribute("Jailed") or 0
				if jailed > 0 then
					jailed -= 1
					if jailed <= 0 then
						release(player)
					else
						player:SetAttribute("Jailed", jailed)
						local jail = ctx.World.Jail
						local pos = Util.Position(player)
						if pos and (pos - jail.Center).Magnitude > jail.Radius then
							Util.Teleport(player, CrimeService.CellFor(player))
							ctx.Net.Notify(player, "Побег не удался!", "bad")
						end
					end
				end
			end
		end
	end)
end

return CrimeService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000014"><Properties><string name="Name">DataService</string><ProtectedString name="Source"><![CDATA[-- Хранение прогресса игроков (деньги, вещи, машины, дом, отношения).
-- Работает через DataStore; если API отключено (например, в Studio без
-- «Enable Studio Access to API Services»), игра работает без сохранений.

local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Config"))

local DataService = {}

-- ВАЖНО: имя хранилища НЕ меняется между обновлениями игры — иначе игроки
-- потеряют прогресс. Изменения формата данных делаются через DATA_VERSION
-- и миграции ниже (см. UPDATES.md).
local STORE_NAME = "LifeCity_v1"
local DATA_VERSION = 2

-- Миграции: функция для каждой новой версии формата данных.
-- Старые сохранения последовательно доводятся до DATA_VERSION.
local MIGRATIONS = {
	[2] = function(data)
		-- v2: город Первоуральск, ежедневные задания, монетизация.
		data.Quests = nil
		data.RegistrationBonusGiven = data.RegistrationBonusGiven or false
	end,
}
local store
local storeOk = pcall(function()
	store = DataStoreService:GetDataStore(STORE_NAME)
end)

local profiles = {} -- [Player] = data

local function defaultData()
	return {
		Version = DATA_VERSION,
		Cash = Config.StartCash,
		Bank = Config.StartBank,
		Inventory = { bread = 2, water = 2 },
		Cars = {},
		HasHouse = false,
		Role = "Citizen",
		Relations = {}, -- [tostring(userId)] = { Points, Status, Name }
		Partner = nil, -- tostring(userId)
		Needs = { Hunger = 80, Energy = 90, Hygiene = 90, Fun = 70 },
		Stats = { TasksDone = 0, Arrests = 0, Robberies = 0, Earned = 0, QuestsDone = 0 },
		RegistrationBonusGiven = false,
		LastDaily = 0,
		DailyStreak = 0,
	}
end

local function reconcile(data, template)
	for k, v in template do
		if data[k] == nil then
			data[k] = v
		elseif type(v) == "table" and type(data[k]) == "table" and k ~= "Relations" and k ~= "Inventory" and k ~= "Cars" then
			reconcile(data[k], v)
		end
	end
	return data
end

local readOnly = {} -- [Player] = true, если загрузка не удалась (не перезаписываем сохранение)

function DataService.Load(player)
	local data
	local loaded = not (storeOk and store)
	if storeOk and store then
		for attempt = 1, 3 do
			local ok, result = pcall(function()
				return store:GetAsync("p_" .. player.UserId)
			end)
			if ok then
				data = result
				loaded = true
				break
			end
			warn("[Data] Ошибка загрузки (попытка " .. attempt .. "): " .. tostring(result))
			task.wait(1)
		end
	end
	if not loaded then
		readOnly[player] = true
		warn("[Data] Не удалось загрузить данные " .. player.Name .. " — сохранение отключено, чтобы не стереть прогресс.")
	end
	local isNew = type(data) ~= "table"
	data = type(data) == "table" and data or {}
	if not isNew then
		data.Version = data.Version or 1
		for v = data.Version + 1, DATA_VERSION do
			if MIGRATIONS[v] then
				MIGRATIONS[v](data)
			end
			data.Version = v
		end
	end
	data = reconcile(data, defaultData())
	data.Version = DATA_VERSION
	profiles[player] = data
	return data
end

function DataService.Get(player)
	return profiles[player]
end

function DataService.Save(player)
	local data = profiles[player]
	if not data or not storeOk or not store or readOnly[player] then
		return
	end
	-- Сохраняем актуальные потребности из атрибутов.
	for _, need in Config.NeedOrder do
		local v = player:GetAttribute(need)
		if v then
			data.Needs[need] = v
		end
	end
	local ok, err = pcall(function()
		store:UpdateAsync("p_" .. player.UserId, function(old)
			-- Не перезаписываем более новый формат старой версией сервера
			-- (во время обновления старые и новые серверы работают одновременно).
			if type(old) == "table" and (old.Version or 1) > DATA_VERSION then
				return nil
			end
			return data
		end)
	end)
	if not ok then
		warn("[Data] Ошибка сохранения: " .. tostring(err))
	end
end

function DataService.Release(player)
	DataService.Save(player)
	profiles[player] = nil
	readOnly[player] = nil
end

function DataService.IsReadOnly(player)
	return readOnly[player] == true
end

-- Деньги ----------------------------------------------------------------

local function syncMoney(player)
	local data = profiles[player]
	if data then
		player:SetAttribute("Cash", data.Cash)
		player:SetAttribute("Bank", data.Bank)
	end
end
DataService.SyncMoney = syncMoney

function DataService.AddCash(player, amount)
	local data = profiles[player]
	if not data then
		return false
	end
	data.Cash = math.max(0, math.floor(data.Cash + amount))
	if amount > 0 then
		data.Stats.Earned += amount
	end
	syncMoney(player)
	return true
end

-- Списывает деньги: сначала наличные, затем с карты.
function DataService.Spend(player, amount)
	local data = profiles[player]
	if not data or amount < 0 then
		return false
	end
	if data.Cash + data.Bank < amount then
		return false
	end
	local fromCash = math.min(data.Cash, amount)
	data.Cash -= fromCash
	data.Bank -= amount - fromCash
	syncMoney(player)
	return true
end

function DataService.Total(player)
	local data = profiles[player]
	return data and (data.Cash + data.Bank) or 0
end

-- Инвентарь -------------------------------------------------------------

function DataService.AddItem(player, item, count)
	local data = profiles[player]
	if not data then
		return
	end
	data.Inventory[item] = (data.Inventory[item] or 0) + (count or 1)
	if data.Inventory[item] <= 0 then
		data.Inventory[item] = nil
	end
end

function DataService.HasItem(player, item)
	local data = profiles[player]
	return data ~= nil and (data.Inventory[item] or 0) > 0
end

function DataService.TakeItem(player, item)
	if not DataService.HasItem(player, item) then
		return false
	end
	DataService.AddItem(player, item, -1)
	return true
end

function DataService.Init()
	if RunService:IsStudio() and storeOk then
		-- Проверяем, доступны ли DataStore в Studio.
		local ok = pcall(function()
			store:GetAsync("__probe")
		end)
		if not ok then
			storeOk = false
			warn("[Data] DataStore недоступен — прогресс не будет сохраняться. Включите Game Settings → Security → Enable Studio Access to API Services.")
		end
	end

	task.spawn(function()
		while true do
			task.wait(120)
			for _, player in Players:GetPlayers() do
				task.spawn(DataService.Save, player)
			end
		end
	end)

	game:BindToClose(function()
		local threads = 0
		for _, player in Players:GetPlayers() do
			threads += 1
			task.spawn(function()
				DataService.Save(player)
				threads -= 1
			end)
		end
		local start = os.clock()
		while threads > 0 and os.clock() - start < 20 do
			task.wait(0.1)
		end
	end)
end

return DataService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000015"><Properties><string name="Name">EconomyService</string><ProtectedString name="Source"><![CDATA[-- Магазины, банкоматы, инвентарь и использование предметов.

local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Config"))
local Util = require(script.Parent.Util)

local EconomyService = {}
local ctx

local SHOP_DISTANCE = 16

function EconomyService.SendInventory(player)
	local data = ctx.Data.Get(player)
	if data then
		ctx.Net.Send(player, "Inventory", { Items = data.Inventory })
	end
end

local function nearAnyATM(player)
	for _, atm in ctx.World.ATMs do
		if Util.Near(player, atm, SHOP_DISTANCE) then
			return true
		end
	end
	return false
end

function EconomyService.Init(c)
	ctx = c
	local World = ctx.World
	local MakePrompt = ctx.WorldBuilder.MakePrompt
	local Net = ctx.Net
	local Data = ctx.Data

	for shopId, shopPart in World.Shops do
		local shop = Config.Shops[shopId]
		local pp = MakePrompt(shopPart, "Купить", shop.Name, 0, 10)
		pp.Triggered:Connect(function(player)
			Net.Send(player, "OpenShop", { Shop = shopId })
		end)
	end

	for _, atm in World.ATMs do
		local pp = MakePrompt(atm, "Открыть", "Банк", 0, 10)
		pp.Triggered:Connect(function(player)
			Net.Send(player, "OpenBank", {})
		end)
	end

	MakePrompt(World.Desks.Jobs, "Найти работу", "Биржа труда", 0, 12).Triggered:Connect(function(player)
		Net.Send(player, "OpenPhone", { Tab = "Работа" })
	end)
	MakePrompt(World.Desks.Roles, "Сменить роль", "Отдел кадров", 0, 12).Triggered:Connect(function(player)
		Net.Send(player, "OpenRoleMenu", {})
	end)

	Net.On("BuyItem", function(player, p)
		local shopId, itemId = p.Shop, p.Item
		local count = math.clamp(math.floor(tonumber(p.Count) or 1), 1, 10)
		local shop = Config.Shops[shopId]
		local item = Config.Items[itemId]
		if not shop or not item or not table.find(shop.Items, itemId) then
			return
		end
		if not Util.Near(player, World.Shops[shopId], SHOP_DISTANCE) then
			Net.Notify(player, "Подойдите ближе к прилавку.", "bad")
			return
		end
		local price = item.Price * count
		if not Data.Spend(player, price) then
			Net.Notify(player, "Недостаточно денег (нужно " .. price .. "$).", "bad")
			return
		end
		Data.AddItem(player, itemId, count)
		Net.Notify(player, "Куплено: " .. item.Name .. " ×" .. count .. " за " .. price .. "$", "good")
		EconomyService.SendInventory(player)
		ctx.Quests.Progress(player, "shop", 1)
	end)

	Net.On("UseItem", function(player, p)
		local item = Config.Items[p.Item]
		if not item or not item.Effects then
			return
		end
		if not Util.Alive(player) then
			return
		end
		if not Data.TakeItem(player, p.Item) then
			Net.Notify(player, "У вас нет этого предмета.", "bad")
			return
		end
		ctx.Needs.ApplyEffects(player, item.Effects)
		if item.Effects.Hunger and item.Effects.Hunger >= 10 then
			ctx.Quests.Progress(player, "eat", 1)
		end
		Net.Notify(player, "Вы использовали: " .. item.Name, "good")
		EconomyService.SendInventory(player)
	end)

	Net.On("Bank", function(player, p)
		local amount = math.floor(tonumber(p.Amount) or 0)
		if amount <= 0 or amount > 1e9 then
			return
		end
		if not nearAnyATM(player) then
			Net.Notify(player, "Нужно стоять у банкомата.", "bad")
			return
		end
		local data = Data.Get(player)
		if not data then
			return
		end
		if p.Op == "deposit" then
			amount = math.min(amount, data.Cash)
			data.Cash -= amount
			data.Bank += amount
			Net.Notify(player, "Внесено на карту: " .. amount .. "$", "good")
		elseif p.Op == "withdraw" then
			amount = math.min(amount, data.Bank)
			data.Bank -= amount
			data.Cash += amount
			Net.Notify(player, "Снято наличными: " .. amount .. "$", "good")
		end
		Data.SyncMoney(player)
	end)

	local taxiBusy = {}
	Net.On("Taxi", function(player, p)
		if taxiBusy[player] or not Util.Alive(player) then
			return
		end
		local target
		for _, place in World.GPS do
			if place.Name == p.Name then
				target = place.Position
			end
		end
		if p.Home then
			local home = ctx.Housing.SpawnFor(player)
			target = home and home.Position
		end
		if not target then
			return
		end
		if (player:GetAttribute("Jailed") or 0) > 0 or (player:GetAttribute("Wanted") or 0) > 0 then
			Net.Notify(player, "Таксисты не берут разыскиваемых пассажиров!", "bad")
			return
		end
		local pos = Util.Position(player)
		local price = Config.TaxiPrice((pos - target).Magnitude)
		if not Data.Spend(player, price) then
			Net.Notify(player, "Недостаточно денег на такси (" .. price .. "$).", "bad")
			return
		end
		taxiBusy[player] = true
		ctx.Needs.StopActivity(player)
		Net.Notify(player, "🚕 Такси подъехало. Поездка: " .. price .. "$", "info")
		task.delay(2, function()
			taxiBusy[player] = nil
			local hum = Util.Humanoid(player)
			if hum and hum.Health > 0 and (player:GetAttribute("Jailed") or 0) == 0 then
				hum.Sit = false
				Util.Teleport(player, CFrame.new(target + Vector3.new(math.random(-4, 4), 3, math.random(-4, 4))))
				Net.Notify(player, "Приехали! Хорошего дня.", "good")
			end
		end)
	end)

	Net.On("GetState", function(player)
		EconomyService.SendInventory(player)
		ctx.Vehicles.SendCars(player)
		ctx.Social.SendRelations(player)
		ctx.Jobs.ResendTask(player)
		ctx.Net.Send(player, "GPS", { List = ctx.World.GPS })
	end)
end

return EconomyService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000016"><Properties><string name="Name">HousingService</string><ProtectedString name="Source"><![CDATA[-- Дома: покупка в агентстве недвижимости, личная дверь, кровать, душ,
-- телевизор и холодильник. Супруг(а) пользуется домом вместе с владельцем.

local Players = game:GetService("Players")

local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Config"))
local Util = require(script.Parent.Util)

local HousingService = {}
local ctx

local owners = {} -- [houseId] = Player
local fridgeCooldown = {} -- [Player] = time

local function houseOf(player)
	for id, owner in owners do
		if owner == player then
			return ctx.World.Houses[id]
		end
	end
	return nil
end
HousingService.HouseOf = houseOf

local function partnerPlayer(player)
	local data = ctx.Data.Get(player)
	if not data or not data.Partner then
		return nil
	end
	return Players:GetPlayerByUserId(tonumber(data.Partner))
end

-- Дом, которым игрок может пользоваться: свой или супруга(и).
local function accessibleHouse(player)
	local own = houseOf(player)
	if own then
		return own
	end
	if player:GetAttribute("RelStatus") == "married" then
		local partner = partnerPlayer(player)
		if partner then
			return houseOf(partner)
		end
	end
	return nil
end
HousingService.AccessibleHouse = accessibleHouse

local function canUse(player, house)
	return accessibleHouse(player) == house
end

local function refreshSign(house)
	local owner = owners[house.Id]
	if owner then
		local text = "Дом №" .. house.Id .. "\n" .. owner.DisplayName
		if owner:GetAttribute("RelStatus") == "married" and (owner:GetAttribute("PartnerName") or "") ~= "" then
			text = "Дом №" .. house.Id .. "\nСемья " .. owner.DisplayName .. " и " .. owner:GetAttribute("PartnerName")
		end
		house.SignLabel.Text = text
		house.SignLabel.BackgroundColor3 = Color3.fromRGB(250, 250, 240)
	else
		house.SignLabel.Text = "Дом №" .. house.Id .. "\nПРОДАЁТСЯ " .. Config.HousePrice .. "$"
		house.SignLabel.BackgroundColor3 = Color3.fromRGB(255, 230, 150)
	end
end
HousingService.RefreshSign = refreshSign

function HousingService.RefreshFor(player)
	local house = houseOf(player)
	if house then
		refreshSign(house)
	end
	player:SetAttribute("HouseId", (accessibleHouse(player) or {}).Id or 0)
	local data = ctx.Data.Get(player)
	player:SetAttribute("HasHouse", data ~= nil and data.HasHouse == true)
end

local function claimPlot(player)
	for _, house in ctx.World.Houses do
		if not owners[house.Id] then
			owners[house.Id] = player
			refreshSign(house)
			return house
		end
	end
	return nil
end

function HousingService.SpawnFor(player)
	local house = accessibleHouse(player)
	return house and house.Spawn or nil
end

function HousingService.OnPlayerAdded(player)
	local data = ctx.Data.Get(player)
	if data and data.HasHouse then
		local house = claimPlot(player)
		if not house then
			ctx.Net.Notify(player, "На этом сервере нет свободного участка для вашего дома. Ваш дом сохранён.", "warn")
		end
	end
	HousingService.RefreshFor(player)
end

function HousingService.OnPlayerRemoving(player)
	for id, owner in owners do
		if owner == player then
			owners[id] = nil
			local house = ctx.World.Houses[id]
			refreshSign(house)
			house.Door.CanCollide = true
			house.Door.Transparency = 0
		end
	end
	fridgeCooldown[player] = nil
	for _, other in Players:GetPlayers() do
		if other ~= player then
			task.defer(HousingService.RefreshFor, other)
		end
	end
end

local function openDoor(house)
	house.Door.CanCollide = false
	house.Door.Transparency = 0.7
	task.delay(4, function()
		house.Door.CanCollide = true
		house.Door.Transparency = 0
	end)
end

function HousingService.Init(c)
	ctx = c
	local MakePrompt = ctx.WorldBuilder.MakePrompt
	local Net = ctx.Net

	for _, house in ctx.World.Houses do
		refreshSign(house)
		MakePrompt(house.Door, "Открыть дверь", "Дом №" .. house.Id, 0, 8).Triggered:Connect(function(player)
			if canUse(player, house) then
				openDoor(house)
			else
				local owner = owners[house.Id]
				if owner then
					Net.Notify(player, "Вы позвонили в дверь. Хозяин(ка) получил(а) уведомление.", "info")
					Net.Send(owner, "DoorBell", { From = player.DisplayName, UserId = player.UserId, House = house.Id })
				else
					Net.Notify(player, "Этот дом продаётся за " .. Config.HousePrice .. "$. Купите его в мэрии (агентство недвижимости).", "info")
				end
			end
		end)
		local function homeAction(p, action, fn)
			MakePrompt(p, action, "", 0.3, 8).Triggered:Connect(function(player)
				if not canUse(player, house) then
					Net.Notify(player, "Это не ваш дом.", "bad")
					return
				end
				fn(player)
			end)
		end
		homeAction(house.Bed, "Спать", function(player)
			ctx.Needs.StartActivity(player, "Sleep", house.Bed, "Energy", 6, { Heal = true })
		end)
		homeAction(house.Shower, "Принять душ", function(player)
			ctx.Needs.StartActivity(player, "Shower", house.Shower, "Hygiene", 8)
		end)
		homeAction(house.TV, "Смотреть ТВ", function(player)
			ctx.Needs.StartActivity(player, "TV", house.TV, "Fun", 3)
			Net.Notify(player, "Вы смотрите телевизор. Отойдите или нажмите «Встать», чтобы закончить.", "info")
		end)
		homeAction(house.Fridge, "Перекусить", function(player)
			local last = fridgeCooldown[player]
			if last and os.clock() - last < 120 then
				Net.Notify(player, "Холодильник пуст. Загляните через " .. math.ceil(120 - (os.clock() - last)) .. " сек. или купите продукты.", "info")
				return
			end
			fridgeCooldown[player] = os.clock()
			ctx.Needs.Change(player, "Hunger", 30)
			Net.Notify(player, "Вы перекусили дома. +30 Сытость", "good")
		end)
	end

	MakePrompt(ctx.World.Desks.Realty, "Недвижимость", "Агентство", 0, 12).Triggered:Connect(function(player)
		Net.Send(player, "OpenPhone", { Tab = "Дом" })
	end)

	Net.On("BuyHouse", function(player)
		local data = ctx.Data.Get(player)
		if not data then
			return
		end
		if data.HasHouse then
			Net.Notify(player, "У вас уже есть дом.", "bad")
			return
		end
		if not Util.Near(player, ctx.World.Desks.Realty, 20) then
			Net.Notify(player, "Купить дом можно в агентстве недвижимости в мэрии.", "bad")
			return
		end
		local free = false
		for _, house in ctx.World.Houses do
			if not owners[house.Id] then
				free = true
			end
		end
		if not free then
			Net.Notify(player, "Свободных домов нет.", "bad")
			return
		end
		if not ctx.Data.Spend(player, Config.HousePrice) then
			Net.Notify(player, "Недостаточно денег. Дом стоит " .. Config.HousePrice .. "$.", "bad")
			return
		end
		data.HasHouse = true
		local house = claimPlot(player)
		HousingService.RefreshFor(player)
		local partner = partnerPlayer(player)
		if partner then
			HousingService.RefreshFor(partner)
		end
		Net.Notify(player, "Поздравляем с новосельем! Ваш дом — №" .. house.Id .. ". Он отмечен в GPS.", "good")
		Net.Send(player, "Waypoint", { Name = "Мой дом", Position = house.Spawn.Position })
	end)

	Net.On("SellHouse", function(player)
		local data = ctx.Data.Get(player)
		if not data or not data.HasHouse then
			return
		end
		data.HasHouse = false
		local refund = math.floor(Config.HousePrice * Config.HouseSellRefund)
		data.Bank += refund
		ctx.Data.SyncMoney(player)
		for id, owner in owners do
			if owner == player then
				owners[id] = nil
				refreshSign(ctx.World.Houses[id])
			end
		end
		HousingService.RefreshFor(player)
		local partner = partnerPlayer(player)
		if partner then
			HousingService.RefreshFor(partner)
		end
		Net.Notify(player, "Дом продан. На карту зачислено " .. refund .. "$.", "info")
	end)

	Net.On("GoHome", function(player)
		local house = accessibleHouse(player)
		if house then
			Net.Send(player, "Waypoint", { Name = "Мой дом", Position = house.Spawn.Position })
		else
			Net.Notify(player, "У вас нет дома.", "bad")
		end
	end)
end

return HousingService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000017"><Properties><string name="Name">JobService</string><ProtectedString name="Source"><![CDATA[-- Работы: игрок выбирает профессию, получает задания (подойти к месту,
-- выполнить действие, отнести груз) и получает зарплату за каждое задание.

local Players = game:GetService("Players")

local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Config"))
local Util = require(script.Parent.Util)

local JobService = {}
local ctx

local tasks = {} -- [Player] = { Id, Job, Stage, Target, Label, Hold, Issued }
local waiting = {} -- [Player] = { Token, Until } — пауза между заданиями
local shiftCount = {} -- [Player] = заданий в текущей смене
local nextAllowed = {} -- [Player] = os.clock(), раньше которого новое задание не выдаётся
local nextId = 0
local W = Config.Work

local function points(jobId)
	local job = Config.Jobs[jobId]
	local jp = ctx.World.JobPoints
	if job.Type == "courier" then
		local drops = {}
		for _, h in ctx.World.Houses do
			table.insert(drops, h.Doorstep)
		end
		return { jp.CourierDepot }, drops
	end
	local place = jp[job.Place]
	if job.Type == "delivery" then
		return place.Pickup, place.Drop
	end
	return place, nil
end

local function pick(list, avoid)
	if #list == 1 then
		return list[1]
	end
	local choice
	repeat
		choice = list[math.random(1, #list)]
	until choice ~= avoid
	return choice
end

function JobService.DropCarry(player)
	local char = player.Character
	local box = char and char:FindFirstChild("CarryBox")
	if box then
		box:Destroy()
	end
end

local function carry(player, color)
	JobService.DropCarry(player)
	local char = player.Character
	local hrp = Util.HRP(player)
	if not char or not hrp then
		return
	end
	local box = Instance.new("Part")
	box.Name = "CarryBox"
	box.Size = Vector3.new(2, 1.6, 1.6)
	box.Color = color
	box.Material = Enum.Material.WoodPlanks
	box.CanCollide = false
	box.Massless = true
	box.CFrame = hrp.CFrame * CFrame.new(0, 0.3, -1.6)
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = hrp
	weld.Part1 = box
	weld.Parent = box
	box.Parent = char
end

local function sendTask(player)
	local t = tasks[player]
	local w = waiting[player]
	if not t and w then
		ctx.Net.Send(player, "JobTask", { Waiting = math.max(0, w.Until - os.clock()), Reason = w.Reason })
		return
	end
	if not t then
		ctx.Net.Send(player, "JobTask", {})
		return
	end
	ctx.Net.Send(player, "JobTask", { Id = t.Id, Target = t.Target, Position = t.Target.Position, Label = t.Label, Hold = t.Hold, Job = t.Job })
end

function JobService.ResendTask(player)
	sendTask(player)
end

local function issue(player, stage, avoid)
	local jobId = player:GetAttribute("Job")
	local job = Config.Jobs[jobId]
	if not job then
		tasks[player] = nil
		sendTask(player)
		return
	end
	local a, b = points(jobId)
	nextId += 1
	local t = { Id = nextId, Job = jobId, Stage = stage, Issued = os.clock(), Hold = job.Duration }
	if stage == "drop" then
		t.Target = pick(b, avoid)
		t.Label = job.Drop
	elseif job.Type == "station" then
		t.Target = pick(a, avoid)
		t.Label = job.Action
	else
		t.Target = pick(a, avoid)
		t.Label = job.Pickup
	end
	tasks[player] = t
	sendTask(player)
end

-- Выдаёт следующее задание после паузы (новый покупатель, отдых после смены).
local function issueLater(player, delay, reason, avoid)
	if delay <= 0 then
		issue(player, "pickup", avoid)
		return
	end
	tasks[player] = nil
	local token = {}
	waiting[player] = { Token = token, Until = os.clock() + delay, Reason = reason }
	sendTask(player)
	local jobId = player:GetAttribute("Job")
	task.delay(delay, function()
		local w = waiting[player]
		if w and w.Token == token and player.Parent and player:GetAttribute("Job") == jobId then
			waiting[player] = nil
			issue(player, "pickup", avoid)
		end
	end)
end

function JobService.Quit(player, silent)
	if tasks[player] or waiting[player] or (player:GetAttribute("Job") or "") ~= "" then
		tasks[player] = nil
		waiting[player] = nil
		player:SetAttribute("Job", "")
		JobService.DropCarry(player)
		sendTask(player)
		if not silent then
			ctx.Net.Notify(player, "Вы ушли с работы.", "info")
		end
	end
end

function JobService.Select(player, jobId)
	local job = Config.Jobs[jobId]
	local role = Config.Roles[player:GetAttribute("Role") or "Citizen"]
	if not job or not role then
		return
	end
	if not table.find(role.Jobs, jobId) then
		ctx.Net.Notify(player, "Эта работа недоступна для вашей роли.", "bad")
		return
	end
	if (player:GetAttribute("Jailed") or 0) > 0 then
		ctx.Net.Notify(player, "Из тюрьмы на работу не ходят.", "bad")
		return
	end
	JobService.DropCarry(player)
	waiting[player] = nil
	player:SetAttribute("Job", jobId)
	ctx.Net.Notify(player, "Вы устроились: " .. job.Name .. ". Следуйте к отмеченной точке!", "good")
	-- Смена работы или перезаход не сбрасывают паузу и отдых между сменами.
	local data = ctx.Data.Get(player)
	local rest = data and data.WorkToday and (data.WorkToday.RestUntil or 0) - os.time() or 0
	local cooldown = (nextAllowed[player] or 0) - os.clock()
	if rest > 0 then
		issueLater(player, rest, "Перерыв между сменами")
	else
		issueLater(player, math.max(0, cooldown), job.WaitText or "Ожидайте")
	end
end

local function complete(player, t)
	local job = Config.Jobs[t.Job]
	local data = ctx.Data.Get(player)
	if not data then
		return
	end
	if job.Type ~= "station" and t.Stage == "pickup" then
		carry(player, t.Job == "cook" and Color3.fromRGB(240, 220, 180) or Color3.fromRGB(170, 130, 80))
		issue(player, "drop")
		return
	end
	JobService.DropCarry(player)
	local pay = math.floor(job.Pay * ctx.Monetization.PayMultiplier(player))
	local mood = ""
	if (player:GetAttribute("Fun") or 100) < 20 then
		pay = math.floor(pay * 0.8)
		mood = " (плохое настроение −20%)"
	end
	if (player:GetAttribute("Hygiene") or 100) < 20 then
		pay = math.floor(pay * 0.9)
		mood ..= " (неопрятный вид −10%)"
	end
	-- Дневной лимит: после него платят меньше.
	local day = math.floor(os.time() / 86400)
	if not data.WorkToday or data.WorkToday.Day ~= day then
		data.WorkToday = { Day = day, Earned = 0 }
	end
	if data.WorkToday.Earned >= W.DailyCap then
		pay = math.max(1, math.floor(pay * W.OverCapMultiplier))
		mood ..= " (дневной лимит " .. W.DailyCap .. "$ достигнут — оплата 25%)"
	end
	data.WorkToday.Earned += pay
	ctx.Data.AddCash(player, pay)
	data.Stats.TasksDone += 1
	ctx.Needs.Change(player, "Energy", -Config.WorkEnergyCost)
	ctx.Needs.Change(player, "Hunger", -0.5)
	ctx.Net.Send(player, "Earned", { Amount = pay, Text = job.Name .. mood })
	ctx.Quests.Progress(player, "work", 1)
	ctx.Quests.Progress(player, "earn", pay)
	shiftCount[player] = (shiftCount[player] or 0) + 1
	if shiftCount[player] >= W.ShiftTasks then
		shiftCount[player] = 0
		data.WorkToday.RestUntil = os.time() + W.ShiftRest
		ctx.Net.Notify(player, "Смена окончена! Отдохните " .. math.floor(W.ShiftRest / 60) .. " мин. — потом можно работать дальше.", "info")
		issueLater(player, W.ShiftRest, "Перерыв между сменами", t.Target)
	else
		nextAllowed[player] = os.clock() + (job.Cooldown or 0)
		issueLater(player, job.Cooldown or 0, job.WaitText or "Ожидайте", t.Target)
	end
end

function JobService.Init(c)
	ctx = c
	ctx.Net.On("SelectJob", function(player, p)
		if type(p.Job) == "string" then
			JobService.Select(player, p.Job)
		end
	end)
	ctx.Net.On("QuitJob", function(player)
		JobService.Quit(player)
	end)
	ctx.Net.On("JobTask", function(player, p)
		local t = tasks[player]
		if not t or p.Id ~= t.Id then
			return
		end
		if os.clock() - t.Issued < (t.Hold or 0) then
			return
		end
		if not Util.Alive(player) then
			return
		end
		if not Util.Near(player, t.Target, 16) then
			ctx.Net.Notify(player, "Подойдите ближе к месту работы.", "bad")
			return
		end
		if (player:GetAttribute("Energy") or 0) < 3 then
			ctx.Net.Notify(player, "Вы слишком устали! Выпейте кофе или поспите.", "bad")
			return
		end
		complete(player, t)
	end)
	Players.PlayerRemoving:Connect(function(player)
		tasks[player] = nil
		waiting[player] = nil
		shiftCount[player] = nil
		nextAllowed[player] = nil
	end)
end

return JobService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000018"><Properties><string name="Name">MonetizationService</string><ProtectedString name="Source"><![CDATA[-- Монетизация: Game Passes (VIP, Премиум-гараж, Свадебный пакет),
-- Developer Products (игровые деньги, салют), ежедневный бонус и бонус
-- подписчикам Roblox Premium. Бонус за регистрацию тоже выдаётся здесь.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")

local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Config"))
local Util = require(script.Parent.Util)

local MonetizationService = {}
local ctx

local M = Config.Monetization

local function passById(id)
	for key, pass in M.GamePasses do
		if pass.Id ~= 0 and pass.Id == id then
			return key
		end
	end
	return nil
end

local function productById(id)
	for key, product in M.Products do
		if product.Id ~= 0 and product.Id == id then
			return key, product
		end
	end
	return nil
end

function MonetizationService.HasPass(player, key)
	return player:GetAttribute("Pass_" .. key) == true
end

-- Множитель зарплаты: VIP ×2, Roblox Premium +10%.
function MonetizationService.PayMultiplier(player)
	local mult = 1
	if MonetizationService.HasPass(player, "VIP") then
		mult *= 2
	end
	if player.MembershipType == Enum.MembershipType.Premium then
		mult *= 1 + M.PremiumPayBonus
	end
	return mult
end

function MonetizationService.Fireworks(player)
	local hrp = Util.HRP(player)
	if not hrp then
		return
	end
	local att = Instance.new("Attachment")
	att.Position = Vector3.new(0, 6, 0)
	att.Parent = hrp
	local pe = Instance.new("ParticleEmitter")
	pe.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 80, 80)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 230, 90)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(90, 160, 255)),
	})
	pe.LightEmission = 1
	pe.Rate = 120
	pe.Lifetime = NumberRange.new(1.5, 2.5)
	pe.Speed = NumberRange.new(25, 40)
	pe.SpreadAngle = Vector2.new(60, 60)
	pe.Acceleration = Vector3.new(0, -20, 0)
	pe.Size = NumberSequence.new(0.6, 0)
	pe.Parent = att
	task.delay(6, function()
		pe.Enabled = false
		task.delay(3, function()
			att:Destroy()
		end)
	end)
end

local function applyPass(player, key)
	player:SetAttribute("Pass_" .. key, true)
	if key == "VIP" then
		ctx.Players.UpdateNameplate(player)
	end
end

local function grantPassReward(player, key)
	-- Разовые награды при покупке пасса.
	if key == "Wedding" then
		ctx.Data.AddItem(player, "ring", 1)
		ctx.Economy.SendInventory(player)
	end
end

local function checkPasses(player)
	for key, pass in M.GamePasses do
		if pass.Id ~= 0 then
			local ok, owns = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, pass.Id)
			if ok and owns then
				applyPass(player, key)
			end
		end
	end
end

local function dailyBonus(player)
	local data = ctx.Data.Get(player)
	if not data then
		return
	end
	local today = math.floor(os.time() / 86400)
	if data.LastDaily == today then
		return
	end
	local streak = (data.LastDaily == today - 1) and ((data.DailyStreak or 0) + 1) or 1
	data.LastDaily = today
	data.DailyStreak = streak
	local amount = M.DailyBonus * math.min(streak, 7)
	if MonetizationService.HasPass(player, "VIP") then
		amount *= 2
	end
	data.Bank += amount
	ctx.Data.SyncMoney(player)
	ctx.Net.Notify(player, "🎁 Ежедневный бонус: +" .. amount .. "$ (день подряд: " .. streak .. ")", "good")
end

function MonetizationService.OnPlayerAdded(player)
	local data = ctx.Data.Get(player)
	if data and not data.RegistrationBonusGiven then
		data.RegistrationBonusGiven = true
		data.Bank += Config.RegistrationBonus
		ctx.Data.SyncMoney(player)
		ctx.Net.Send(player, "Toast", { Title = "Добро пожаловать в Первоуральск!", Text = "Бонус за регистрацию: +" .. Config.RegistrationBonus .. "$ на вашу карту." })
	end
	task.spawn(function()
		checkPasses(player)
		dailyBonus(player)
	end)
end

function MonetizationService.Init(c)
	ctx = c

	MarketplaceService.ProcessReceipt = function(receipt)
		local player = Players:GetPlayerByUserId(receipt.PlayerId)
		local data = player and ctx.Data.Get(player)
		if not data then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		data.Receipts = data.Receipts or {}
		if data.Receipts[receipt.PurchaseId] then
			return Enum.ProductPurchaseDecision.PurchaseGranted
		end
		local _, product = productById(receipt.ProductId)
		if not product then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		if product.Cash then
			data.Bank += product.Cash
			ctx.Data.SyncMoney(player)
			ctx.Net.Notify(player, "Спасибо за покупку! +" .. product.Cash .. "$ на карту.", "good")
		end
		if product.Fireworks then
			MonetizationService.Fireworks(player)
			ctx.Net.NotifyAll("🎆 " .. player.DisplayName .. " запустил(а) салют над Первоуральском!", "info")
		end
		data.Receipts[receipt.PurchaseId] = true
		-- Сохраняем сразу, чтобы покупка не потерялась.
		ctx.Data.Save(player)
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		local key = passById(passId)
		if purchased and key then
			applyPass(player, key)
			grantPassReward(player, key)
			ctx.Net.Notify(player, "Спасибо! Пасс «" .. M.GamePasses[key].Name .. "» активирован.", "good")
		end
	end)

	ctx.Net.On("BuyPass", function(player, p)
		local pass = M.GamePasses[p.Key]
		if not pass then
			return
		end
		if pass.Id == 0 then
			ctx.Net.Notify(player, "Покупка ещё не настроена разработчиком (нет ID пасса).", "warn")
			return
		end
		MarketplaceService:PromptGamePassPurchase(player, pass.Id)
	end)

	ctx.Net.On("BuyProduct", function(player, p)
		local product = M.Products[p.Key]
		if not product then
			return
		end
		if product.Id == 0 then
			ctx.Net.Notify(player, "Покупка ещё не настроена разработчиком (нет ID товара).", "warn")
			return
		end
		MarketplaceService:PromptProductPurchase(player, product.Id)
	end)
end

return MonetizationService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000019"><Properties><string name="Name">NeedsService</string><ProtectedString name="Source"><![CDATA[-- Потребности как в The Sims: сытость, энергия, гигиена, настроение.
-- Со временем падают; восстанавливаются едой, сном, душем, отдыхом.

local Players = game:GetService("Players")

local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Config"))
local Util = require(script.Parent.Util)

local NeedsService = {}
local ctx

local activities = {} -- [Player] = { Kind, Token, Part }
local warned = {} -- [Player] = { [need] = true }
local spotCooldown = {} -- [Player] = { [Part] = time }

local ACTIVITY_NAMES = {
	Sleep = "Сон",
	Shower = "Душ",
	TV = "Просмотр ТВ",
}

function NeedsService.Change(player, need, delta)
	local v = player:GetAttribute(need)
	if v == nil then
		return
	end
	local nv = math.clamp(v + delta, 0, 100)
	player:SetAttribute(need, math.floor(nv * 10 + 0.5) / 10)
	if nv >= 25 and warned[player] then
		warned[player][need] = nil
	end
end

function NeedsService.ApplyEffects(player, effects)
	if not effects then
		return
	end
	for need, amount in effects do
		NeedsService.Change(player, need, amount)
	end
end

function NeedsService.UpdateSpeed(player)
	local hum = Util.Humanoid(player)
	if not hum then
		return
	end
	local speed = 16
	if (player:GetAttribute("Energy") or 100) < 15 then
		speed = 10
	end
	if player:GetAttribute("Stunned") then
		speed = 0
	end
	hum.WalkSpeed = speed
	hum.JumpPower = player:GetAttribute("Stunned") and 0 or 50
end

function NeedsService.StopActivity(player)
	local act = activities[player]
	if not act then
		return
	end
	activities[player] = nil
	player:SetAttribute("Activity", "")
	local hrp = Util.HRP(player)
	if hrp then
		hrp.Anchored = false
		if act.Part and act.Part.Parent then
			local p = act.Part
			-- Ставим персонажа рядом с объектом.
			local out = p.Position + Vector3.new(0, p.Size.Y / 2 + 3, 0) + (p.CFrame.RightVector * (p.Size.X / 2 + 3))
			player.Character:PivotTo(CFrame.new(out))
		end
	end
end

-- kind: "Sleep" | "Shower" | "TV"
function NeedsService.StartActivity(player, kind, target, need, rate, opts)
	opts = opts or {}
	if not Util.Alive(player) then
		return
	end
	if activities[player] then
		NeedsService.StopActivity(player)
	end
	if (player:GetAttribute(need) or 0) >= 99 then
		ctx.Net.Notify(player, Config.Needs[need].Name .. " и так на максимуме.", "info")
		return
	end
	local hrp = Util.HRP(player)
	local hum = Util.Humanoid(player)
	if not hrp or not hum then
		return
	end
	hum.Sit = false
	local token = {}
	activities[player] = { Kind = kind, Token = token, Part = target }
	player:SetAttribute("Activity", ACTIVITY_NAMES[kind] or kind)

	if kind == "Sleep" then
		local top = target.Position + Vector3.new(0, target.Size.Y / 2 + 1, 0)
		local along = target.Size.Z >= target.Size.X and target.CFrame.LookVector or target.CFrame.RightVector
		player.Character:PivotTo(CFrame.lookAt(top, top + Vector3.new(0, 1, 0), along))
		hrp.Anchored = true
	elseif kind == "Shower" then
		player.Character:PivotTo(CFrame.new(target.Position + Vector3.new(0, 0.5, 0)))
		hrp.Anchored = true
	end

	task.spawn(function()
		while activities[player] and activities[player].Token == token do
			task.wait(1)
			if not activities[player] or activities[player].Token ~= token then
				return
			end
			if not Util.Alive(player) or (kind == "TV" and not Util.Near(player, target, 14)) then
				break
			end
			NeedsService.Change(player, need, rate)
			if opts.Heal then
				local h = Util.Humanoid(player)
				if h then
					h.Health = math.min(h.MaxHealth, h.Health + 4)
				end
			end
			if opts.Extra then
				NeedsService.ApplyEffects(player, opts.Extra)
			end
			if (player:GetAttribute(need) or 0) >= 100 then
				ctx.Net.Notify(player, Config.Needs[need].Name .. " восстановлена!", "good")
				if kind == "Sleep" then
					ctx.Quests.Progress(player, "sleep", 1)
				elseif kind == "Shower" then
					ctx.Quests.Progress(player, "shower", 1)
				end
				break
			end
		end
		if activities[player] and activities[player].Token == token then
			NeedsService.StopActivity(player)
		end
	end)
end

function NeedsService.InActivity(player)
	return activities[player] ~= nil
end

local function onCooldown(player, p, seconds)
	spotCooldown[player] = spotCooldown[player] or {}
	local last = spotCooldown[player][p]
	if last and os.clock() - last < seconds then
		return true
	end
	spotCooldown[player][p] = os.clock()
	return false
end

local function stinkFor(player, on)
	local hrp = Util.HRP(player)
	if not hrp then
		return
	end
	local existing = hrp:FindFirstChild("Stink")
	if on and not existing then
		local pe = Instance.new("ParticleEmitter")
		pe.Name = "Stink"
		pe.Color = ColorSequence.new(Color3.fromRGB(120, 160, 60))
		pe.Rate = 4
		pe.Lifetime = NumberRange.new(1.5, 2.5)
		pe.Speed = NumberRange.new(1, 2)
		pe.Size = NumberSequence.new(1.2, 2.5)
		pe.Transparency = NumberSequence.new(0.5, 1)
		pe.Parent = hrp
	elseif not on and existing then
		existing:Destroy()
	end
end

local function tick(dt)
	local minutes = dt / 60
	for _, player in Players:GetPlayers() do
		if player:GetAttribute("RoleChosen") and Util.Alive(player) then
			local act = activities[player]
			for _, need in Config.NeedOrder do
				local info = Config.Needs[need]
				local paused = act and ((act.Kind == "Sleep" and need == "Energy") or (act.Kind == "Shower" and need == "Hygiene") or (act.Kind == "TV" and need == "Fun"))
				if not paused then
					NeedsService.Change(player, need, -info.Decay * minutes)
				end
				local v = player:GetAttribute(need) or 0
				warned[player] = warned[player] or {}
				if v < 20 and not warned[player][need] then
					warned[player][need] = true
					ctx.Net.Notify(player, "Низкий уровень: " .. info.Name .. "!", "warn")
				end
			end
			if (player:GetAttribute("Hunger") or 0) <= 0 then
				local hum = Util.Humanoid(player)
				if hum then
					hum:TakeDamage(3)
				end
			end
			stinkFor(player, (player:GetAttribute("Hygiene") or 100) < 20)
			NeedsService.UpdateSpeed(player)
		end
	end
end

function NeedsService.Init(c)
	ctx = c
	local World = ctx.World
	local MakePrompt = ctx.WorldBuilder.MakePrompt

	for _, bed in World.Beds do
		local pp = MakePrompt(bed.Part, "Лечь спать", bed.Name, 0.5, 9)
		pp.Triggered:Connect(function(player)
			NeedsService.StartActivity(player, "Sleep", bed.Part, "Energy", bed.Rate, { Heal = bed.Heal })
		end)
	end
	for _, shower in World.Showers do
		local pp = MakePrompt(shower.Part, "Принять душ", shower.Name, 0.5, 9)
		pp.Triggered:Connect(function(player)
			NeedsService.StartActivity(player, "Shower", shower.Part, "Hygiene", shower.Rate)
		end)
	end
	for _, spot in World.FunSpots do
		local pp = MakePrompt(spot.Part, spot.Text, "", spot.Hold or 0, 10)
		pp.Triggered:Connect(function(player)
			if onCooldown(player, spot.Part, spot.Cooldown or 10) then
				ctx.Net.Notify(player, "Подождите немного, прежде чем повторить.", "info")
				return
			end
			if spot.Cost and not ctx.Data.Spend(player, spot.Cost) then
				ctx.Net.Notify(player, "Недостаточно денег.", "bad")
				return
			end
			NeedsService.Change(player, spot.Need, spot.Amount)
			NeedsService.ApplyEffects(player, spot.Extra)
			ctx.Net.Notify(player, "+" .. spot.Amount .. " " .. Config.Needs[spot.Need].Name, "good")
			ctx.Quests.Progress(player, "fun", 1)
		end)
	end

	ctx.Net.On("StopActivity", function(player)
		NeedsService.StopActivity(player)
	end)

	Players.PlayerRemoving:Connect(function(player)
		activities[player] = nil
		warned[player] = nil
		spotCooldown[player] = nil
	end)

	task.spawn(function()
		while true do
			local dt = task.wait(2)
			tick(dt)
		end
	end)
end

return NeedsService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001A"><Properties><string name="Name">Net</string><ProtectedString name="Source"><![CDATA[-- Сетевой слой: одно событие «Action» (клиент → сервер) и одно «Event»
-- (сервер → клиент). Все запросы клиента проверяются на сервере.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Net = {}

local handlers = {}
local budget = {} -- [Player] = { tokens, last }
local ActionRemote, EventRemote

local MAX_TOKENS = 15
local REFILL_PER_SEC = 6

local function allow(player)
	local now = os.clock()
	local b = budget[player]
	if not b then
		b = { tokens = MAX_TOKENS, last = now }
		budget[player] = b
	end
	b.tokens = math.min(MAX_TOKENS, b.tokens + (now - b.last) * REFILL_PER_SEC)
	b.last = now
	if b.tokens < 1 then
		return false
	end
	b.tokens -= 1
	return true
end

function Net.Init()
	local folder = Instance.new("Folder")
	folder.Name = "Remotes"
	ActionRemote = Instance.new("RemoteEvent")
	ActionRemote.Name = "Action"
	ActionRemote.Parent = folder
	EventRemote = Instance.new("RemoteEvent")
	EventRemote.Name = "Event"
	EventRemote.Parent = folder
	folder.Parent = ReplicatedStorage

	ActionRemote.OnServerEvent:Connect(function(player, name, payload)
		if type(name) ~= "string" or not allow(player) then
			return
		end
		local handler = handlers[name]
		if not handler then
			return
		end
		if type(payload) ~= "table" then
			payload = {}
		end
		local ok, err = pcall(handler, player, payload)
		if not ok then
			warn("[Net] Ошибка обработки " .. name .. ": " .. tostring(err))
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		budget[player] = nil
	end)
end

function Net.On(name, fn)
	handlers[name] = fn
end

function Net.Send(player, name, payload)
	EventRemote:FireClient(player, name, payload or {})
end

function Net.Broadcast(name, payload)
	EventRemote:FireAllClients(name, payload or {})
end

function Net.Notify(player, text, kind)
	Net.Send(player, "Notify", { Text = text, Kind = kind or "info" })
end

function Net.NotifyAll(text, kind)
	Net.Broadcast("Notify", { Text = text, Kind = kind or "info" })
end

return Net
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001B"><Properties><string name="Name">NpcService</string><ProtectedString name="Source"><![CDATA[-- Сотрудники-NPC в зданиях (продавцы, медсестра, дежурный, охранник и др.)
-- и разговоры с жителями. Разговор засчитывается в задание «пообщаться».

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Rig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Rig"))

local NpcService = {}
local ctx

local TALK_COOLDOWN = 15
local lastTalk = {} -- [Player] = os.clock()

local function countTalk(player)
	local last = lastTalk[player]
	if last and os.clock() - last < TALK_COOLDOWN then
		return
	end
	lastTalk[player] = os.clock()
	ctx.Quests.Progress(player, "talk", 1)
	ctx.Needs.Change(player, "Fun", 2)
end

function NpcService.Init(c)
	ctx = c
	local folder = Instance.new("Folder")
	folder.Name = "Workers"
	folder.Parent = workspace

	for i, w in ctx.World.Workers do
		local rig = Rig.Build({ Seed = i * 7919, Role = w.Role, Name = w.Name })
		Rig.Place(rig, w.CFrame, 0)
		rig.Model.Parent = folder
		ctx.WorldBuilder.FloatLabel(rig.Parts.Head, w.Name, 2.2, Color3.fromRGB(255, 240, 180))
		local prompt = ctx.WorldBuilder.MakePrompt(rig.Parts.Torso, "Поговорить", w.Name, 0, 9)
		local lineIndex = 0
		prompt.Triggered:Connect(function(player)
			lineIndex = lineIndex % #w.Lines + 1
			ctx.Net.Broadcast("Bubble", { Character = rig.Model, Text = w.Lines[lineIndex] })
			countTalk(player)
		end)
	end

	-- Разговор с прохожим на улице (прохожие живут на клиенте).
	ctx.Net.On("TalkNPC", function(player)
		countTalk(player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		lastTalk[player] = nil
	end)
end

return NpcService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001C"><Properties><string name="Name">PlayerService</string><ProtectedString name="Source"><![CDATA[-- Вход игроков, роли (команды), точки появления, табличка над головой,
-- выдача инструментов, смерть и больница.

local Players = game:GetService("Players")
local Teams = game:GetService("Teams")

local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Config"))
local Util = require(script.Parent.Util)

local PlayerService = {}
local ctx

local lastRoleChange = {}
local pendingHospital = {}
local teams = {}

local function roleCount(role)
	local n = 0
	for _, p in Players:GetPlayers() do
		if p:GetAttribute("Role") == role then
			n += 1
		end
	end
	return n
end

local function relationLine(player)
	local status = player:GetAttribute("RelStatus") or ""
	local partner = player:GetAttribute("PartnerName") or ""
	if partner == "" then
		return nil
	end
	if status == "married" then
		return "💍 В браке с " .. partner
	elseif status == "engaged" then
		return "💎 Помолвка с " .. partner
	elseif status == "dating" then
		return "❤ Встречается с " .. partner
	end
	return nil
end

function PlayerService.UpdateNameplate(player)
	local char = player.Character
	local head = char and char:FindFirstChild("Head")
	if not head then
		return
	end
	local gui = head:FindFirstChild("Nameplate")
	if not gui then
		gui = Instance.new("BillboardGui")
		gui.Name = "Nameplate"
		gui.Size = UDim2.fromOffset(220, 78)
		gui.StudsOffset = Vector3.new(0, 2.8, 0)
		gui.MaxDistance = 70
		gui.Parent = head
		local layout = Instance.new("UIListLayout")
		layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
		layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
		layout.SortOrder = Enum.SortOrder.LayoutOrder
		layout.Parent = gui
		for i, name in { "Wanted", "NameLabel", "RoleLabel", "RelLabel" } do
			local l = Instance.new("TextLabel")
			l.Name = name
			l.LayoutOrder = i
			l.BackgroundTransparency = 1
			l.Size = UDim2.new(1, 0, 0, name == "NameLabel" and 22 or 17)
			l.Font = name == "NameLabel" and Enum.Font.GothamBold or Enum.Font.Gotham
			l.TextScaled = true
			l.TextStrokeTransparency = 0.4
			l.TextColor3 = Color3.new(1, 1, 1)
			l.Parent = gui
		end
	end
	local role = Config.Roles[player:GetAttribute("Role") or "Citizen"] or Config.Roles.Citizen
	gui.NameLabel.Text = (player:GetAttribute("Pass_VIP") and "👑 " or "") .. player.DisplayName
	gui.NameLabel.TextColor3 = player:GetAttribute("Pass_VIP") and Color3.fromRGB(255, 210, 70) or Color3.new(1, 1, 1)
	local jobId = player:GetAttribute("Job") or ""
	local job = Config.Jobs[jobId]
	gui.RoleLabel.Text = role.Name .. (job and (" • " .. job.Name) or "")
	gui.RoleLabel.TextColor3 = role.Color:Lerp(Color3.new(1, 1, 1), 0.35)
	local rel = relationLine(player)
	gui.RelLabel.Visible = rel ~= nil
	gui.RelLabel.Text = rel or ""
	gui.RelLabel.TextColor3 = Color3.fromRGB(255, 170, 200)
	local wanted = player:GetAttribute("Wanted") or 0
	local jailed = (player:GetAttribute("Jailed") or 0) > 0
	gui.Wanted.Visible = wanted > 0 or jailed
	gui.Wanted.Text = jailed and "⛓ В ТЮРЬМЕ" or Util.Stars(wanted)
	gui.Wanted.TextColor3 = Color3.fromRGB(255, 70, 70)
end

local function spawnCFrame(player)
	local World = ctx.World
	if (player:GetAttribute("Jailed") or 0) > 0 then
		return ctx.Crime.CellFor(player)
	end
	if pendingHospital[player] then
		pendingHospital[player] = nil
		return World.Spawns.Hospital
	end
	local roleId = player:GetAttribute("Role") or "Citizen"
	if roleId == "Citizen" or roleId == "Criminal" then
		local home = ctx.Housing.SpawnFor(player)
		if home then
			return home
		end
	end
	local role = Config.Roles[roleId]
	return (role and World.Spawns[role.Spawn]) or World.Spawns.CityHall
end

local function onCharacter(player, char)
	local hum = char:WaitForChild("Humanoid", 10)
	if not hum then
		return
	end
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	char:WaitForChild("HumanoidRootPart", 10)
	task.wait()
	local cf = spawnCFrame(player)
	if cf then
		pcall(function()
			player:RequestStreamAroundAsync(cf.Position, 5)
		end)
		char:PivotTo(cf)
	end
	if (player:GetAttribute("Jailed") or 0) <= 0 then
		ctx.Tools.GiveRoleTools(player)
	end
	PlayerService.UpdateNameplate(player)
	ctx.Needs.UpdateSpeed(player)

	hum.Died:Connect(function()
		pendingHospital[player] = true
		ctx.Crime.OnDeath(player)
		ctx.Needs.StopActivity(player)
		ctx.Jobs.DropCarry(player)
		if ctx.Data.Spend(player, Config.DeathHospitalBill) then
			ctx.Net.Notify(player, "Вас доставили в больницу. Счёт за лечение: " .. Config.DeathHospitalBill .. "$", "bad")
		else
			ctx.Net.Notify(player, "Вас доставили в больницу. Лечение бесплатно — у вас нет денег.", "bad")
		end
		local data = ctx.Data.Get(player)
		if data then
			player:SetAttribute("Hunger", math.max(player:GetAttribute("Hunger") or 0, 40))
			player:SetAttribute("Energy", math.max(player:GetAttribute("Energy") or 0, 40))
		end
		task.delay(Players.RespawnTime, function()
			if player.Parent and player.Character == char then
				player:LoadCharacter()
			end
		end)
	end)
end

function PlayerService.SetRole(player, roleId, force)
	local role = Config.Roles[roleId]
	if not role then
		return
	end
	local current = player:GetAttribute("Role")
	if not force then
		if current == roleId and player:GetAttribute("RoleChosen") then
			ctx.Net.Send(player, "CloseMenus")
			return
		end
		if (player:GetAttribute("Jailed") or 0) > 0 then
			ctx.Net.Notify(player, "Нельзя сменить роль, находясь в тюрьме.", "bad")
			return
		end
		if (role.CanArrest) and (player:GetAttribute("Wanted") or 0) > 0 then
			ctx.Net.Notify(player, "Разыскиваемые не могут служить в полиции!", "bad")
			return
		end
		local last = lastRoleChange[player]
		if player:GetAttribute("RoleChosen") and last and os.clock() - last < Config.RoleChangeCooldown then
			ctx.Net.Notify(player, "Сменить роль можно через " .. math.ceil(Config.RoleChangeCooldown - (os.clock() - last)) .. " сек.", "bad")
			return
		end
		if role.MaxPlayers > 0 and current ~= roleId and roleCount(roleId) >= role.MaxPlayers then
			ctx.Net.Notify(player, "Все места в роли «" .. role.Name .. "» заняты.", "bad")
			return
		end
	end
	lastRoleChange[player] = os.clock()
	ctx.Jobs.Quit(player, true)
	player:SetAttribute("Role", roleId)
	player:SetAttribute("RoleChosen", true)
	player.Team = teams[roleId]
	local data = ctx.Data.Get(player)
	if data then
		data.Role = roleId
	end
	ctx.Vehicles.DespawnFor(player, true)
	ctx.Net.Send(player, "CloseMenus")
	ctx.Net.Notify(player, "Ваша роль: " .. role.Name .. ". " .. role.Description, "good")
	player:LoadCharacter()
end

local function onPlayerAdded(player)
	local data = ctx.Data.Load(player)
	if not player.Parent then
		return
	end
	ctx.Data.SyncMoney(player)
	for _, need in Config.NeedOrder do
		player:SetAttribute(need, data.Needs[need] or 80)
	end
	local roleId = Config.Roles[data.Role] and data.Role or "Citizen"
	if Config.Roles[roleId].CanArrest and roleCount(roleId) >= Config.Roles[roleId].MaxPlayers then
		roleId = "Citizen"
	end
	player:SetAttribute("Role", roleId)
	player.Team = teams[roleId]
	player:SetAttribute("Job", "")
	player:SetAttribute("Wanted", 0)
	player:SetAttribute("Jailed", data.JailLeft or 0)
	data.JailLeft = nil
	player:SetAttribute("PartnerName", "")
	player:SetAttribute("RelStatus", "")

	ctx.Housing.OnPlayerAdded(player)
	ctx.Social.OnPlayerAdded(player)
	ctx.Monetization.OnPlayerAdded(player)
	ctx.Quests.Send(player)
	if ctx.Data.IsReadOnly(player) then
		ctx.Net.Notify(player, "Не удалось загрузить ваш прогресс. Перезайдите позже — ваши данные в безопасности, сейчас они не будут перезаписаны.", "bad")
	end

	player.AttributeChanged:Connect(function(attr)
		if attr == "Role" or attr == "Job" or attr == "Wanted" or attr == "PartnerName" or attr == "RelStatus" or attr == "Jailed" then
			PlayerService.UpdateNameplate(player)
		end
	end)
	player.CharacterAdded:Connect(function(char)
		onCharacter(player, char)
	end)

	ctx.Economy.SendInventory(player)
	ctx.Vehicles.SendCars(player)
	ctx.Net.Send(player, "OpenRoleMenu", { First = true })
	player:LoadCharacter()
end

local function onPlayerRemoving(player)
	ctx.Jobs.Quit(player, true)
	ctx.Needs.StopActivity(player)
	ctx.Vehicles.DespawnFor(player, true)
	ctx.Crime.OnPlayerRemoving(player)
	ctx.Social.OnPlayerRemoving(player)
	ctx.Housing.OnPlayerRemoving(player)
	ctx.Data.Release(player)
	lastRoleChange[player] = nil
	pendingHospital[player] = nil
end

function PlayerService.Init(c)
	ctx = c
	Players.CharacterAutoLoads = false
	for _, roleId in Config.RoleOrder do
		local role = Config.Roles[roleId]
		local team = Instance.new("Team")
		team.Name = role.Name
		team.TeamColor = BrickColor.new(role.Color)
		team.AutoAssignable = false
		team.Parent = Teams
		teams[roleId] = team
	end

	ctx.Net.On("SelectRole", function(player, p)
		if type(p.Role) == "string" then
			PlayerService.SetRole(player, p.Role, false)
		end
	end)
	ctx.Net.On("Respawn", function(player)
		local hum = Util.Humanoid(player)
		if not hum or hum.Health <= 0 then
			player:LoadCharacter()
		end
	end)

	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
end

-- Подключает уже вошедших игроков (если скрипт запустился позже).
function PlayerService.Start()
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end
end

return PlayerService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001D"><Properties><string name="Name">QuestService</string><ProtectedString name="Source"><![CDATA[-- Ежедневные задания: каждые сутки (по UTC) игрок получает новые задания,
-- прогресс сохраняется. За каждое — награда, за все — бонус дня.

local Players = game:GetService("Players")

local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Config"))
local Util = require(script.Parent.Util)

local QuestService = {}
local ctx

local Q = Config.Quests
local lastPos = {} -- [Player] = Vector3 (для задания «проехать на машине»)

local function today()
	return math.floor(os.time() / 86400)
end

local function gpsPosition(name)
	for _, place in ctx.World.GPS do
		if place.Name == name then
			return place.Position
		end
	end
	return nil
end

local function questText(q)
	local def = Q.Pool[q.Kind]
	if q.Kind == "visit" then
		return string.format(def.Text, q.Target or "?")
	end
	return string.format(def.Text, q.Goal)
end

local function generate(player, data)
	local role = player:GetAttribute("Role") or "Citizen"
	local roleKinds, common = {}, {}
	for kind, def in Q.Pool do
		if def.Role then
			if table.find(def.Role, role) then
				table.insert(roleKinds, kind)
			end
		elseif kind ~= "drive" or next(data.Cars) ~= nil or Config.Roles[role].CanArrest then
			table.insert(common, kind)
		end
	end
	local chosen = {}
	if #roleKinds > 0 then
		table.insert(chosen, roleKinds[math.random(1, #roleKinds)])
	end
	while #chosen < Q.PerDay and #common > 0 do
		table.insert(chosen, table.remove(common, math.random(1, #common)))
	end
	local list = {}
	for _, kind in chosen do
		local def = Q.Pool[kind]
		local goal = def.Goals[math.random(1, #def.Goals)]
		local q = { Kind = kind, Goal = goal, Progress = 0, Done = false }
		q.Reward = math.floor(def.Reward * goal / 10 + 0.5) * 10
		if kind == "visit" then
			local places = ctx.World.GPS
			q.Target = places[math.random(1, #places)].Name
			q.Reward = def.Reward
		end
		q.Reward = math.max(q.Reward, 100)
		table.insert(list, q)
	end
	data.Quests = { Day = today(), List = list, Bonus = false }
end

local function ensure(player)
	local data = ctx.Data.Get(player)
	if not data then
		return nil
	end
	if not data.Quests or data.Quests.Day ~= today() then
		local wasOld = data.Quests ~= nil
		generate(player, data)
		if wasOld then
			ctx.Net.Notify(player, "📅 Новый день — новые задания! Откройте телефон → «Задания».", "info")
		end
	end
	return data
end

function QuestService.Send(player)
	local data = ensure(player)
	if not data then
		return
	end
	local list, done = {}, 0
	for _, q in data.Quests.List do
		table.insert(list, { Text = questText(q), Progress = q.Progress, Goal = q.Goal, Reward = q.Reward, Done = q.Done, Kind = q.Kind })
		if q.Done then
			done += 1
		end
	end
	player:SetAttribute("QuestsDone", done)
	player:SetAttribute("QuestsTotal", #list)
	ctx.Net.Send(player, "Quests", { List = list, Bonus = Q.AllDoneBonus, BonusTaken = data.Quests.Bonus, Streak = data.DailyStreak or 0 })
end

function QuestService.Progress(player, kind, amount)
	local data = ensure(player)
	if not data then
		return
	end
	local changed = false
	for _, q in data.Quests.List do
		if q.Kind == kind and not q.Done then
			q.Progress = math.min(q.Goal, q.Progress + (amount or 1))
			changed = true
			if q.Progress >= q.Goal then
				q.Done = true
				data.Bank += q.Reward
				data.Stats.QuestsDone = (data.Stats.QuestsDone or 0) + 1
				ctx.Data.SyncMoney(player)
				ctx.Net.Send(player, "Earned", { Amount = q.Reward, Text = "Задание выполнено: " .. questText(q) })
			end
		end
	end
	if not changed then
		return
	end
	local all = true
	for _, q in data.Quests.List do
		all = all and q.Done
	end
	if all and not data.Quests.Bonus then
		data.Quests.Bonus = true
		data.Bank += Q.AllDoneBonus
		ctx.Data.SyncMoney(player)
		ctx.Net.Send(player, "Toast", { Title = "Все задания дня выполнены!", Text = "Бонус +" .. Q.AllDoneBonus .. "$. Завтра будут новые задания." })
	end
	QuestService.Send(player)
end

function QuestService.Init(c)
	ctx = c
	ctx.Net.On("GetQuests", function(player)
		QuestService.Send(player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		lastPos[player] = nil
	end)

	-- Проверка заданий «посетить место», «проехать на машине» и смены дня.
	task.spawn(function()
		local scale = (ctx.WorldBuilder.Meta and ctx.WorldBuilder.Meta.Scale) or 1
		while true do
			task.wait(2)
			for _, player in Players:GetPlayers() do
				local data = ctx.Data.Get(player)
				if data and data.Quests and player:GetAttribute("RoleChosen") then
					if data.Quests.Day ~= today() then
						QuestService.Send(player)
					end
					local pos = Util.Position(player)
					for _, q in data.Quests.List do
						if q.Kind == "visit" and not q.Done and pos then
							local target = gpsPosition(q.Target)
							if target and (pos - target).Magnitude < 40 then
								QuestService.Progress(player, "visit", 1)
							end
						end
					end
					local hum = Util.Humanoid(player)
					local seat = hum and hum.SeatPart
					if pos and seat and seat:IsA("VehicleSeat") then
						local prev = lastPos[player]
						if prev then
							local meters = (pos - prev).Magnitude / scale
							if meters > 2 and meters < 400 then
								QuestService.Progress(player, "drive", math.floor(meters))
							end
						end
						lastPos[player] = pos
					else
						lastPos[player] = nil
					end
				end
			end
		end
	end)
end

return QuestService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001E"><Properties><string name="Name">SocialService</string><ProtectedString name="Source"><![CDATA[-- Отношения между игроками: знакомство → дружба → свидания → отношения →
-- помолвка (кольцо) → свадьба в ЗАГСе → брак (общий дом). Можно расстаться
-- или развестись.

local Players = game:GetService("Players")

local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Config"))
local Util = require(script.Parent.Util)

local SocialService = {}
local ctx

local S = Config.Social
local cooldowns = {} -- [Player] = { [key] = time }
local requests = {} -- [id] = { From, To, Act, Expires }
local nextRequest = 0

local PHRASES = {
	talk = { "Привет! Как дела?", "Чем занимаешься?", "Классная погода сегодня!", "Давно тут живёшь?", "Где работаешь?" },
	joke = { "Почему программисты путают Хэллоуин и Рождество? 31 OCT = 25 DEC!", "Я на диете: ем только то, что вижу. Поэтому иду в супермаркет!", "Мой кот — лучший слушатель: никогда не перебивает." },
	compliment = { "Ты сегодня отлично выглядишь!", "С тобой так интересно!", "У тебя классный стиль!", "Ты очень добрый человек!" },
	hug = { "*обнимает*" },
	kiss = { "*целует* ❤" },
	flowers = { "Это тебе! 💐" },
	chocolate = { "Угощайся! 🍫" },
}

local function key(userId)
	return tostring(userId)
end

local function relOf(player, otherId, otherName)
	local data = ctx.Data.Get(player)
	if not data then
		return nil
	end
	local k = key(otherId)
	local r = data.Relations[k]
	if not r then
		r = { Points = 0, Status = "none", Name = otherName }
		data.Relations[k] = r
	end
	if otherName then
		r.Name = otherName
	end
	return r
end

function SocialService.SendRelations(player)
	local data = ctx.Data.Get(player)
	if not data then
		return
	end
	local list = {}
	for k, r in data.Relations do
		local online = Players:GetPlayerByUserId(tonumber(k))
		table.insert(list, { UserId = tonumber(k), Name = r.Name, Points = r.Points, Status = r.Status, Online = online ~= nil })
	end
	table.sort(list, function(a, b)
		return a.Points > b.Points
	end)
	ctx.Net.Send(player, "Relations", { List = list, Partner = data.Partner and tonumber(data.Partner) or nil })
end

local function applyPartnerAttributes(player)
	local data = ctx.Data.Get(player)
	if not data then
		return
	end
	if data.Partner then
		local r = data.Relations[data.Partner]
		player:SetAttribute("PartnerName", r and r.Name or "")
		player:SetAttribute("RelStatus", r and r.Status or "")
	else
		player:SetAttribute("PartnerName", "")
		player:SetAttribute("RelStatus", "")
	end
end

local function setPartner(data, otherKey, status)
	if status ~= "none" then
		data.Partner = otherKey
	elseif data.Partner == otherKey then
		data.Partner = nil
	end
end

-- Обновляет запись об отношениях с обеих сторон (вторая сторона может быть офлайн).
local function setPair(a, bId, bName, points, status)
	local ra = relOf(a, bId, bName)
	if not ra then
		return
	end
	ra.Points = math.clamp(points, 0, 100)
	if status then
		ra.Status = status
	end
	local dataA = ctx.Data.Get(a)
	if status then
		setPartner(dataA, key(bId), status)
	end
	local b = Players:GetPlayerByUserId(bId)
	if b then
		local rb = relOf(b, a.UserId, a.DisplayName)
		local dataB = ctx.Data.Get(b)
		if rb and dataB then
			rb.Points = ra.Points
			if status then
				rb.Status = status
				setPartner(dataB, key(a.UserId), status)
			end
		end
		applyPartnerAttributes(b)
		SocialService.SendRelations(b)
		ctx.Housing.RefreshFor(b)
	end
	applyPartnerAttributes(a)
	SocialService.SendRelations(a)
	ctx.Housing.RefreshFor(a)
end

local function bubble(player, act)
	local list = PHRASES[act]
	if list and player.Character then
		ctx.Net.Broadcast("Bubble", { Character = player.Character, Text = list[math.random(1, #list)] })
	end
end

local function hearts(player, seconds)
	local hrp = Util.HRP(player)
	if not hrp then
		return
	end
	local pe = Instance.new("ParticleEmitter")
	pe.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	pe.Color = ColorSequence.new(Color3.fromRGB(255, 90, 150))
	pe.Rate = 12
	pe.Lifetime = NumberRange.new(1, 1.5)
	pe.Speed = NumberRange.new(2, 4)
	pe.SpreadAngle = Vector2.new(30, 30)
	pe.Size = NumberSequence.new(0.6, 0)
	pe.Parent = hrp
	task.delay(seconds or 3, function()
		pe.Enabled = false
		task.delay(2, function()
			pe:Destroy()
		end)
	end)
end

local function confetti(part, seconds)
	local att = Instance.new("Attachment")
	att.Position = Vector3.new(0, 8, 0)
	att.Parent = part
	local pe = Instance.new("ParticleEmitter")
	pe.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 120, 180)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 255, 255)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 220, 90)),
	})
	pe.Rate = 80
	pe.Lifetime = NumberRange.new(2, 4)
	pe.Speed = NumberRange.new(10, 20)
	pe.SpreadAngle = Vector2.new(70, 70)
	pe.Acceleration = Vector3.new(0, -12, 0)
	pe.Size = NumberSequence.new(0.4)
	pe.Parent = att
	task.delay(seconds, function()
		pe.Enabled = false
		task.delay(5, function()
			att:Destroy()
		end)
	end)
end

local function onCooldown(player, k, seconds)
	cooldowns[player] = cooldowns[player] or {}
	local last = cooldowns[player][k]
	if last and os.clock() - last < seconds then
		return true
	end
	cooldowns[player][k] = os.clock()
	return false
end

local function atChurch(player)
	local church = ctx.World.Church
	local pos = Util.Position(player)
	return pos ~= nil and (pos - church.Center).Magnitude <= church.Radius
end

-- Применяет действие (после согласия, если оно требуется).
local function apply(a, b, actId)
	local act = S.Actions[actId]
	local ra = relOf(a, b.UserId, b.DisplayName)
	if not ra then
		return
	end
	local Net = ctx.Net
	if actId == "ask_out" then
		setPair(a, b.UserId, b.DisplayName, ra.Points + 10, "dating")
		hearts(a, 4)
		hearts(b, 4)
		Net.Notify(a, b.DisplayName .. " согласился(ась) встречаться с вами! ❤", "good")
		Net.Notify(b, "Теперь вы встречаетесь с " .. a.DisplayName .. "! ❤", "good")
		return
	elseif actId == "propose" then
		if not ctx.Data.TakeItem(a, "ring") then
			Net.Notify(a, "Кольцо пропало из инвентаря!", "bad")
			return
		end
		ctx.Economy.SendInventory(a)
		setPair(a, b.UserId, b.DisplayName, ra.Points + 10, "engaged")
		hearts(a, 6)
		hearts(b, 6)
		Net.NotifyAll("💎 " .. a.DisplayName .. " сделал(а) предложение " .. b.DisplayName .. ", и получил(а) ответ «ДА»!", "good")
		return
	elseif actId == "wedding" then
		if not (atChurch(a) and atChurch(b)) then
			Net.Notify(a, "Вы оба должны быть в ЗАГСе.", "bad")
			return
		end
		local freeWedding = ctx.Monetization.HasPass(a, "Wedding") or ctx.Monetization.HasPass(b, "Wedding")
		if not freeWedding and not ctx.Data.Spend(a, act.Cost) then
			Net.Notify(a, "Недостаточно денег на свадьбу (" .. act.Cost .. "$).", "bad")
			return
		end
		if freeWedding then
			ctx.Monetization.Fireworks(a)
			ctx.Monetization.Fireworks(b)
		end
		setPair(a, b.UserId, b.DisplayName, 100, "married")
		confetti(ctx.World.Church.Altar, 15)
		hearts(a, 10)
		hearts(b, 10)
		ctx.Needs.Change(a, "Fun", 50)
		ctx.Needs.Change(b, "Fun", 50)
		Net.NotifyAll("💒 Свадьба! " .. a.DisplayName .. " и " .. b.DisplayName .. " теперь муж и жена / супруги! Поздравляем!", "good")
		Net.Send(a, "Toast", { Title = "Свадьба!", Text = "Теперь у вас общий дом (если он есть у одного из вас)." })
		Net.Send(b, "Toast", { Title = "Свадьба!", Text = "Теперь у вас общий дом (если он есть у одного из вас)." })
		return
	elseif actId == "date" then
		if not ctx.Data.Spend(a, act.Cost) then
			Net.Notify(a, "Недостаточно денег на свидание.", "bad")
			return
		end
		ctx.Needs.Change(a, "Fun", act.Fun)
		ctx.Needs.Change(b, "Fun", act.Fun)
		ctx.Needs.Change(a, "Hunger", 25)
		ctx.Needs.Change(b, "Hunger", 25)
		hearts(a, 3)
		hearts(b, 3)
		Net.Notify(a, "Отличное свидание с " .. b.DisplayName .. "!", "good")
		Net.Notify(b, "Отличное свидание с " .. a.DisplayName .. "!", "good")
	end
	local gain = act.Points or 0
	if (a:GetAttribute("Hygiene") or 100) < 20 then
		gain = math.floor(gain / 2)
		Net.Notify(a, "От вас неприятно пахнет — отношения улучшаются медленнее. Примите душ!", "warn")
	end
	setPair(a, b.UserId, b.DisplayName, ra.Points + gain, nil)
	if gain > 0 then
		Net.Notify(a, act.Name .. ": +" .. gain .. " к отношениям с " .. b.DisplayName .. " (" .. math.floor(ra.Points) .. "/100)", "good")
	end
end

local function statusAllowed(act, status)
	if not act.RequiresStatus then
		return true
	end
	return table.find(act.RequiresStatus, status) ~= nil
end

local function handleSocial(a, p)
	local actId = p.Act
	local act = S.Actions[actId]
	local targetId = tonumber(p.Target)
	if not act or not targetId or targetId == a.UserId then
		return
	end
	local Net = ctx.Net
	local dataA = ctx.Data.Get(a)
	if not dataA then
		return
	end
	local b = Players:GetPlayerByUserId(targetId)

	-- Расставание/развод работает и когда партнёр не в сети.
	if actId == "breakup" or actId == "divorce" then
		local r = dataA.Relations[key(targetId)]
		if not r or not statusAllowed(act, r.Status) then
			return
		end
		setPair(a, targetId, r.Name, r.Points - 30, "none")
		Net.Notify(a, (actId == "divorce" and "Вы развелись с " or "Вы расстались с ") .. r.Name .. ".", "info")
		if b then
			Net.Notify(b, a.DisplayName .. (actId == "divorce" and " подал(а) на развод. Брак расторгнут." or " расстался(ась) с вами. 💔"), "bad")
		end
		return
	end

	if not b then
		Net.Notify(a, "Этого игрока нет на сервере.", "bad")
		return
	end
	if not Util.Alive(a) or not Util.Alive(b) then
		return
	end
	if act.AtChurch then
		if not (atChurch(a) and atChurch(b)) then
			Net.Notify(a, "Расписаться можно только в ЗАГСе — приходите туда вдвоём (см. GPS).", "bad")
			return
		end
	elseif Util.Distance(a, b) > S.MaxDistance then
		Net.Notify(a, "Подойдите ближе к " .. b.DisplayName .. ".", "bad")
		return
	end
	local r = relOf(a, b.UserId, b.DisplayName)
	if r.Points < act.MinPoints then
		Net.Notify(a, "Нужно больше симпатии (" .. act.MinPoints .. "+, сейчас " .. math.floor(r.Points) .. ").", "bad")
		return
	end
	if not statusAllowed(act, r.Status) then
		Net.Notify(a, "Это действие сейчас недоступно (" .. (S.StatusNames[r.Status] or r.Status) .. ").", "bad")
		return
	end
	if actId == "ask_out" then
		local dataB = ctx.Data.Get(b)
		if dataA.Partner or (dataB and dataB.Partner) then
			Net.Notify(a, "Кто-то из вас уже в отношениях.", "bad")
			return
		end
	end
	if act.Item and not ctx.Data.HasItem(a, act.Item) then
		Net.Notify(a, "Нужен предмет: " .. Config.Items[act.Item].Name .. ". Купите в цветочном киоске.", "bad")
		return
	end
	local paidByPass = actId == "wedding" and (ctx.Monetization.HasPass(a, "Wedding") or ctx.Monetization.HasPass(b, "Wedding"))
	if act.Cost and not paidByPass and ctx.Data.Total(a) < act.Cost then
		Net.Notify(a, "Нужно " .. act.Cost .. "$.", "bad")
		return
	end
	if onCooldown(a, actId .. ":" .. b.UserId, act.NeedsAccept and 15 or S.Cooldown) then
		Net.Notify(a, "Не так быстро! Подождите немного.", "info")
		return
	end

	if act.GiveMoney then
		local data = ctx.Data.Get(a)
		if data.Cash < act.GiveMoney then
			Net.Notify(a, "Нужно " .. act.GiveMoney .. "$ наличными.", "bad")
			return
		end
		ctx.Data.AddCash(a, -act.GiveMoney)
		ctx.Data.AddCash(b, act.GiveMoney)
		Net.Notify(a, "Вы передали " .. act.GiveMoney .. "$ игроку " .. b.DisplayName, "info")
		Net.Notify(b, a.DisplayName .. " передал(а) вам " .. act.GiveMoney .. "$", "good")
		setPair(a, b.UserId, b.DisplayName, r.Points + 2, nil)
		return
	end

	if act.NeedsAccept then
		nextRequest += 1
		requests[nextRequest] = { From = a, To = b, Act = actId, Expires = os.clock() + 30 }
		local texts = {
			date = a.DisplayName .. " приглашает вас на свидание!",
			ask_out = a.DisplayName .. " предлагает вам встречаться! ❤",
			propose = a.DisplayName .. " встаёт на одно колено и делает вам предложение! 💍",
			wedding = a.DisplayName .. " готов(а) сыграть свадьбу прямо сейчас! 💒",
		}
		Net.Send(b, "Request", { Id = nextRequest, From = a.DisplayName, Text = texts[actId] or act.Name })
		Net.Notify(a, "Запрос отправлен. Ждём ответа " .. b.DisplayName .. "...", "info")
		return
	end

	if act.Item then
		ctx.Data.TakeItem(a, act.Item)
		ctx.Data.AddItem(b, act.Item, 1)
		ctx.Economy.SendInventory(a)
		ctx.Economy.SendInventory(b)
		Net.Notify(b, a.DisplayName .. " подарил(а) вам: " .. Config.Items[act.Item].Name, "good")
	end
	if act.Fun then
		ctx.Needs.Change(a, "Fun", act.Fun)
		ctx.Needs.Change(b, "Fun", act.Fun)
	end
	if actId == "hug" or actId == "kiss" then
		hearts(a, 2)
		hearts(b, 2)
	end
	bubble(a, actId)
	ctx.Quests.Progress(a, "talk", 1)
	ctx.Needs.Change(a, "Fun", 2)
	ctx.Needs.Change(b, "Fun", 2)
	apply(a, b, actId)
end

function SocialService.OnPlayerAdded(player)
	local data = ctx.Data.Get(player)
	if data and data.Partner then
		local partner = Players:GetPlayerByUserId(tonumber(data.Partner))
		local pdata = partner and ctx.Data.Get(partner)
		if pdata and pdata.Partner ~= key(player.UserId) then
			-- Партнёр расстался с нами, пока мы были не в сети.
			local r = data.Relations[data.Partner]
			if r then
				r.Status = "none"
			end
			data.Partner = nil
			ctx.Net.Notify(player, "Пока вас не было, ваши отношения закончились. 💔", "bad")
		end
	end
	-- Если кто-то из онлайн-игроков считает нас партнёром, а мы его — нет.
	for _, other in Players:GetPlayers() do
		local od = other ~= player and ctx.Data.Get(other)
		if od and od.Partner == key(player.UserId) and (not data or data.Partner ~= key(other.UserId)) then
			local r = od.Relations[od.Partner]
			if r then
				r.Status = "none"
			end
			od.Partner = nil
			applyPartnerAttributes(other)
			SocialService.SendRelations(other)
		end
	end
	applyPartnerAttributes(player)
	SocialService.SendRelations(player)
	if data and data.Partner then
		local partner = Players:GetPlayerByUserId(tonumber(data.Partner))
		if partner then
			SocialService.SendRelations(partner)
			ctx.Housing.RefreshFor(partner)
			ctx.Net.Notify(partner, player.DisplayName .. " зашёл(ла) в город! ❤", "good")
		end
	end
	for _, other in Players:GetPlayers() do
		if other ~= player then
			local od = ctx.Data.Get(other)
			if od and od.Relations[key(player.UserId)] then
				SocialService.SendRelations(other)
			end
		end
	end
end

function SocialService.OnPlayerRemoving(player)
	cooldowns[player] = nil
	for id, req in requests do
		if req.From == player or req.To == player then
			requests[id] = nil
		end
	end
	task.defer(function()
		for _, other in Players:GetPlayers() do
			local od = ctx.Data.Get(other)
			if od and od.Relations[key(player.UserId)] then
				SocialService.SendRelations(other)
				ctx.Housing.RefreshFor(other)
			end
		end
	end)
end

function SocialService.Init(c)
	ctx = c
	ctx.Net.On("Social", handleSocial)
	ctx.Net.On("Respond", function(player, p)
		local req = requests[tonumber(p.Id)]
		if not req or req.To ~= player then
			return
		end
		requests[tonumber(p.Id)] = nil
		if os.clock() > req.Expires or not req.From.Parent then
			ctx.Net.Notify(player, "Запрос устарел.", "info")
			return
		end
		if p.Accept then
			apply(req.From, player, req.Act)
		else
			ctx.Net.Notify(req.From, player.DisplayName .. " отказал(а)... 💔", "bad")
			local r = relOf(req.From, player.UserId, player.DisplayName)
			if r then
				setPair(req.From, player.UserId, player.DisplayName, r.Points - 3, nil)
			end
		end
	end)
end

return SocialService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001F"><Properties><string name="Name">ToolService</string><ProtectedString name="Source"><![CDATA[-- Инструменты ролей: наручники и электрошокер (полиция/спецслужбы),
-- аптечка (медик), бита (преступник).

local Players = game:GetService("Players")

local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Config"))
local Util = require(script.Parent.Util)

local ToolService = {}
local ctx

local cooldowns = {} -- [Player] = { [toolName] = time }
local healCooldown = {} -- [target] = time
local hitMemory = {} -- [attacker] = { [victim] = time }

local TOOL_DEFS = {
	Handcuffs = { Name = "Наручники", Tip = "Арестовать разыскиваемого рядом", Color = Color3.fromRGB(180, 180, 190), Size = Vector3.new(1, 0.4, 1.6), Cooldown = 1.5, Range = 8 },
	Taser = { Name = "Электрошокер", Tip = "Обездвижить цель перед собой", Color = Color3.fromRGB(240, 220, 40), Size = Vector3.new(0.5, 1, 1.6), Cooldown = 5, Range = 25 },
	Medkit = { Name = "Аптечка", Tip = "Вылечить игрока рядом", Color = Color3.fromRGB(230, 40, 40), Size = Vector3.new(1.6, 1.2, 0.8), Cooldown = 2, Range = 8 },
	Bat = { Name = "Бита", Tip = "Ударить игрока перед собой", Color = Color3.fromRGB(150, 100, 60), Size = Vector3.new(0.5, 0.5, 4), Cooldown = 0.8, Range = 7 },
}

local function onCooldown(player, name, seconds)
	cooldowns[player] = cooldowns[player] or {}
	local last = cooldowns[player][name]
	if last and os.clock() - last < seconds then
		return true
	end
	cooldowns[player][name] = os.clock()
	return false
end

-- Ближайший живой игрок перед персонажем.
local function targetInFront(player, range, minDot)
	local hrp = Util.HRP(player)
	if not hrp then
		return nil
	end
	local best, bestDist = nil, range
	for _, other in Players:GetPlayers() do
		if other ~= player and Util.Alive(other) then
			local ohrp = Util.HRP(other)
			if ohrp then
				local offset = ohrp.Position - hrp.Position
				local dist = offset.Magnitude
				if dist <= bestDist then
					local dot = dist > 0.1 and hrp.CFrame.LookVector:Dot(offset.Unit) or 1
					if dot >= (minDot or -1) then
						best, bestDist = other, dist
					end
				end
			end
		end
	end
	return best
end

local function stun(target, seconds)
	target:SetAttribute("Stunned", true)
	ctx.Needs.UpdateSpeed(target)
	local hum = Util.Humanoid(target)
	if hum then
		hum.Sit = false
	end
	ctx.Net.Notify(target, "Вас ударило током! Вы обездвижены на " .. seconds .. " сек.", "bad")
	task.delay(seconds, function()
		if target.Parent then
			target:SetAttribute("Stunned", nil)
			ctx.Needs.UpdateSpeed(target)
		end
	end)
end

local function useTool(player, name)
	if (player:GetAttribute("Jailed") or 0) > 0 or player:GetAttribute("Stunned") then
		return
	end
	local def = TOOL_DEFS[name]
	if onCooldown(player, name, def.Cooldown) then
		return
	end
	if name == "Handcuffs" then
		local target = targetInFront(player, def.Range, -1)
		if not target then
			ctx.Net.Notify(player, "Рядом никого нет.", "info")
			return
		end
		ctx.Crime.Arrest(player, target)
	elseif name == "Taser" then
		local target = targetInFront(player, def.Range, 0.85)
		if not target then
			ctx.Net.Notify(player, "Промах!", "info")
			return
		end
		stun(target, Config.Crime.TaserStun)
		if (target:GetAttribute("Wanted") or 0) == 0 then
			ctx.Net.Notify(player, "Внимание: " .. target.DisplayName .. " не в розыске. Не злоупотребляйте шокером!", "warn")
		end
	elseif name == "Medkit" then
		local target = targetInFront(player, def.Range, -1)
		if not target then
			ctx.Net.Notify(player, "Рядом нет пациентов.", "info")
			return
		end
		local hum = Util.Humanoid(target)
		if not hum then
			return
		end
		if hum.Health >= hum.MaxHealth - 5 then
			ctx.Net.Notify(player, target.DisplayName .. " здоров(а).", "info")
			return
		end
		hum.Health = math.min(hum.MaxHealth, hum.Health + 50)
		ctx.Net.Notify(target, player.DisplayName .. " оказал(а) вам медицинскую помощь.", "good")
		local last = healCooldown[target]
		if not last or os.clock() - last > 20 then
			healCooldown[target] = os.clock()
			ctx.Data.AddCash(player, 40)
			ctx.Net.Send(player, "Earned", { Amount = 40, Text = "Лечение " .. target.DisplayName })
			ctx.Quests.Progress(player, "heal", 1)
		end
	elseif name == "Bat" then
		local target = targetInFront(player, def.Range, 0.3)
		if not target then
			return
		end
		local hum = Util.Humanoid(target)
		if not hum then
			return
		end
		ctx.Crime.TagAttack(target, player)
		hum:TakeDamage(Config.Crime.BatDamage)
		local hrp, thrp = Util.HRP(player), Util.HRP(target)
		if hrp and thrp then
			thrp.AssemblyLinearVelocity += (thrp.Position - hrp.Position).Unit * 30 + Vector3.new(0, 15, 0)
		end
		hitMemory[player] = hitMemory[player] or {}
		local last = hitMemory[player][target]
		hitMemory[player][target] = os.clock()
		if (target:GetAttribute("Wanted") or 0) == 0 and (not last or os.clock() - last > 30) then
			ctx.Crime.AddWanted(player, 1, "нападение на " .. target.DisplayName)
		end
	end
end

local function makeTool(name)
	local def = TOOL_DEFS[name]
	local tool = Instance.new("Tool")
	tool.Name = def.Name
	tool.ToolTip = def.Tip
	tool.CanBeDropped = false
	tool:SetAttribute("RoleTool", true)
	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = def.Size
	handle.Color = def.Color
	handle.Material = name == "Bat" and Enum.Material.Wood or Enum.Material.Metal
	handle.CanCollide = false
	handle.Parent = tool
	if name == "Bat" then
		tool.GripPos = Vector3.new(0, 0, 1.4)
	end
	tool.Activated:Connect(function()
		local char = tool.Parent
		local player = char and Players:GetPlayerFromCharacter(char)
		if player then
			useTool(player, name)
		end
	end)
	return tool
end

function ToolService.RemoveTools(player)
	local containers = { player:FindFirstChild("Backpack"), player.Character }
	for _, container in containers do
		if container then
			for _, item in container:GetChildren() do
				if item:IsA("Tool") and item:GetAttribute("RoleTool") then
					item:Destroy()
				end
			end
		end
	end
end

function ToolService.GiveRoleTools(player)
	ToolService.RemoveTools(player)
	local role = Config.Roles[player:GetAttribute("Role") or "Citizen"]
	local backpack = player:FindFirstChild("Backpack")
	if not role or not role.Tools or not backpack then
		return
	end
	for _, name in role.Tools do
		makeTool(name).Parent = backpack
	end
end

function ToolService.Init(c)
	ctx = c
	Players.PlayerRemoving:Connect(function(player)
		cooldowns[player] = nil
		healCooldown[player] = nil
		hitMemory[player] = nil
	end)
end

return ToolService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000020"><Properties><string name="Name">Util</string><ProtectedString name="Source"><![CDATA[local Util = {}

function Util.HRP(player)
	local char = player.Character
	return char and char:FindFirstChild("HumanoidRootPart")
end

function Util.Humanoid(player)
	local char = player.Character
	return char and char:FindFirstChildOfClass("Humanoid")
end

function Util.Alive(player)
	local hum = Util.Humanoid(player)
	return hum ~= nil and hum.Health > 0
end

function Util.Position(player)
	local hrp = Util.HRP(player)
	return hrp and hrp.Position
end

-- Находится ли игрок не дальше dist от точки/детали.
function Util.Near(player, target, dist)
	local pos = Util.Position(player)
	if not pos or not target then
		return false
	end
	local tpos = typeof(target) == "Vector3" and target or target.Position
	return (pos - tpos).Magnitude <= dist
end

function Util.Distance(a, b)
	local pa, pb = Util.Position(a), Util.Position(b)
	if not pa or not pb then
		return math.huge
	end
	return (pa - pb).Magnitude
end

-- Телепорт с подгрузкой области (StreamingEnabled), чтобы не провалиться сквозь землю.
function Util.Teleport(player, cf)
	task.spawn(function()
		pcall(function()
			player:RequestStreamAroundAsync(cf.Position, 5)
		end)
		local char = player.Character
		if char then
			char:PivotTo(cf)
		end
	end)
end

function Util.Stars(n)
	return string.rep("★", n) .. string.rep("☆", 5 - n)
end

return Util
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000021"><Properties><string name="Name">VehicleService</string><ProtectedString name="Source"><![CDATA[-- Машины: покупка в автосалоне, вызов своей машины на дорогу,
-- служебные патрульные машины. Управление — на клиенте (CarController).

local Players = game:GetService("Players")

local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Config"))
local Util = require(script.Parent.Util)

local VehicleService = {}
local ctx

local activeCars = {} -- [Player] = Model
local lastSpawn = {} -- [Player] = time

function VehicleService.SendCars(player)
	local data = ctx.Data.Get(player)
	if data then
		ctx.Net.Send(player, "Cars", { Owned = data.Cars })
	end
end

local function weld(a, b)
	local w = Instance.new("WeldConstraint")
	w.Part0 = a
	w.Part1 = b
	w.Parent = a
end

local function buildCar(carId, cf, owner)
	local def = Config.Cars[carId]
	local model = Instance.new("Model")
	model.Name = owner.Name .. "_" .. carId
	model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	model:SetAttribute("Owner", owner.UserId)
	model:SetAttribute("CarId", carId)
	model:SetAttribute("MaxSpeed", def.Speed)

	local function add(name, size, offset, props)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.CFrame = cf * offset
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		for k, v in props or {} do
			p[k] = v
		end
		p.Parent = model
		return p
	end

	local root = add("Root", Vector3.new(5.6, 0.6, 11), CFrame.new(0, 0.35, 0), {
		Transparency = 1,
		CustomPhysicalProperties = PhysicalProperties.new(3, 0, 0, 100, 1),
	})
	model.PrimaryPart = root

	local body = add("Body", Vector3.new(6.4, 1.8, 13), CFrame.new(0, 1.6, 0), { Color = def.Color, Material = Enum.Material.SmoothPlastic, CustomPhysicalProperties = PhysicalProperties.new(0.5, 0.3, 0.2) })
	local cabin = add("Cabin", Vector3.new(5.8, 3.2, 6.5), CFrame.new(0, 4.1, 1), { Color = Color3.fromRGB(40, 50, 70), Material = Enum.Material.Glass, Transparency = 0.55, CanCollide = false, Massless = true })
	local roof = add("Roof", Vector3.new(6, 0.4, 6.7), CFrame.new(0, 5.9, 1), { Color = def.Color, Massless = true })
	weld(root, body)
	weld(root, cabin)
	weld(root, roof)

	for _, x in { -3.2, 3.2 } do
		for _, z in { -4.2, 4.2 } do
			local wheel = add("Wheel", Vector3.new(1, 2.6, 2.6), CFrame.new(x, 1.3, z), { Shape = Enum.PartType.Cylinder, Color = Color3.fromRGB(25, 25, 25), CanCollide = false, Massless = true })
			weld(root, wheel)
		end
	end
	for _, x in { -2.2, 2.2 } do
		weld(root, add("Headlight", Vector3.new(1.4, 0.6, 0.2), CFrame.new(x, 1.9, -6.55), { Color = Color3.fromRGB(255, 250, 220), Material = Enum.Material.Neon, CanCollide = false, Massless = true }))
		weld(root, add("Taillight", Vector3.new(1.4, 0.6, 0.2), CFrame.new(x, 1.9, 6.55), { Color = Color3.fromRGB(220, 20, 20), Material = Enum.Material.Neon, CanCollide = false, Massless = true }))
	end
	local lamp = model:FindFirstChild("Headlight")
	if lamp then
		local spot = Instance.new("SpotLight")
		spot.Range = 40
		spot.Angle = 60
		spot.Face = Enum.NormalId.Front
		spot.Brightness = 3
		spot.Parent = lamp
	end

	if def.Police then
		local red = add("LightRed", Vector3.new(2, 0.5, 1), CFrame.new(-1.2, 6.35, 1), { Color = Color3.fromRGB(255, 0, 0), Material = Enum.Material.Neon, CanCollide = false, Massless = true })
		local blue = add("LightBlue", Vector3.new(2, 0.5, 1), CFrame.new(1.2, 6.35, 1), { Color = Color3.fromRGB(0, 80, 255), Material = Enum.Material.Neon, CanCollide = false, Massless = true })
		weld(root, red)
		weld(root, blue)
		for _, face in { Enum.NormalId.Left, Enum.NormalId.Right } do
			ctx.WorldBuilder.SurfaceText(body, face, "ПОЛИЦИЯ", Color3.fromRGB(240, 240, 255), Color3.fromRGB(20, 40, 160))
		end
		task.spawn(function()
			local on = true
			while model.Parent do
				red.Transparency = on and 0 or 0.8
				blue.Transparency = on and 0.8 or 0
				on = not on
				task.wait(0.4)
			end
		end)
	end

	local seat = Instance.new("VehicleSeat")
	seat.Name = "DriverSeat"
	seat.Size = Vector3.new(2, 0.6, 2)
	seat.CFrame = cf * CFrame.new(-1.3, 2.8, 1.5)
	seat.Transparency = 1
	seat.MaxSpeed = def.Speed
	seat.Torque = 0
	seat.Massless = true
	seat:SetAttribute("LifeCar", true)
	seat.Parent = model
	weld(root, seat)
	for i, pos in { Vector3.new(1.3, 2.8, 1.5), Vector3.new(-1.3, 2.8, 4), Vector3.new(1.3, 2.8, 4) } do
		local s = Instance.new("Seat")
		s.Name = "Passenger" .. i
		s.Size = Vector3.new(2, 0.6, 2)
		s.CFrame = cf * CFrame.new(pos)
		s.Transparency = 1
		s.Massless = true
		s.Parent = model
		weld(root, s)
	end

	-- Физика движения: клиент водителя меняет скорость этих ограничителей.
	local att = Instance.new("Attachment")
	att.Name = "DriveAttachment"
	att.Parent = root
	local lv = Instance.new("LinearVelocity")
	lv.Name = "Drive"
	lv.Attachment0 = att
	lv.RelativeTo = Enum.ActuatorRelativeTo.World
	lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
	lv.ForceLimitMode = Enum.ForceLimitMode.PerAxis
	lv.VectorVelocity = Vector3.zero
	lv.Parent = root
	local av = Instance.new("AngularVelocity")
	av.Name = "Steer"
	av.Attachment0 = att
	av.RelativeTo = Enum.ActuatorRelativeTo.World
	av.AngularVelocity = Vector3.zero
	av.Parent = root

	model.Parent = ctx.World.CarFolder
	local mass = root.AssemblyMass
	lv.MaxAxesForce = Vector3.new(mass * 120, 0, mass * 120)
	av.MaxTorque = mass * 400

	seat:GetPropertyChangedSignal("Occupant"):Connect(function()
		local hum = seat.Occupant
		local driver = hum and Players:GetPlayerFromCharacter(hum.Parent)
		if driver then
			local allowed = driver == owner
			if not allowed and def.Police then
				allowed = ctx.Crime.IsLaw(driver)
			end
			if not allowed and not def.Police then
				local data = ctx.Data.Get(owner)
				allowed = data ~= nil and data.Partner == tostring(driver.UserId)
			end
			if not allowed and driver:GetAttribute("Role") == "Criminal" then
				allowed = true
				ctx.Crime.AddWanted(driver, def.Police and 3 or 1, "угон автомобиля")
				if owner.Parent then
					ctx.Net.Notify(owner, "🚨 Вашу машину угоняет " .. driver.DisplayName .. "!", "bad")
				end
			end
			if not allowed then
				task.defer(function()
					hum.Sit = false
					hum.Jump = true
				end)
				ctx.Net.Notify(driver, "Это чужая машина.", "bad")
				return
			end
			pcall(function()
				root:SetNetworkOwner(driver)
			end)
		else
			pcall(function()
				root:SetNetworkOwnershipAuto()
			end)
		end
	end)
	return model
end

function VehicleService.DespawnFor(player, silent)
	local car = activeCars[player]
	if car then
		activeCars[player] = nil
		car:Destroy()
		if not silent then
			ctx.Net.Notify(player, "Машина отправлена на парковку.", "info")
		end
	end
end

local function freeSpawnNear(pos)
	local best, bestDist = nil, math.huge
	for _, cf in ctx.World.CarSpawns do
		local d = (cf.Position - pos).Magnitude
		if d < bestDist then
			local blocked = false
			for _, car in ctx.World.CarFolder:GetChildren() do
				if car.PrimaryPart and (car.PrimaryPart.Position - cf.Position).Magnitude < 14 then
					blocked = true
					break
				end
			end
			if not blocked then
				best, bestDist = cf, d
			end
		end
	end
	return best
end

local function spawnCar(player, carId, cf)
	if lastSpawn[player] and os.clock() - lastSpawn[player] < 5 then
		ctx.Net.Notify(player, "Подождите пару секунд.", "info")
		return
	end
	lastSpawn[player] = os.clock()
	VehicleService.DespawnFor(player, true)
	local car = buildCar(carId, cf, player)
	activeCars[player] = car
	ctx.Net.Notify(player, Config.Cars[carId].Name .. " ждёт вас! Сядьте за руль (W/S — газ/тормоз, A/D — поворот).", "good")
	ctx.Net.Send(player, "Waypoint", { Name = "Моя машина", Position = cf.Position })
end

function VehicleService.Init(c)
	ctx = c
	local MakePrompt = ctx.WorldBuilder.MakePrompt
	local Net = ctx.Net

	MakePrompt(ctx.World.Dealership, "Каталог", "Автосалон", 0, 12).Triggered:Connect(function(player)
		Net.Send(player, "OpenDealer", {})
	end)

	MakePrompt(ctx.World.PoliceCarKiosk, "Взять патрульную машину", "Гараж", 0.5, 10).Triggered:Connect(function(player)
		if not ctx.Crime.IsLaw(player) then
			Net.Notify(player, "Только для сотрудников полиции и спецслужб.", "bad")
			return
		end
		spawnCar(player, "police", ctx.World.PoliceCarSpawn)
	end)

	Net.On("BuyCar", function(player, p)
		local def = Config.Cars[p.Car]
		local data = ctx.Data.Get(player)
		if not def or def.Hidden or def.Pass or not data then
			return
		end
		if data.Cars[p.Car] then
			Net.Notify(player, "У вас уже есть эта машина.", "info")
			return
		end
		if not Util.Near(player, ctx.World.Dealership, 25) then
			Net.Notify(player, "Покупка машин — в автосалоне.", "bad")
			return
		end
		if not ctx.Data.Spend(player, def.Price) then
			Net.Notify(player, "Недостаточно денег (" .. def.Price .. "$).", "bad")
			return
		end
		data.Cars[p.Car] = true
		Net.Notify(player, "Поздравляем с покупкой: " .. def.Name .. "! Вызвать машину можно в телефоне.", "good")
		VehicleService.SendCars(player)
	end)

	Net.On("SpawnCar", function(player, p)
		local data = ctx.Data.Get(player)
		local def = Config.Cars[p.Car]
		if not data or not def then
			return
		end
		local owned = data.Cars[p.Car] or (def.Pass and ctx.Monetization.HasPass(player, def.Pass))
		if not owned then
			if def.Pass then
				Net.Notify(player, "Эта машина доступна с пассом «" .. Config.Monetization.GamePasses[def.Pass].Name .. "».", "info")
			end
			return
		end
		if (player:GetAttribute("Jailed") or 0) > 0 then
			return
		end
		local pos = Util.Position(player)
		if not pos then
			return
		end
		local cf = freeSpawnNear(pos)
		if not cf then
			Net.Notify(player, "Нет свободного места на дороге.", "bad")
			return
		end
		spawnCar(player, p.Car, cf)
	end)

	Net.On("DespawnCar", function(player)
		VehicleService.DespawnFor(player, false)
	end)

	Players.PlayerRemoving:Connect(function(player)
		lastSpawn[player] = nil
	end)
end

return VehicleService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000022"><Properties><string name="Name">WorldBuilder</string><ProtectedString name="Source"><![CDATA[-- Строит город Первоуральск при запуске сервера: реальные улицы и здания
-- из открытых данных OpenStreetMap (src/server/Map, генерирует
-- tools/pervouralsk/convert.py) + игровые здания с интерьерами
-- (мэрия, ОМВД, больница, банк, офис, супермаркет, кафе, автосалон, завод,
-- ЗАГС, парк, тюрьма, дома игроков) на местах реальных объектов.
-- Возвращает реестр важных точек (World), который используют остальные сервисы.

local Lighting = game:GetService("Lighting")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local WorldBuilder = {}

local World = {
	Spawns = {},
	Shops = {},
	ATMs = {},
	Beds = {},
	Showers = {},
	FunSpots = {},
	JobPoints = {},
	Houses = {},
	Robbery = {},
	GPS = {},
	CarSpawns = {},
	Desks = {},
	Workers = {}, -- сотрудники-NPC: { CFrame, Role, Name, Lines }
}
WorldBuilder.World = World

local City

local function part(props)
	local p = Instance.new(props.ClassName or "Part")
	props.ClassName = nil
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	local parent = props.Parent
	props.Parent = nil
	if typeof(props.Position) == "CFrame" then
		props.CFrame = props.Position
		props.Position = nil
	end
	for k, v in props do
		p[k] = v
	end
	p.Parent = parent or City
	return p
end
WorldBuilder.Part = part

function WorldBuilder.MakePrompt(parent, action, object, hold, dist)
	local pp = Instance.new("ProximityPrompt")
	pp.ActionText = action
	pp.ObjectText = object or ""
	pp.HoldDuration = hold or 0
	pp.MaxActivationDistance = dist or 10
	pp.RequiresLineOfSight = false
	pp.Parent = parent
	return pp
end

local function surfaceText(target, face, text, bg, fg)
	local sg = Instance.new("SurfaceGui")
	sg.Face = face
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 25
	sg.Parent = target
	local tl = Instance.new("TextLabel")
	tl.Size = UDim2.fromScale(1, 1)
	tl.BackgroundColor3 = bg or Color3.fromRGB(30, 30, 40)
	tl.TextColor3 = fg or Color3.new(1, 1, 1)
	tl.TextScaled = true
	tl.Font = Enum.Font.GothamBold
	tl.Text = text
	tl.Parent = sg
	return tl
end
WorldBuilder.SurfaceText = surfaceText

local function floatLabel(target, text, offsetY, color)
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(200, 40)
	bb.StudsOffset = Vector3.new(0, offsetY or 3, 0)
	bb.MaxDistance = 45
	bb.AlwaysOnTop = false
	bb.Parent = target
	local tl = Instance.new("TextLabel")
	tl.Size = UDim2.fromScale(1, 1)
	tl.BackgroundTransparency = 1
	tl.TextColor3 = color or Color3.new(1, 1, 1)
	tl.TextStrokeTransparency = 0.3
	tl.TextScaled = true
	tl.Font = Enum.Font.GothamBold
	tl.Text = text
	tl.Parent = bb
	return tl
end
WorldBuilder.FloatLabel = floatLabel

local function addGPS(name, pos)
	if typeof(pos) == "CFrame" then
		pos = pos.Position
	end
	table.insert(World.GPS, { Name = name, Position = pos })
end

-- Строит коробку здания с дверным проёмом спереди.
-- s = +1 — фасад смотрит в сторону +Z, s = -1 — в сторону -Z.
-- Возвращает модель и функцию at(lx, ly, lz) для локальных координат
-- (lz > 0 — ближе к фасаду).
local function building(o)
	local m = Instance.new("Model")
	m.Name = o.Name
	m.Parent = City
	local cx, cz, w, d, h = o.X, o.Z, o.W, o.D, o.H
	local color = o.Color or Color3.fromRGB(200, 200, 200)
	local mat = o.Material or Enum.Material.Concrete
	local t = 1
	local doorW = o.DoorW or 10
	local doorH = 12

	-- Локальная система здания: +Z — фасад (дверь), поворот Yaw в градусах.
	local base = CFrame.new(cx, 0, cz) * CFrame.Angles(0, math.rad(o.Yaw or 0), 0)
	local function at(lx, ly, lz)
		return base * CFrame.new(lx, ly, lz)
	end

	part({ Parent = m, Name = "Floor", Size = Vector3.new(w, 0.4, d), Position = at(0, 0.2, 0), Color = o.FloorColor or Color3.fromRGB(170, 160, 150), Material = Enum.Material.WoodPlanks })
	part({ Parent = m, Name = "Back", Size = Vector3.new(w, h, t), Position = at(0, h / 2, -d / 2 + t / 2), Color = color, Material = mat })
	part({ Parent = m, Name = "Left", Size = Vector3.new(t, h, d), Position = at(-w / 2 + t / 2, h / 2, 0), Color = color, Material = mat })
	part({ Parent = m, Name = "Right", Size = Vector3.new(t, h, d), Position = at(w / 2 - t / 2, h / 2, 0), Color = color, Material = mat })
	local sideW = (w - doorW) / 2
	part({ Parent = m, Name = "FrontL", Size = Vector3.new(sideW, h, t), Position = at(-(doorW / 2 + sideW / 2), h / 2, d / 2 - t / 2), Color = color, Material = mat })
	part({ Parent = m, Name = "FrontR", Size = Vector3.new(sideW, h, t), Position = at(doorW / 2 + sideW / 2, h / 2, d / 2 - t / 2), Color = color, Material = mat })
	if h > doorH then
		part({ Parent = m, Name = "Lintel", Size = Vector3.new(doorW, h - doorH, t), Position = at(0, doorH + (h - doorH) / 2, d / 2 - t / 2), Color = color, Material = mat })
	end
	part({ Parent = m, Name = "Roof", Size = Vector3.new(w + 2, 1, d + 2), Position = at(0, h + 0.5, 0), Color = o.RoofColor or Color3.fromRGB(70, 70, 80), Material = Enum.Material.Slate })

	-- Окна на фасаде и сзади.
	local glass = Color3.fromRGB(150, 200, 240)
	local winY = math.min(h * 0.55, h - 3)
	for _, side in { -1, 1 } do
		local wx = side * (doorW / 2 + sideW / 2)
		if sideW > 6 then
			part({ Parent = m, Name = "Window", Size = Vector3.new(math.min(sideW - 4, 12), 5, 0.3), Position = at(wx, winY, d / 2 + 0.2), Color = glass, Material = Enum.Material.Glass, Transparency = 0.3, CanCollide = false })
		end
		part({ Parent = m, Name = "Window", Size = Vector3.new(math.min(w / 3, 14), 5, 0.3), Position = at(side * w / 4, winY, -d / 2 - 0.2), Color = glass, Material = Enum.Material.Glass, Transparency = 0.3, CanCollide = false })
	end
	-- Многоэтажные окна для высоких зданий.
	if h >= 30 then
		for y = 8, h - 6, 8 do
			for _, side in { -1, 1 } do
				part({ Parent = m, Name = "SideWindow", Size = Vector3.new(0.3, 4, d - 8), Position = at(side * (w / 2 + 0.2), y, 0), Color = glass, Material = Enum.Material.Glass, Transparency = 0.2, CanCollide = false })
			end
		end
	end

	-- Вывеска.
	if o.Sign then
		local signPart = part({ Parent = m, Name = "Sign", Size = Vector3.new(math.min(w * 0.7, 40), 4, 0.5), Position = at(0, h - 2.5, d / 2 + 0.6), Color = Color3.fromRGB(30, 30, 40), CanCollide = false })
		surfaceText(signPart, Enum.NormalId.Back, o.Sign, o.SignColor or Color3.fromRGB(30, 30, 40), Color3.new(1, 1, 1))
	end

	-- Освещение внутри.
	local lamp = part({ Parent = m, Name = "Lamp", Size = Vector3.new(4, 0.4, 4), Position = at(0, h - 0.3, 0), Color = Color3.fromRGB(255, 250, 220), Material = Enum.Material.Neon, CanCollide = false })
	local light = Instance.new("PointLight")
	light.Range = math.max(w, d) * 0.7
	light.Brightness = 1.2
	light.Parent = lamp

	-- Козырёк над входом и фонари по бокам двери.
	part({ Parent = m, Name = "EntranceCanopy", Size = Vector3.new(doorW + 4, 0.5, 4), CFrame = at(0, doorH + 0.6, d / 2 + 2), Color = o.RoofColor or Color3.fromRGB(70, 70, 80), Material = Enum.Material.Metal })
	for _, side in { -1, 1 } do
		local wl = part({ Parent = m, Name = "WallLamp", Size = Vector3.new(0.8, 1.4, 0.6), CFrame = at(side * (doorW / 2 + 1.5), doorH - 2, d / 2 + 0.4), Color = Color3.fromRGB(255, 235, 190), Material = Enum.Material.Neon, CanCollide = false })
		local pl = Instance.new("PointLight")
		pl.Range = 14
		pl.Brightness = 0.8
		pl.Color = Color3.fromRGB(255, 220, 170)
		pl.Parent = wl
	end

	-- Дорожка от двери к дороге.
	if o.Path then
		part({ Parent = m, Name = "Path", Size = Vector3.new(doorW, 0.3, o.Path), Position = at(0, 0.15, d / 2 + o.Path / 2), Color = Color3.fromRGB(180, 180, 175), Material = Enum.Material.Concrete })
	end

	addGPS(o.GPSName or o.Name, at(0, 3, d / 2 + 6))
	return m, at
end

local function worker(cf, role, name, lines)
	table.insert(World.Workers, { CFrame = cf, Role = role, Name = name, Lines = lines })
end
-- Сотрудник за стойкой: стоит в точке (lx, lz) здания лицом к входу (+Z).
local function staff(at, lx, lz, role, name, lines)
	worker(at(lx, 0.4, lz) * CFrame.Angles(0, math.rad(180), 0), role, name, lines)
end

local function counter(parent, pos, size, color)
	return part({ Parent = parent, Name = "Counter", Size = size or Vector3.new(10, 3.5, 3), Position = pos, Color = color or Color3.fromRGB(120, 80, 50), Material = Enum.Material.Wood })
end

local function interactable(parent, name, pos, size, color, label, material)
	local p = part({ Parent = parent, Name = name, Size = size or Vector3.new(3, 3, 3), Position = pos, Color = color or Color3.fromRGB(200, 200, 200), Material = material or Enum.Material.SmoothPlastic })
	if label then
		floatLabel(p, label, 3, Color3.fromRGB(255, 255, 200))
	end
	return p
end

-- Деревья трёх видов, как на Урале: лиственные, ели и берёзы.
local function tree(pos)
	local kind = (math.floor(pos.X * 7 + pos.Z * 13) % 3)
	if kind == 0 then
		-- Ель: ствол и три яруса хвои.
		part({ Name = "Trunk", Size = Vector3.new(1.4, 6, 1.4), Position = pos + Vector3.new(0, 3, 0), Color = Color3.fromRGB(90, 60, 40), Material = Enum.Material.Wood })
		local green = Color3.fromRGB(35, 85 + math.random(0, 25), 45)
		for i, r in { 10, 7.5, 4.5 } do
			local l = part({ Name = "Leaves", Shape = Enum.PartType.Cylinder, Size = Vector3.new(4.5, r, r), CFrame = CFrame.new(pos + Vector3.new(0, 4 + i * 3.6, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = green, Material = Enum.Material.Grass })
			l.CanCollide = false
		end
		local tip = part({ Name = "Leaves", Shape = Enum.PartType.Ball, Size = Vector3.new(2.6, 2.6, 2.6), Position = pos + Vector3.new(0, 17.5, 0), Color = green, Material = Enum.Material.Grass })
		tip.CanCollide = false
	elseif kind == 1 then
		-- Берёза: белый ствол, светлая крона.
		part({ Name = "Trunk", Size = Vector3.new(1.2, 12, 1.2), Position = pos + Vector3.new(0, 6, 0), Color = Color3.fromRGB(235, 232, 225), Material = Enum.Material.SmoothPlastic })
		part({ Name = "TrunkMark", Size = Vector3.new(1.25, 0.5, 1.25), Position = pos + Vector3.new(0, 4.5, 0), Color = Color3.fromRGB(40, 40, 40), CanCollide = false })
		for _, off in { Vector3.new(0, 13, 0), Vector3.new(1.5, 15.5, 0.8) } do
			local l = part({ Name = "Leaves", Shape = Enum.PartType.Ball, Size = Vector3.new(7, 7, 7), Position = pos + off, Color = Color3.fromRGB(120, 175 + math.random(0, 25), 70), Material = Enum.Material.Grass })
			l.CanCollide = false
		end
	else
		-- Лиственное дерево с пышной кроной.
		part({ Name = "Trunk", Size = Vector3.new(2, 9, 2), Position = pos + Vector3.new(0, 4.5, 0), Color = Color3.fromRGB(100, 70, 40), Material = Enum.Material.Wood })
		local green = Color3.fromRGB(60, 135 + math.random(0, 40), 55)
		for _, off in { Vector3.new(0, 12, 0), Vector3.new(2.5, 10.5, 1), Vector3.new(-2, 11, -1.5) } do
			local l = part({ Name = "Leaves", Shape = Enum.PartType.Ball, Size = Vector3.new(8, 8, 8), Position = pos + off, Color = green, Material = Enum.Material.Grass })
			l.CanCollide = false
		end
	end
end

local function bench(pos, facingZ)
	local m = Instance.new("Model")
	m.Name = "Bench"
	m.Parent = City
	local cf = typeof(pos) == "CFrame" and pos or CFrame.new(pos)
	local seat = part({ Parent = m, Name = "Seat", Size = Vector3.new(7, 0.6, 2.5), CFrame = cf * CFrame.new(0, 1.6, 0), Color = Color3.fromRGB(140, 90, 50), Material = Enum.Material.Wood })
	part({ Parent = m, Name = "BackRest", Size = Vector3.new(7, 2.5, 0.4), CFrame = cf * CFrame.new(0, 3, -facingZ * 1.1), Color = Color3.fromRGB(140, 90, 50), Material = Enum.Material.Wood })
	return seat
end

local function streetLamp(pos)
	part({ Name = "LampBase", Size = Vector3.new(1.4, 1.2, 1.4), Position = pos + Vector3.new(0, 0.6, 0), Color = Color3.fromRGB(45, 45, 50), Material = Enum.Material.Metal })
	part({ Name = "LampPost", Size = Vector3.new(0.7, 17, 0.7), Position = pos + Vector3.new(0, 8.5, 0), Color = Color3.fromRGB(55, 55, 60), Material = Enum.Material.Metal })
	part({ Name = "LampArm", Size = Vector3.new(4, 0.4, 0.4), Position = pos + Vector3.new(1.8, 16.8, 0), Color = Color3.fromRGB(55, 55, 60), Material = Enum.Material.Metal })
	part({ Name = "LampHood", Size = Vector3.new(2.6, 0.6, 1.6), Position = pos + Vector3.new(3.6, 16.7, 0), Color = Color3.fromRGB(55, 55, 60), Material = Enum.Material.Metal })
	local bulb = part({ Name = "LampBulb", Size = Vector3.new(2.2, 0.3, 1.2), Position = pos + Vector3.new(3.6, 16.3, 0), Color = Color3.fromRGB(255, 240, 200), Material = Enum.Material.Neon, CanCollide = false })
	local l = Instance.new("PointLight")
	l.Range = 35
	l.Brightness = 1.5
	l.Color = Color3.fromRGB(255, 225, 170)
	l.Parent = bulb
end

---------------------------------------------------------------------------
-- Карта Первоуральска (данные © участники OpenStreetMap, ODbL)
---------------------------------------------------------------------------
local MapFolder = script.Parent.Parent:WaitForChild("Map")
local Meta = require(MapFolder:WaitForChild("Meta"))
WorldBuilder.Meta = Meta

-- Перебирает записи вида "a,b,c;a,b,c" из модулей-чанков.
local function records(kind)
	local out = {}
	for _, name in Meta.Chunks[kind] or {} do
		local data = require(MapFolder:WaitForChild(name))
		for rec in string.gmatch(data, "[^;]+") do
			local fields = string.split(rec, ",")
			table.insert(out, fields)
		end
	end
	return out
end

local ASPHALT = Color3.fromRGB(52, 52, 58)
local BUILDING_COLORS = {
	Color3.fromRGB(205, 200, 190), Color3.fromRGB(220, 210, 185), Color3.fromRGB(185, 175, 165),
	Color3.fromRGB(225, 215, 200), Color3.fromRGB(190, 195, 200), Color3.fromRGB(170, 120, 90),
	Color3.fromRGB(200, 170, 130), Color3.fromRGB(150, 160, 120), Color3.fromRGB(180, 140, 110),
	Color3.fromRGB(140, 135, 140),
}

local yieldCounter = 0
local function maybeYield()
	yieldCounter += 1
	if yieldCounter % 400 == 0 then
		task.wait()
	end
end

local function buildTerrain()
	-- Земля из ровных плит (рельеф Terrain перекрывал дороги).
	local b = Meta.Bounds
	local margin = 300
	local x0, x1 = b.MinX - margin, b.MaxX + margin
	local z0, z1 = b.MinZ - margin, b.MaxZ + margin
	local tile = 2000
	local ground = Instance.new("Folder")
	ground.Name = "Ground"
	ground.Parent = City
	for x = x0, x1, tile do
		for z = z0, z1, tile do
			local sx, sz = math.min(tile, x1 - x), math.min(tile, z1 - z)
			part({ Parent = ground, Name = "Ground", Size = Vector3.new(sx, 2, sz), Position = Vector3.new(x + sx / 2, -1, z + sz / 2), Color = Color3.fromRGB(104, 158, 82), Material = Enum.Material.Grass })
		end
	end
	for _, r in records("Parks") do
		part({ Parent = ground, Name = "Park", Size = Vector3.new(tonumber(r[3]), 0.2, tonumber(r[4])), Position = Vector3.new(tonumber(r[1]), -0.05, tonumber(r[2])), Color = Color3.fromRGB(78, 145, 62), Material = Enum.Material.Grass })
	end
	for _, r in records("Water") do
		part({ Parent = ground, Name = "Water", Size = Vector3.new(tonumber(r[3]), 0.3, tonumber(r[4])), Position = Vector3.new(tonumber(r[1]), -0.05, tonumber(r[2])), Color = Color3.fromRGB(62, 120, 180), Material = Enum.Material.Glass, Transparency = 0.1, Reflectance = 0.15, CanCollide = false })
	end
	-- Невидимые стены по краю карты.
	local cx, cz = (b.MinX + b.MaxX) / 2, (b.MinZ + b.MaxZ) / 2
	local w, d = b.MaxX - b.MinX, b.MaxZ - b.MinZ
	for _, wall in { { cx, b.MinZ, w, 2 }, { cx, b.MaxZ, w, 2 }, { b.MinX, cz, 2, d }, { b.MaxX, cz, 2, d } } do
		local sx, sz = wall[3], wall[4]
		-- Деталь не может быть длиннее 2048 studs — режем на куски.
		local n = math.ceil(math.max(sx, sz) / 2000)
		for i = 1, n do
			local t = (i - 0.5) / n - 0.5
			local px = wall[1] + (sx > sz and t * sx or 0)
			local pz = wall[2] + (sz > sx and t * sz or 0)
			part({ Name = "Border", Size = Vector3.new(sx > sz and sx / n or sx, 300, sz > sx and sz / n or sz), Position = Vector3.new(px, 150, pz), Transparency = 1 })
		end
	end
end

local SIDEWALK = Color3.fromRGB(176, 174, 168)
local NO_SIDEWALK = { service = true, pedestrian = true, rail = true }

local function buildRoads()
	local classes = Meta.RoadClasses
	local folder = Instance.new("Folder")
	folder.Name = "Roads"
	folder.Parent = City
	-- Проезжая часть: верх на высоте 0.3, тротуар под ней шире на 5 studs с каждой стороны.
	local ROAD_TOP, WALK_TOP = 0.3, 0.2
	for _, r in records("Roads") do
		local x1, z1, x2, z2 = tonumber(r[1]), tonumber(r[2]), tonumber(r[3]), tonumber(r[4])
		local w = tonumber(r[5])
		local cls = classes[tonumber(r[6])]
		local a, b = Vector3.new(x1, 0, z1), Vector3.new(x2, 0, z2)
		local len = (b - a).Magnitude
		local cf = CFrame.lookAt((a + b) / 2, b)
		if cls == "rail" then
			part({ Parent = folder, Name = "RailBed", Size = Vector3.new(w, 0.6, len + 0.2), CFrame = cf + Vector3.new(0, 0.1, 0), Color = Color3.fromRGB(110, 98, 86), Material = Enum.Material.Slate })
			for _, off in { -2.4, 2.4 } do
				part({ Parent = folder, Name = "Rail", Size = Vector3.new(0.4, 0.4, len), CFrame = cf * CFrame.new(off, 0.6, 0), Color = Color3.fromRGB(90, 90, 95), Material = Enum.Material.Metal })
			end
		else
			local color, mat = Color3.fromRGB(48, 48, 54), Enum.Material.Asphalt
			if cls == "pedestrian" then
				color, mat = SIDEWALK, Enum.Material.Concrete
			elseif cls == "service" then
				-- Дворовые проезды: светлее и уже основных улиц.
				color, w = Color3.fromRGB(105, 105, 110), w - 2
			end
			part({ Parent = folder, Name = cls, Size = Vector3.new(w, 0.6, len + 0.2), CFrame = cf + Vector3.new(0, ROAD_TOP - 0.3, 0), Color = color, Material = mat })
			if not NO_SIDEWALK[cls] then
				part({ Parent = folder, Name = "Sidewalk", Size = Vector3.new(w + 10, 0.6, len + 0.2), CFrame = cf + Vector3.new(0, WALK_TOP - 0.3, 0), Color = SIDEWALK, Material = Enum.Material.Concrete })
			end
			if cls == "primary" or cls == "secondary" or cls == "tertiary" then
				-- Осевая разметка: сплошная на главных, прерывистая на остальных.
				if cls == "tertiary" then
					local n = math.floor(len / 12)
					for i = 0, n - 1 do
						part({ Parent = folder, Name = "Dash", Size = Vector3.new(0.5, 0.05, 6), CFrame = cf * CFrame.new(0, ROAD_TOP + 0.02, -len / 2 + 6 + i * 12), Color = Color3.fromRGB(240, 240, 235), CanCollide = false })
					end
				else
					part({ Parent = folder, Name = "Line", Size = Vector3.new(0.6, 0.05, len), CFrame = cf + Vector3.new(0, ROAD_TOP + 0.02, 0), Color = Color3.fromRGB(240, 240, 235), CanCollide = false })
				end
			end
		end
		maybeYield()
	end
	for _, r in records("Discs") do
		local w = tonumber(r[3])
		local x, z = tonumber(r[1]), tonumber(r[2])
		local jointColor = w <= 12 and Color3.fromRGB(105, 105, 110) or Color3.fromRGB(48, 48, 54)
		local jw = w <= 12 and w - 2 or w
		part({ Parent = folder, Name = "Joint", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.6, jw, jw), CFrame = CFrame.new(x, ROAD_TOP - 0.31, z) * CFrame.Angles(0, 0, math.rad(90)), Color = jointColor, Material = Enum.Material.Asphalt })
		if w >= 18 and r[4] ~= "0" then
			part({ Parent = folder, Name = "SidewalkJoint", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.6, w + 10, w + 10), CFrame = CFrame.new(x, WALK_TOP - 0.31, z) * CFrame.Angles(0, 0, math.rad(90)), Color = SIDEWALK, Material = Enum.Material.Concrete })
		end
		maybeYield()
	end
end

local ROOF_COLORS = {
	Color3.fromRGB(140, 50, 40), Color3.fromRGB(95, 70, 55), Color3.fromRGB(60, 100, 70),
	Color3.fromRGB(70, 85, 110), Color3.fromRGB(120, 120, 125),
}
local WINDOW = Color3.fromRGB(60, 85, 110)

-- Двускатная крыша над прямоугольником sx × sz (конёк вдоль длинной стороны).
local function gableRoof(parent, cf, sx, sz, height, color)
	if sz > sx then
		cf = cf * CFrame.Angles(0, math.rad(90), 0)
		sx, sz = sz, sx
	end
	local half = sz / 2 + 0.8
	-- У клина высокая грань сзади (+Z), скат спускается вперёд (−Z).
	part({ Parent = parent, ClassName = "WedgePart", Name = "Roof", Size = Vector3.new(sx + 1.6, height, half), CFrame = cf * CFrame.new(0, height / 2, -half / 2), Color = color, Material = Enum.Material.Slate })
	part({ Parent = parent, ClassName = "WedgePart", Name = "Roof", Size = Vector3.new(sx + 1.6, height, half), CFrame = cf * CFrame.new(0, height / 2, half / 2) * CFrame.Angles(0, math.rad(180), 0), Color = color, Material = Enum.Material.Slate })
end

local function buildRealBuildings()
	local folder = Instance.new("Folder")
	folder.Name = "Pervouralsk"
	folder.Parent = City
	for _, r in records("Buildings") do
		local cx, cz, sx, sz = tonumber(r[1]), tonumber(r[2]), tonumber(r[3]), tonumber(r[4])
		local yaw, h, ci = tonumber(r[5]), tonumber(r[6]), tonumber(r[7])
		local color = BUILDING_COLORS[ci] or BUILDING_COLORS[1]
		local base = CFrame.new(cx, 0, cz) * CFrame.Angles(0, math.rad(yaw), 0)
		if ci == 10 then
			-- Промышленное здание: профлист, тёмная кровля, ленточное остекление.
			part({ Parent = folder, Name = "Building", Size = Vector3.new(sx, h, sz), CFrame = base * CFrame.new(0, h / 2, 0), Color = color, Material = Enum.Material.CorrodedMetal })
			part({ Parent = folder, Name = "Roof", Size = Vector3.new(sx + 0.4, 0.6, sz + 0.4), CFrame = base * CFrame.new(0, h + 0.3, 0), Color = Color3.fromRGB(85, 85, 90), Material = Enum.Material.Metal })
			part({ Parent = folder, Name = "Windows", Size = Vector3.new(sx + 0.2, 2, sz + 0.2), CFrame = base * CFrame.new(0, h - 3, 0), Color = WINDOW, Material = Enum.Material.Glass, CanCollide = false })
		elseif h <= 8 then
			-- Частный дом: стены, двускатная крыша, окна и дверь.
			local wallH = 7
			part({ Parent = folder, Name = "House", Size = Vector3.new(sx, wallH, sz), CFrame = base * CFrame.new(0, wallH / 2, 0), Color = color, Material = Enum.Material.WoodPlanks })
			gableRoof(folder, base * CFrame.new(0, wallH, 0), sx, sz, math.clamp(math.min(sx, sz) * 0.35, 3, 8), ROOF_COLORS[(math.floor(cx + cz) % #ROOF_COLORS) + 1])
			if sx >= 8 and sz >= 8 then
				local long, short = sx >= sz, nil
				short = long and sz or sx
				for _, side in { -1, 1 } do
					local off = (short / 2 + 0.1) * side
					local wcf = long and base * CFrame.new(sx * 0.22, 4, off) or base * CFrame.new(off, 4, sz * 0.22)
					part({ Parent = folder, Name = "Window", Size = long and Vector3.new(3, 2.6, 0.3) or Vector3.new(0.3, 2.6, 3), CFrame = wcf, Color = WINDOW, Material = Enum.Material.Glass, CanCollide = false })
				end
				local dcf = long and base * CFrame.new(-sx * 0.25, 2.6, sz / 2 + 0.1) or base * CFrame.new(sx / 2 + 0.1, 2.6, -sz * 0.25)
				part({ Parent = folder, Name = "Door", Size = long and Vector3.new(2.6, 5, 0.3) or Vector3.new(0.3, 5, 2.6), CFrame = dcf, Color = Color3.fromRGB(100, 65, 40), Material = Enum.Material.Wood, CanCollide = false })
			end
		else
			-- Многоэтажка: цоколь, этажи с лентами окон, парапет на крыше.
			part({ Parent = folder, Name = "Building", Size = Vector3.new(sx, h, sz), CFrame = base * CFrame.new(0, h / 2, 0), Color = color, Material = Enum.Material.Concrete })
			part({ Parent = folder, Name = "Plinth", Size = Vector3.new(sx + 0.4, 1.8, sz + 0.4), CFrame = base * CFrame.new(0, 0.9, 0), Color = color:Lerp(Color3.new(0, 0, 0), 0.35), Material = Enum.Material.Concrete })
			part({ Parent = folder, Name = "Parapet", Size = Vector3.new(sx + 0.6, 0.9, sz + 0.6), CFrame = base * CFrame.new(0, h + 0.2, 0), Color = color:Lerp(Color3.new(1, 1, 1), 0.3), Material = Enum.Material.Concrete })
			for y = 4.5, h - 3, 5 do
				local band = part({ Parent = folder, Name = "Windows", Size = Vector3.new(sx + 0.2, 1.8, sz + 0.2), CFrame = base * CFrame.new(0, y, 0), Color = WINDOW, Material = Enum.Material.Glass, CanCollide = false })
				if (math.floor(cx + cz + y) % 3) == 0 then
					band:AddTag("NightGlow") -- вечером в этих квартирах зажигается свет
				end
			end
			-- Детали фасада на длинных секциях: лоджии, подъезды с козырьками, вентиляция.
			local long, short = math.max(sx, sz), math.min(sx, sz)
			if long >= 28 and short >= 8 then
				local rot = sx >= sz and base or base * CFrame.Angles(0, math.rad(90), 0)
				local lighter = color:Lerp(Color3.new(1, 1, 1), 0.25)
				for _, f in { -0.3, 0, 0.3 } do
					part({ Parent = folder, Name = "Loggias", Size = Vector3.new(5, h - 6, 1.6), CFrame = rot * CFrame.new(long * f, 3 + (h - 6) / 2, short / 2 + 0.8), Color = lighter, Material = Enum.Material.Concrete })
				end
				local entrances = math.max(1, math.floor(long / 32))
				for i = 1, entrances do
					local ex = -long / 2 + long * (i - 0.5) / entrances
					part({ Parent = folder, Name = "Entrance", Size = Vector3.new(3, 4.4, 0.3), CFrame = rot * CFrame.new(ex, 2.2, -short / 2 - 0.15), Color = Color3.fromRGB(95, 60, 35), Material = Enum.Material.Wood, CanCollide = false })
					part({ Parent = folder, Name = "Canopy", Size = Vector3.new(5, 0.4, 2.6), CFrame = rot * CFrame.new(ex, 5, -short / 2 - 1.3), Color = Color3.fromRGB(120, 120, 125), Material = Enum.Material.Metal })
				end
				part({ Parent = folder, Name = "RoofVent", Size = Vector3.new(3, 2.2, 3), CFrame = rot * CFrame.new(long * 0.2, h + 1.6, 0), Color = Color3.fromRGB(150, 150, 150), Material = Enum.Material.Concrete })
				if (math.floor(cx) % 2) == 0 then
					part({ Parent = folder, Name = "Antenna", Size = Vector3.new(0.3, 6, 0.3), CFrame = rot * CFrame.new(-long * 0.25, h + 3.5, 0), Color = Color3.fromRGB(90, 90, 95), Material = Enum.Material.Metal })
				end
			end
		end
		maybeYield()
	end
end

local function buildStreetSigns()
	for _, r in records("Signs") do
		local x, z, yaw = tonumber(r[1]), tonumber(r[2]), tonumber(r[3])
		local name = r[4]
		part({ Name = "StreetSignPost", Size = Vector3.new(0.5, 9, 0.5), Position = Vector3.new(x, 4.5, z), Color = Color3.fromRGB(60, 60, 65), Material = Enum.Material.Metal })
		local board = part({ Name = "StreetSign", Size = Vector3.new(math.clamp(#name * 0.35, 8, 20), 2.2, 0.3), CFrame = CFrame.new(x, 9.5, z) * CFrame.Angles(0, math.rad(yaw), 0), Color = Color3.fromRGB(30, 70, 150), CanCollide = false })
		surfaceText(board, Enum.NormalId.Front, name, Color3.fromRGB(30, 70, 150))
		surfaceText(board, Enum.NormalId.Back, name, Color3.fromRGB(30, 70, 150))
	end
end

---------------------------------------------------------------------------
-- Жилой квартал
---------------------------------------------------------------------------
local HOUSE_COLORS = {
	Color3.fromRGB(230, 200, 160), Color3.fromRGB(180, 210, 230), Color3.fromRGB(230, 180, 180),
	Color3.fromRGB(200, 230, 190), Color3.fromRGB(240, 230, 170), Color3.fromRGB(210, 190, 230),
}

-- Коттедж игрока: участок 46×46 с газоном и забором, дом 30×22 с двускатной
-- крышей, крыльцом, окнами, трубой; внутри спальня, душ, кухня, гостиная.
local ROOF_PALETTE = { Color3.fromRGB(150, 55, 45), Color3.fromRGB(70, 90, 120), Color3.fromRGB(70, 110, 75), Color3.fromRGB(105, 75, 60) }

local function buildHouse(id, a)
	local m = Instance.new("Model")
	m.Name = "House" .. id
	m.Parent = City
	local base = CFrame.new(a.X, 0, a.Z) * CFrame.Angles(0, math.rad(a.Yaw), 0)
	local function at(lx, ly, lz)
		return base * CFrame.new(lx, ly, lz)
	end
	local wall = HOUSE_COLORS[(id - 1) % #HOUSE_COLORS + 1]
	local roofColor = ROOF_PALETTE[(id - 1) % #ROOF_PALETTE + 1]
	local trim = Color3.fromRGB(250, 250, 245)
	local wood = Color3.fromRGB(120, 80, 50)

	-- Участок: газон, забор с калиткой, дорожка до улицы.
	part({ Parent = m, Name = "Lawn", Size = Vector3.new(46, 0.3, 46), CFrame = at(0, 0.05, 0), Color = Color3.fromRGB(110, 175, 85), Material = Enum.Material.Grass })
	local fenceH = 3.5
	local function fence(lx, lz, sx, sz)
		part({ Parent = m, Name = "Fence", Size = Vector3.new(sx, fenceH, sz), CFrame = at(lx, fenceH / 2, lz), Color = trim, Material = Enum.Material.WoodPlanks })
	end
	fence(0, -23, 46, 0.5)
	fence(-23, 0, 0.5, 46)
	fence(23, 0, 0.5, 46)
	fence(-13.5, 23, 19, 0.5)
	fence(13.5, 23, 19, 0.5)
	for _, lx in { -4, 4 } do
		part({ Parent = m, Name = "GatePost", Size = Vector3.new(1, 5, 1), CFrame = at(lx, 2.5, 23), Color = trim, Material = Enum.Material.Wood })
	end
	part({ Parent = m, Name = "Path", Size = Vector3.new(4, 0.35, 28), CFrame = at(0, 0.18, 19), Color = Color3.fromRGB(190, 180, 165), Material = Enum.Material.Cobblestone })

	-- Дом: пол, стены с проёмами под дверь и окна.
	local W, D, H = 30, 22, 11
	local zc = -6 -- центр дома по глубине (участок спереди свободен под двор)
	local zf, zb = zc + D / 2, zc - D / 2
	part({ Parent = m, Name = "Foundation", Size = Vector3.new(W + 1, 1, D + 1), CFrame = at(0, 0.5, zc), Color = Color3.fromRGB(140, 135, 130), Material = Enum.Material.Concrete })
	part({ Parent = m, Name = "Floor", Size = Vector3.new(W - 1, 0.2, D - 1), CFrame = at(0, 1.05, zc), Color = Color3.fromRGB(175, 135, 95), Material = Enum.Material.WoodPlanks })
	local function wallPart(lx, ly, lz, sx, sy, sz)
		part({ Parent = m, Name = "Wall", Size = Vector3.new(sx, sy, sz), CFrame = at(lx, ly, lz), Color = wall, Material = Enum.Material.Plaster })
	end
	local top = 1 + H
	wallPart(0, 1 + H / 2, zb + 0.5, W, H, 1) -- задняя
	wallPart(-W / 2 + 0.5, 1 + H / 2, zc, 1, H, D) -- левая
	wallPart(W / 2 - 0.5, 1 + H / 2, zc, 1, H, D) -- правая
	-- Фасад с дверью (ширина 5, высота 8).
	wallPart(-(2.5 + (W / 2 - 2.5) / 2), 1 + H / 2, zf - 0.5, W / 2 - 2.5, H, 1)
	wallPart(2.5 + (W / 2 - 2.5) / 2, 1 + H / 2, zf - 0.5, W / 2 - 2.5, H, 1)
	wallPart(0, 1 + 8 + (H - 8) / 2, zf - 0.5, 5, H - 8, 1)
	part({ Parent = m, Name = "Ceiling", Size = Vector3.new(W, 0.4, D), CFrame = at(0, top + 0.2, zc), Color = trim, Material = Enum.Material.SmoothPlastic })

	-- Окна с белыми рамами (стекло чуть выступает из стены).
	local function window(lx, lz, alongX)
		local size = alongX and Vector3.new(5, 4, 0.3) or Vector3.new(0.3, 4, 5)
		local frame = alongX and Vector3.new(5.8, 4.8, 0.2) or Vector3.new(0.2, 4.8, 5.8)
		local out = alongX and Vector3.new(0, 0, lz > zc and 0.15 or -0.15) or Vector3.new(lx > 0 and 0.15 or -0.15, 0, 0)
		part({ Parent = m, Name = "WindowFrame", Size = frame, CFrame = at(lx, 6, lz) + base:VectorToWorldSpace(out), Color = trim, CanCollide = false })
		part({ Parent = m, Name = "Window", Size = size, CFrame = at(lx, 6, lz) + base:VectorToWorldSpace(out * 2), Color = Color3.fromRGB(150, 200, 235), Material = Enum.Material.Glass, Transparency = 0.35, CanCollide = false })
	end
	window(-9, zf, true)
	window(-8, zb, true)
	window(8, zb, true)
	window(-W / 2, zc, false)
	window(W / 2, zc, false)

	-- Двускатная крыша и труба.
	gableRoof(m, at(0, top + 0.4, zc), W + 2, D + 2, 7, roofColor)
	part({ Parent = m, Name = "Chimney", Size = Vector3.new(2.2, 6, 2.2), CFrame = at(8, top + 5, zc - 5), Color = Color3.fromRGB(150, 80, 60), Material = Enum.Material.Brick })

	-- Крыльцо с навесом.
	part({ Parent = m, Name = "Porch", Size = Vector3.new(12, 1, 5), CFrame = at(0, 0.5, zf + 2.5), Color = wood, Material = Enum.Material.WoodPlanks })
	part({ Parent = m, Name = "Step", Size = Vector3.new(6, 0.5, 2), CFrame = at(0, 0.25, zf + 6), Color = wood, Material = Enum.Material.WoodPlanks })
	for _, lx in { -5.5, 5.5 } do
		part({ Parent = m, Name = "PorchPost", Size = Vector3.new(0.8, 8.5, 0.8), CFrame = at(lx, 5.25, zf + 4.5), Color = trim, Material = Enum.Material.Wood })
	end
	part({ Parent = m, ClassName = "WedgePart", Name = "PorchRoof", Size = Vector3.new(13, 1.6, 5.5), CFrame = at(0, 10.3, zf + 2.6) * CFrame.Angles(0, math.rad(180), 0), Color = roofColor, Material = Enum.Material.Slate })
	local lamp = part({ Parent = m, Name = "PorchLamp", Size = Vector3.new(0.8, 0.8, 0.8), CFrame = at(3.5, 8, zf + 0.3), Color = Color3.fromRGB(255, 235, 180), Material = Enum.Material.Neon, CanCollide = false })
	local l = Instance.new("PointLight")
	l.Range = 18
	l.Color = Color3.fromRGB(255, 220, 160)
	l.Parent = lamp

	-- Двор: клумбы, дерево, скамейка.
	for _, lx in { -14, 14 } do
		part({ Parent = m, Name = "Flowerbed", Size = Vector3.new(8, 0.8, 3), CFrame = at(lx, 0.5, 14), Color = Color3.fromRGB(95, 65, 45), Material = Enum.Material.Ground })
		for i = -1, 1 do
			local colors = { Color3.fromRGB(240, 80, 120), Color3.fromRGB(255, 220, 60), Color3.fromRGB(180, 90, 230) }
			part({ Parent = m, Shape = Enum.PartType.Ball, Name = "Flower", Size = Vector3.new(1.4, 1.4, 1.4), CFrame = at(lx + i * 2.5, 1.4, 14), Color = colors[i + 2], Material = Enum.Material.SmoothPlastic, CanCollide = false })
		end
	end
	tree(at(-17, 0, -19).Position)
	bench(at(15, 0, 18) * CFrame.Angles(0, math.rad(180), 0), 1)

	-- Интерьер.
	local door = part({ Parent = m, Name = "Door", Size = Vector3.new(5, 8, 0.5), CFrame = at(0, 5, zf - 0.5), Color = Color3.fromRGB(110, 70, 40), Material = Enum.Material.Wood })
	part({ Parent = m, Name = "Rug", Size = Vector3.new(10, 0.1, 7), CFrame = at(4, 1.2, zc + 1), Color = Color3.fromRGB(170, 60, 70), Material = Enum.Material.Fabric, CanCollide = false })
	local bed = interactable(m, "Bed", at(-9, 2.2, zb + 5.5), Vector3.new(6, 2, 9), Color3.fromRGB(240, 240, 255), "Кровать", Enum.Material.Fabric)
	part({ Parent = m, Name = "Pillow", Size = Vector3.new(5, 0.8, 2), CFrame = at(-9, 3.5, zb + 2), Color = Color3.new(1, 1, 1), Material = Enum.Material.Fabric })
	part({ Parent = m, Name = "Blanket", Size = Vector3.new(6.2, 0.3, 5), CFrame = at(-9, 3.3, zb + 7.5), Color = Color3.fromRGB(80, 120, 190), Material = Enum.Material.Fabric })
	local shower = interactable(m, "Shower", at(11.5, 5, zb + 3.5), Vector3.new(5, 8, 5), Color3.fromRGB(160, 210, 240), "Душ", Enum.Material.Glass)
	shower.Transparency = 0.4
	shower.CanCollide = false
	local tv = interactable(m, "TV", at(9, 5, zf - 1.3), Vector3.new(7, 4, 0.5), Color3.fromRGB(20, 20, 20), "Телевизор")
	part({ Parent = m, Name = "Sofa", Size = Vector3.new(8, 2, 3), CFrame = at(9, 2.1, zc + 0.5), Color = Color3.fromRGB(90, 60, 120), Material = Enum.Material.Fabric })
	part({ Parent = m, Name = "SofaBack", Size = Vector3.new(8, 2.5, 0.8), CFrame = at(9, 3.4, zc - 1.1), Color = Color3.fromRGB(90, 60, 120), Material = Enum.Material.Fabric })
	local fridge = interactable(m, "Fridge", at(-12.5, 5, zf - 3), Vector3.new(3.5, 8, 3.5), Color3.fromRGB(235, 235, 240), "Холодильник", Enum.Material.Metal)
	part({ Parent = m, Name = "Kitchen", Size = Vector3.new(3.5, 3.5, 7), CFrame = at(-12.5, 2.8, zf - 9), Color = Color3.fromRGB(210, 200, 185), Material = Enum.Material.Wood })
	part({ Parent = m, Shape = Enum.PartType.Cylinder, Name = "Table", Size = Vector3.new(3.4, 5, 5), CFrame = at(-4, 2.75, zf - 5) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(190, 150, 110), Material = Enum.Material.Wood })
	local light = part({ Parent = m, Name = "Lamp", Size = Vector3.new(3, 0.4, 3), CFrame = at(0, top - 0.3, zc), Color = Color3.fromRGB(255, 250, 220), Material = Enum.Material.Neon, CanCollide = false })
	local pl = Instance.new("PointLight")
	pl.Range = 24
	pl.Brightness = 1.2
	pl.Parent = light

	-- Табличка с владельцем у калитки.
	part({ Parent = m, Name = "SignPost", Size = Vector3.new(0.5, 4, 0.5), CFrame = at(7, 2, 25), Color = wood })
	local board = part({ Parent = m, Name = "SignBoard", Size = Vector3.new(8, 3, 0.4), CFrame = at(7, 5, 25), Color = Color3.fromRGB(250, 250, 240), CanCollide = false })
	local label = surfaceText(board, Enum.NormalId.Back, "", Color3.fromRGB(250, 250, 240), Color3.fromRGB(30, 30, 30))
	local delivery = part({ Parent = m, Name = "Doorstep", Size = Vector3.new(4, 0.3, 3), CFrame = at(0, 0.5, 27), Color = Color3.fromRGB(150, 120, 90) })

	local house = {
		Id = id,
		Model = m,
		Door = door,
		Bed = bed,
		Shower = shower,
		TV = tv,
		Fridge = fridge,
		SignLabel = label,
		SignBoard = board,
		Doorstep = delivery,
		Spawn = at(0, 4, zc + 2),
		Center = at(0, 0, 0).Position,
	}
	table.insert(World.Houses, house)
	return house
end

local function buildResidential()
	for id, a in Meta.Houses do
		buildHouse(id, a)
	end
end

---------------------------------------------------------------------------
-- Общественные здания
---------------------------------------------------------------------------
local function buildCityHall(a)
	local m, at = building({ Name = "CityHall", GPSName = "Администрация города", X = a.X, Z = a.Z, Yaw = a.Yaw, W = 90, D = 70, H = 24, Color = Color3.fromRGB(235, 225, 200), Material = Enum.Material.Marble, Sign = "АДМИНИСТРАЦИЯ г. ПЕРВОУРАЛЬСК", SignColor = Color3.fromRGB(120, 90, 40), Path = 40, DoorW = 14 })
	for _, lx in { -20, -10, 10, 20 } do
		part({ Parent = m, Name = "Column", Shape = Enum.PartType.Cylinder, Size = Vector3.new(22, 3, 3), CFrame = (at(lx, 11, 38)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.new(1, 1, 1), Material = Enum.Material.Marble })
	end
	part({ Parent = m, Name = "Portico", Size = Vector3.new(50, 1.5, 10), Position = at(0, 22.7, 38), Color = Color3.fromRGB(235, 225, 200), Material = Enum.Material.Marble })

	local jobs = interactable(m, "JobBoard", at(-20, 5, -25), Vector3.new(12, 8, 1), Color3.fromRGB(40, 90, 50), "Биржа труда")
	surfaceText(jobs, Enum.NormalId.Front, "БИРЖА ТРУДА", Color3.fromRGB(40, 90, 50))
	surfaceText(jobs, Enum.NormalId.Back, "БИРЖА ТРУДА", Color3.fromRGB(40, 90, 50))
	World.Desks.Jobs = jobs
	local roles = counter(m, at(20, 1.9, -20), Vector3.new(14, 3.5, 3))
	floatLabel(roles, "Смена профессии / роли", 4)
	World.Desks.Roles = roles
	staff(at, 20, -23, "clerk", "Инспектор отдела кадров", { "Хотите сменить профессию? Подойдите к стойке.", "Полиция и спецслужбы всегда ждут ответственных людей." })
	local realty = counter(m, at(0, 1.9, -25), Vector3.new(12, 3.5, 3), Color3.fromRGB(70, 110, 160))
	floatLabel(realty, "Агентство недвижимости", 4)
	World.Desks.Realty = realty
	staff(at, 0, -28, "clerk", "Риелтор", { "Коттеджи в центре — лучший выбор! Всего несколько тысяч.", "После свадьбы супруги живут в одном доме." })
	staff(at, -20, -22, "clerk", "Специалист биржи труда", { "Работы много: кассир, повар, офис, грузчик, курьер.", "Помните: после смены нужно отдохнуть." })

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "CitySpawn"
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Size = Vector3.new(12, 1, 12)
	spawn.CFrame = at(0, 0.5, 58)
	spawn.Color = Color3.fromRGB(200, 200, 200)
	spawn.Material = Enum.Material.Marble
	spawn.Duration = 3
	spawn.Parent = City
	World.Spawns.CityHall = (at(0, 4, 58))

	-- Фонтан перед мэрией.
	part({ Name = "FountainBase", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.5, 18, 18), CFrame = (at(-30, 0.75, 60)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(200, 200, 200), Material = Enum.Material.Marble })
	part({ Name = "FountainWater", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.3, 16, 16), CFrame = (at(-30, 1.5, 60)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(80, 160, 230), Material = Enum.Material.Glass, Transparency = 0.3, CanCollide = false })
end

local function buildPolice(a)
	local m, at = building({ Name = "Police", GPSName = "ОМВД (полиция)", X = a.X, Z = a.Z, Yaw = a.Yaw, W = 90, D = 70, H = 20, Color = Color3.fromRGB(60, 80, 140), Sign = "ОМВД ПОЛИЦИЯ", SignColor = Color3.fromRGB(30, 50, 140), Path = 40 })
	counter(m, at(0, 1.9, 10), Vector3.new(20, 3.5, 3), Color3.fromRGB(60, 60, 70))
	for i = 1, 3 do
		part({ Parent = m, Name = "Locker", Size = Vector3.new(4, 8, 2), Position = at(-40 + i * 5, 4, -32), Color = Color3.fromRGB(100, 110, 120), Material = Enum.Material.Metal })
	end
	World.Spawns.PoliceStation = (at(0, 4, -10))
	staff(at, 0, 7.5, "police", "Дежурный ОМВД", { "Добро пожаловать в ОМВД Первоуральска.", "Видели что-то подозрительное? Сообщите патрулю." })
	local pad = part({ Parent = m, Name = "CarPad", Size = Vector3.new(16, 0.3, 24), Position = at(-35, 0.2, 55), Color = Color3.fromRGB(40, 40, 120) })
	local kiosk = interactable(m, "CarKiosk", at(-24, 2.5, 55), Vector3.new(2, 5, 2), Color3.fromRGB(40, 40, 120), "Служебный транспорт")
	World.PoliceCarKiosk = kiosk
	World.PoliceCarSpawn = pad.CFrame + Vector3.new(0, 3, 0)
end

local function buildHospital(a)
	local m, at = building({ Name = "Hospital", GPSName = "Городская больница №1", X = a.X, Z = a.Z, Yaw = a.Yaw, W = 100, D = 80, H = 20, Color = Color3.fromRGB(245, 245, 250), Sign = "ГОРОДСКАЯ БОЛЬНИЦА №1", SignColor = Color3.fromRGB(200, 40, 50), Path = 40, DoorW = 14 })
	counter(m, at(0, 1.9, 20), Vector3.new(18, 3.5, 3), Color3.fromRGB(230, 230, 240))
	World.Spawns.Hospital = (at(0, 4, 28))
	staff(at, 0, 17.5, "doctor", "Медсестра", { "Плохо себя чувствуете? Койки у дальней стены.", "Не забывайте есть и высыпаться!" })
	World.JobPoints.Hospital = {}
	for i, lx in { -36, -20, 20, 36 } do
		local bed = interactable(m, "HospitalBed", at(lx, 1.4, -25), Vector3.new(6, 2, 10), Color3.fromRGB(220, 240, 255), "Больничная койка", Enum.Material.Fabric)
		table.insert(World.Beds, { Part = bed, Rate = 5, Heal = true, Name = "Больничная койка" })
		local station = part({ Parent = m, Name = "PatientSpot" .. i, Size = Vector3.new(3, 0.2, 3), Position = at(lx, 0.5, -16), Color = Color3.fromRGB(200, 60, 70), CanCollide = false })
		table.insert(World.JobPoints.Hospital, station)
	end
end

local function buildBank(a)
	local m, at = building({ Name = "Bank", GPSName = "Банк", X = a.X, Z = a.Z, Yaw = a.Yaw, W = 80, D = 70, H = 22, Color = Color3.fromRGB(170, 170, 160), Material = Enum.Material.Granite, Sign = "БАНК", SignColor = Color3.fromRGB(30, 100, 60), Path = 40 })
	for _, lx in { -25, -15, 15, 25 } do
		part({ Parent = m, Name = "Column", Shape = Enum.PartType.Cylinder, Size = Vector3.new(20, 2.5, 2.5), CFrame = (at(lx, 10, 38)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(230, 230, 220), Material = Enum.Material.Marble })
	end
	counter(m, at(0, 1.9, 5), Vector3.new(30, 3.5, 3), Color3.fromRGB(90, 70, 50))
	local teller = interactable(m, "Teller", at(0, 4.5, 5), Vector3.new(2, 1, 1), Color3.fromRGB(240, 220, 120), "Кассир банка")
	teller.CanCollide = false
	table.insert(World.ATMs, teller)
	staff(at, 0, 2.5, "clerk", "Операционист банка", { "Храните деньги на карте — так надёжнее.", "Банкоматы есть у входа." })
	worker(at(-8, 0.4, 30) * CFrame.Angles(0, math.rad(180), 0), "guard", "Охранник", { "Проходите, не задерживайтесь.", "Хранилище под надёжной охраной!" })
	for _, lx in { -30, 30 } do
		local atm = interactable(m, "ATM", at(lx, 3, 42), Vector3.new(3, 6, 2), Color3.fromRGB(40, 120, 70), "Банкомат", Enum.Material.Metal)
		table.insert(World.ATMs, atm)
	end
	-- Хранилище.
	part({ Parent = m, Name = "VaultWall", Size = Vector3.new(30, 18, 1), Position = at(0, 9, -15), Color = Color3.fromRGB(90, 90, 95), Material = Enum.Material.DiamondPlate })
	local vaultDoor = part({ Parent = m, Name = "VaultDoor", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.5, 10, 10), CFrame = (at(0, 6, -14.3)) * CFrame.Angles(0, math.rad(90), 0), Color = Color3.fromRGB(150, 150, 160), Material = Enum.Material.Metal, CanCollide = false })
	local vault = interactable(m, "Vault", at(0, 2, -12), Vector3.new(4, 0.4, 2), Color3.fromRGB(150, 150, 160))
	vault.CanCollide = false
	World.Robbery.Bank = vault
	floatLabel(vaultDoor, "Хранилище", 6, Color3.fromRGB(255, 120, 120))
end

local function buildOffice(a)
	local m, at = building({ Name = "Office", GPSName = "Бизнес-центр", X = a.X, Z = a.Z, Yaw = a.Yaw, W = 80, D = 64, H = 44, Color = Color3.fromRGB(120, 150, 180), Material = Enum.Material.Glass, Sign = "БИЗНЕС-ЦЕНТР", SignColor = Color3.fromRGB(30, 60, 100), Path = 40 })
	World.JobPoints.Office = {}
	for row = 0, 1 do
		for col = -1, 1 do
			local desk = part({ Parent = m, Name = "Desk", Size = Vector3.new(8, 3, 4), Position = at(col * 20, 1.9, -15 + row * 14), Color = Color3.fromRGB(200, 190, 170), Material = Enum.Material.Wood })
			local pc = interactable(m, "Computer", desk.CFrame * CFrame.new(0, 2.5, 0), Vector3.new(3, 2, 0.4), Color3.fromRGB(20, 20, 30))
			pc.CanCollide = false
			table.insert(World.JobPoints.Office, pc)
		end
	end
	local cooler = interactable(m, "Cooler", at(34, 2.5, -26), Vector3.new(2, 5, 2), Color3.fromRGB(120, 200, 255), "Кулер")
	table.insert(World.FunSpots, { Part = cooler, Need = "Hunger", Amount = 4, Text = "Попить воды", Hold = 1, Cooldown = 20 })
end

local function buildSupermarket(a)
	local m, at = building({ Name = "Supermarket", GPSName = "Супермаркет", X = a.X, Z = a.Z, Yaw = a.Yaw, W = 100, D = 76, H = 18, Color = Color3.fromRGB(240, 160, 60), Sign = "СУПЕРМАРКЕТ", SignColor = Color3.fromRGB(200, 90, 20), Path = 40, DoorW = 16 })
	for row = -1, 1 do
		for _, lx in { -30, 0, 30 } do
			part({ Parent = m, Name = "Shelf", Size = Vector3.new(18, 7, 3), Position = at(lx, 3.7, -15 + row * 10), Color = Color3.fromRGB(220, 220, 225), Material = Enum.Material.Metal })
		end
	end
	World.JobPoints.Supermarket = {}
	for i, lx in { -30, -15, 15 } do
		counter(m, at(lx, 1.9, 22), Vector3.new(8, 3.5, 3), Color3.fromRGB(60, 60, 70))
		local reg = interactable(m, "Register" .. i, at(lx, 4.2, 22), Vector3.new(2, 1, 1.5), Color3.fromRGB(30, 30, 30))
		reg.CanCollide = false
		table.insert(World.JobPoints.Supermarket, reg)
	end
	local shop = interactable(m, "ShopCounter", at(32, 2, 26), Vector3.new(10, 4, 4), Color3.fromRGB(240, 160, 60), "Продукты")
	World.Shops.Supermarket = shop
	staff(at, 32, 22.5, "cashier", "Продавец", { "Свежий хлеб и салаты — у нас!", "Кофе бодрит лучше всего." })
	local safe = interactable(m, "Safe", at(40, 2, -32), Vector3.new(4, 4, 4), Color3.fromRGB(60, 60, 60), nil, Enum.Material.DiamondPlate)
	World.Robbery.Supermarket = safe
	local atm = interactable(m, "ATM", at(-44, 3, 42), Vector3.new(3, 6, 2), Color3.fromRGB(40, 120, 70), "Банкомат", Enum.Material.Metal)
	table.insert(World.ATMs, atm)

end

-- Цветочный магазин — на месте реального магазина цветов.
local function buildFlorist(a)
	local base = CFrame.new(a.X, 0, a.Z) * CFrame.Angles(0, math.rad(a.Yaw), 0)
	local kiosk = part({ Name = "FloristKiosk", Size = Vector3.new(14, 9, 10), CFrame = base * CFrame.new(0, 4.5, 0), Color = Color3.fromRGB(250, 170, 200), Material = Enum.Material.Wood })
	surfaceText(kiosk, Enum.NormalId.Back, "ЦВЕТЫ", Color3.fromRGB(220, 80, 140))
	surfaceText(kiosk, Enum.NormalId.Front, "ЦВЕТЫ", Color3.fromRGB(220, 80, 140))
	local fshop = interactable(nil, "FloristCounter", base * CFrame.new(0, 2, 6.5), Vector3.new(8, 4, 2), Color3.fromRGB(250, 220, 230), "Цветы, подарки, кольца")
	World.Shops.Florist = fshop
	worker(base * CFrame.new(5, 0.4, 8) * CFrame.Angles(0, math.rad(180), 0), "clerk", "Флорист", { "Цветы — лучший подарок!", "Обручальные кольца тоже у нас." })
	addGPS("Цветочный магазин", base * CFrame.new(0, 3, 12))
end

local function buildCafe(a)
	local m, at = building({ Name = "Cafe", GPSName = "Пельменная", X = a.X, Z = a.Z, Yaw = a.Yaw, W = 70, D = 60, H = 16, Color = Color3.fromRGB(170, 110, 80), Material = Enum.Material.Brick, Sign = "ПЕЛЬМЕННАЯ", SignColor = Color3.fromRGB(120, 60, 30), Path = 40 })
	counter(m, at(0, 1.9, 2), Vector3.new(30, 3.5, 3))
	local shop = interactable(m, "CafeCounter", at(-10, 4.5, 4), Vector3.new(3, 1, 1), Color3.fromRGB(255, 220, 150), "Меню")
	shop.CanCollide = false
	World.Shops.Cafe = shop
	staff(at, -10, -1, "cook", "Официант", { "Пельмени сегодня особенно удались!", "Присаживайтесь за любой столик." })
	local reg = interactable(m, "CafeRegister", at(10, 4.2, 2), Vector3.new(2, 1, 1.5), Color3.fromRGB(30, 30, 30))
	reg.CanCollide = false
	World.Robbery.Cafe = reg
	World.JobPoints.Cafe = { Pickup = {}, Drop = {} }
	for _, lx in { -20, 0, 20 } do
		local stove = interactable(m, "Stove", at(lx, 2, -24), Vector3.new(6, 4, 4), Color3.fromRGB(80, 80, 85), nil, Enum.Material.Metal)
		table.insert(World.JobPoints.Cafe.Pickup, stove)
	end
	for _, pos in { { -22, 16 }, { 22, 16 }, { -22, 24 }, { 22, 24 } } do
		local tbl = part({ Parent = m, Name = "Table", Shape = Enum.PartType.Cylinder, Size = Vector3.new(3.4, 6, 6), CFrame = (at(pos[1], 1.7, pos[2])) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(230, 220, 200), Material = Enum.Material.Wood })
		table.insert(World.JobPoints.Cafe.Drop, tbl)
		part({ Parent = m, Name = "Stool", Size = Vector3.new(2.5, 2, 2.5), Position = at(pos[1] + 5, 1.2, pos[2]), Color = Color3.fromRGB(120, 80, 50), Material = Enum.Material.Wood })
	end
	local juke = interactable(m, "Jukebox", at(-32, 3, -10), Vector3.new(3, 6, 3), Color3.fromRGB(200, 60, 160), "Музыкальный автомат", Enum.Material.Neon)
	table.insert(World.FunSpots, { Part = juke, Need = "Fun", Amount = 15, Text = "Включить музыку", Hold = 1, Cooldown = 15 })
end

local function buildDealership(a)
	local m, at = building({ Name = "Dealership", GPSName = "Автосалон", X = a.X, Z = a.Z, Yaw = a.Yaw, W = 90, D = 60, H = 16, Color = Color3.fromRGB(200, 210, 220), Material = Enum.Material.Glass, Sign = "АВТОСАЛОН", SignColor = Color3.fromRGB(180, 30, 30), Path = 40, DoorW = 20 })
	local desk = interactable(m, "SalesDesk", at(0, 2, -20), Vector3.new(12, 4, 3), Color3.fromRGB(180, 30, 30), "Купить машину")
	World.Dealership = desk
	staff(at, 0, -23, "clerk", "Менеджер автосалона", { "Спорткар — мечта каждого!", "Купленную машину можно вызвать через телефон." })
	-- Витринные машины (декорация).
	for i, lx in { -28, 28 } do
		local c = i == 1 and Color3.fromRGB(220, 30, 30) or Color3.fromRGB(60, 90, 60)
		part({ Parent = m, Name = "ShowCar", Size = Vector3.new(7, 2.5, 13), Position = at(lx, 2, 0), Color = c, Material = Enum.Material.SmoothPlastic })
		part({ Parent = m, Name = "ShowCarTop", Size = Vector3.new(6, 2, 6), Position = at(lx, 4.2, -1), Color = Color3.fromRGB(120, 170, 220), Material = Enum.Material.Glass, Transparency = 0.3 })
	end
end

local function buildFactory(a)
	local m, at = building({ Name = "Factory", GPSName = "Трубный завод и склад", X = a.X, Z = a.Z, Yaw = a.Yaw, W = 110, D = 90, H = 26, Color = Color3.fromRGB(150, 120, 90), Material = Enum.Material.CorrodedMetal, Sign = "ТРУБНЫЙ ЗАВОД", SignColor = Color3.fromRGB(90, 70, 40), Path = 40, DoorW = 20 })
	World.JobPoints.Factory = { Pickup = {}, Drop = {} }
